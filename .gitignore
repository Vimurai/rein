src/templates/.mcp.json
.env
.env.local
*.key
*.pem

# Node modules — root and nested workspaces
/node_modules
**/node_modules

# E-156 (test-harness-isolation): ephemeral test MCP config. tests/run.sh writes
# it inside a private temp dir and a trap removes it on exit; this is a safety net
# in case a suite ever drops one at the repo root.
.mcp.test.json

# SQLite WAL/SHM sidecar files (must not be committed; can be half-flushed)
.ai/state.sqlite-shm
.ai/state.sqlite-wal
*.sqlite-shm
*.sqlite-wal

# E-31: Auto-generated skill index — regenerated by `ai sync` on every run.
# Tracking causes spurious diffs from sort-order/description changes.
**/_SKILLS_INDEX.md

# E-110: Auto-generated blueprint index — regenerated by `ai sync` from the
# .ai/blueprints/*.md set (which churns as the Architect adds blueprints), so
# tracking it would break on clean checkouts. Same rationale as _SKILLS_INDEX.md.
.ai/blueprints/_INDEX.md

# E-220: per-workspace sync manifest — regenerated by `ai sync` on every run, holding
# sha256 hashes of what THIS machine's sync wrote. Tracking it would produce a diff on
# every sync and, worse, would ship one machine's hashes to another where they are wrong,
# turning the prune's evidence into a lie. Same rationale as _SKILLS_INDEX.md; deleting it
# is safe (the next run has no evidence and therefore prunes nothing).
**/_SYNC_MANIFEST.json

# E-118: Interactive Bridge runtime signal queue — written by handoff_control
# and consumed by `ai watch` at runtime. Pure ephemeral state (like a .pid), so
# it must never be tracked. Rollback per interactive-bridge.md: safe to delete.
.ai/signal.json

# Interactive Bridge runtime lock (ephemeral, like signal.json) — never track.
.ai/.ai-watch.lock/

# E-145 (self-learning-arc): Memory Palace runtime artifacts — the candidate index
# (palace-index.json, refreshed each `ai sync`), the embeddings, and the multimodal-RAG
# dead-letter queue. All regenerated; never tracked.
.ai/memory/

# E-245 (D-066 §5): macOS Finder metadata. One had reached the repo root; nothing here
# should ever be committed, at any depth.
.DS_Store
**/.DS_Store

# Rein generated artefacts — regenerated by `ai sync` (E-233 / D-060 §4).
# Machine-local by construction; committing them produces a diff on every sync.
.claude/settings.json
# E-333 (D-102 §8): one developer's Claude account for this checkout (ai account use).
.ai/start.local.json
# E-342 (D-106 r2): this machine's last imported state.json blob id (ai state import).
.ai/.last-import-blob
# E-343 (D-108 r9): this machine's CI env allow-list (may hold values).
.ai/ci.local.json

# E-285: claude plugin eval writes its per-run results here by default
evals/results/
# E-364 (D-117): .mcp.json carries install-time ABSOLUTE server paths (this machine's home), so
# it is generated by `ai sync`, never committed; the public export ships a template (E-360).
.mcp.json
# E-364: the client project names the publish scan refuses (src/shared/publish-scan.mjs) — the
# names themselves must never be committed.
.ai/publish-scan.local.json
