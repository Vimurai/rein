{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vimurai/rein/blob/main/docs/contract/accounts.schema.json",
  "title": "Rein account registry (~/.rein/accounts.json)",
  "description": "A closed shape with one writer, src/shared/accounts.py (D-153 r4 and addendum 2; docs/accounts.md). A reader relies on config_dir only and ignores a row key it does not know; nothing but rein account add/remove writes the file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,23}$" },
      "additionalProperties": { "$ref": "#/$defs/account" }
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "required": ["config_dir"],
      "additionalProperties": false,
      "properties": {
        "config_dir": { "type": "string", "pattern": "^/" },
        "added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
