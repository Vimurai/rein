{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vimurai/rein/blob/main/docs/contract/doctor.schema.json",
  "title": "rein doctor --json, schema 1",
  "description": "The one document `rein doctor --json` prints on stdout, exit 0 or 1 (D-153 r3, D-155 r5; docs/app-contract.md). Any other exit means stdout is not a document. Any change to this shape raises schema.",
  "type": "object",
  "required": ["schema", "version", "status", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "$ref": "#/$defs/status" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "status": { "enum": ["ok", "warn", "fail"] },
    "check": {
      "type": "object",
      "required": ["id", "subject", "status", "line", "fix"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "subject": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/status" },
        "line": { "type": "string", "minLength": 1 },
        "fix": { "type": ["string", "null"] }
      }
    }
  }
}
