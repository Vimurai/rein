#!/usr/bin/env bash
set -euo pipefail

REIN="${HOME}/.rein"

# ── E-270 (D-074 §Components 1): one version, typed once ─────────────────────
# package.json is the only place the version is written by hand. install-rein.sh copies
# it to ~/.rein/VERSION; this reads that file, and in the dev tree (no install, e.g. the
# test suites running src/bin/ai) falls back to the clone's own package.json — only when
# that file really is the framework's, so a stray ~/package.json next to the mirror can
# never supply a version.
_pkg_version() {  # <package.json> → version, or nothing
  [[ -f "$1" ]] && grep -q '"name"[[:space:]]*:[[:space:]]*"@vimurai/rein"' "$1" 2>/dev/null || return 1
  sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$1" | head -1
}
_resolve_version() {
  local v=""
  [[ -f "${REIN}/VERSION" ]] && v="$(head -1 "${REIN}/VERSION" 2>/dev/null | tr -d '[:space:]')"
  if [[ -z "$v" ]]; then
    local _sd; _sd="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    v="$(_pkg_version "${_sd%/*/*}/package.json" 2>/dev/null || true)"
  fi
  printf '%s' "${v:-unknown}"
}
VERSION="$(_resolve_version)"
UPGRADE_MERGED=()   # E-270: filled by ensure_ai_templates, counted by do_init

# ── E-223 (D-057 §3): the environment here is UNTRUSTED ──────────────────────
# `ai` is routinely invoked through Bash from inside the project being worked on, and
# that Bash inherits the session env the CLI applied — which a project's own
# `.claude/settings.json` `env` block supplies, a file `ai init` itself writes. So the env
# reaching `ai` sits at exactly the same trust level as the one reaching the hooks, and
# hardening only the hooks left REIN_HOME and REIN_LOCATE_DEV honoured here: proven, a
# decoy repo redirected `_locate_resolve_launch`, whose stdout decides which BINARY
# `ai pane` execs.
#
# DEVIATION FROM D-057 §3, flagged for the Architect: the ruling names REIN_LOCATE_DEV=1
# as the dev-tree rollback. An env var cannot be the rollback channel here, because the
# env is the attack channel. The same capability is `--dev-tree`, which a settings.json
# cannot supply — and it is turned on by CALLING rein_locate_enable_dev_tree below, not by
# setting a variable, so the guarantee does not depend on every caller remembering to reset
# one (my first attempt did exactly that, and the hooks that forgot re-opened the hole).
#
# The flag is recognised only as the FIRST argument and never past a `--` terminator, so a
# literal "--dev-tree" arriving as user DATA (a task title, a handoff message,
# `ai add-task -- --dev-tree`) cannot steer resolution policy or be eaten from the
# arguments the user meant to pass.
_REIN_WANT_DEV_TREE=0
if [[ "${1:-}" == "--dev-tree" ]]; then
  _REIN_WANT_DEV_TREE=1
  shift
fi
REIN_LOCATE_UNTRUSTED_ENV=1

# ── E-223 (D-057 §3): the shared helper resolver ─────────────────────────────
# One policy, one place — see src/shared/locate.sh. Install mirror first; the dev tree
# only when this repo IS the framework clone. Bootstrapped install-first, then
# script-relative, so locating the resolver cannot itself consult the visited repo.
# ── F13: the guard must mean "my source SUCCEEDED", not "a name is defined" ──
# bash imports exported functions from the environment at startup, so an inherited
# `rein_locate` satisfies `declare -f`, the safe inline fallback is never installed, and
# the attacker's function IS the resolver — reachable on a partial or mid-upgrade install
# missing shared/locate.sh, which is exactly the degraded state the fallback exists for.
unset -f rein_locate rein_locate_enable_dev_tree rein_is_framework_clone rein_legacy_env_apply 2>/dev/null || true
for _l in "${REIN}/shared/locate.sh" \
          "$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/../shared/locate.sh"; do
  [[ -f "$_l" ]] && { . "$_l"; break; }
done
# E-383 (D-132 r4): AI_OS_<X> → REIN_<X> when the new name is unset (locate.sh); every  (rename:legacy-fallback)
# child `ai` spawns inherits the result. Without locate.sh there is no fallback, only new names.
if declare -f rein_legacy_env_apply >/dev/null 2>&1; then rein_legacy_env_apply; fi
if ! declare -f rein_locate >/dev/null 2>&1; then
  rein_locate() { local _c="${REIN}/${1}"; [[ -f "$_c" ]] && { printf '%s' "$_c"; return 0; }; return 1; }
fi
# _rein_helper <logical-path> — every helper lookup in this file goes through here.
# D-057 §3 names src/bin/ai, and the first pass converted only the three _locate_* wrappers
# while EIGHT other chains kept their own order — four of them cwd-relative FIRST, which is
# the defect in a more direct form than the original: no git repo is needed at all, so a
# `src/shared/memory-batch-scanner.mjs` in any directory `ai sync` runs from was executed.
_rein_helper() {
  local logical="$1" p
  p="$(rein_locate "$logical" 2>/dev/null || true)"
  [[ -n "$p" ]] && { printf '%s' "$p"; return 0; }
  # Script-relative sibling last: the install mirror still wins, and this only prevents
  # version skew between this script and the helper it drives (see _locate_* above).
  local _sd; _sd="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  # `${logical#src/}` is a no-op for every current logical path (all begin shared/,
  # scripts/ or agents/); it exists so a future `src/`-prefixed logical path maps onto the
  # repo layout rather than doubling the prefix.
  local _sib="${_sd%/*}/${logical#src/}"
  [[ -f "$_sib" ]] && { printf '%s' "$_sib"; return 0; }
  return 1
}

# Only now, after argv has been read and the resolver sourced.
if [[ "$_REIN_WANT_DEV_TREE" == "1" ]] && declare -f rein_locate_enable_dev_tree >/dev/null 2>&1; then
  rein_locate_enable_dev_tree
fi

usage() {
  cat <<USAGE
ai — Rein v${VERSION}

The shell CLI is a thin bootloader. Operational commands (planning, review,
testing, archive, digest) now run as prompts inside Claude Code.
See .ai/blueprints/cli-collapse.md for the migration map.

Commands:
  ai install     Install configs to ~/.claude + ~/.config/github-copilot;
                 enable agent teams; install hooks
  ai init        Create .ai/ in a new repo, or UPGRADE an existing one to the installed
                 version: refresh generated files, merge roles/providers, never touch
                 BRIEF/RULES/SEED/DIGEST/TASKS/LOG/architect.md/blueprints
  ai init --check  Dry run: list what ai init would change (exit 1 when anything would)
  ai sync        Re-sync agents, skills, bootloaders (ENGINEER.md, ARCHITECT.md +
                 CLAUDE.md shim, .mcp.json) and hooks into the project
  ai sync --github   Fetch assigned GitHub issues for the Architect cycle (§28)
  ai sync --prune-providers
                 Remove the workspace directories of
                 providers no role in .ai/roles.json is bound to. Manifest-aware:
                 only files sync wrote and nobody edited are deleted; anything else
                 is reported and kept. Never runs implicitly (E-244).
  ai doctor [--repair] [--compliance] [--env]
                 Diagnose PATH, configs, hooks, MCP; --compliance audits agent
                 frontmatter for Ghost Tools; --env deep-checks Node/binaries/
                 permissions and live MCP connectivity (exit 1 on critical fail)
  ai uninstall   Remove the global ~/.rein install (project .ai/ stays)
  ai start [--status | --kill [--yes] | --account <name> | --detach | --dry-run]
                 Build or reattach the project's tmux Triad (one session per
                 project, D-068): Engineer and Architect panes bound to their
                 roles. The skills wake each other with SendMessage (D-099).
                 Idempotent.
                 One project on a second Claude subscription (D-095):
                   ai account add work           # new config dir + /login
                   ai start --account work       # bind this project (.ai/start.json)
                   ai start                      # panes launch with CLAUDE_CONFIG_DIR
  ai pane <architect|engineer> [-- <claude args>]
                 Bind THIS pane to a role and launch Claude Code with that role's
                 model and permission overlay. The tester is headless (no pane).
  ai account list | add <name> [--dir <path>] | remove <name> | sync <name>
                 Claude accounts (D-095): one config directory per claude.ai login,
                 registered in ~/.rein/accounts.json; 'default' is ~/.claude
  ai add-task [flags] <description>
                 Register a task in .ai/state.sqlite from the shell (no MCP needed)
  ai task done <id> [--summary <text>]
                 Mark a task DONE through the same completion gates as the MCP tool
  ai task claim <id> | release <id> [--reason <text>] | claims [--fetch]
                 Team projects (D-102): claim a task on origin/<trunk> before writing
                 source for it, release it on abandon, list who holds what
  ai trunk [--doctor]
                 The project's trunk (D-105): .ai/team.json "trunk", else origin/HEAD,
                 else the one of main/master on origin. Exit 1 with [NO_TRUNK] when none
  ai state migrate --team [--trunk <name>] | --legacy
                 Team projects (D-102): one tracked record file per task and stamp
                 (--team), or fold them back into state.json (--legacy)
  ai state import [--dry-run] [--force]
                 Bring this machine's index up to what HEAD tracks (record files, or
                 HEAD:.ai/state.json per record — D-106); an empty index takes the
                 working state.json when nothing is committed (D-108)
  ai team add <email> --range <P>:<from>-<to> | ai team show
                 Per-developer id ranges and the planner (.ai/team.json)
  ai ci run [--ref <sha>] [--dirty] [--suite-only|--unit-only] [--keep]
                 Local CI (D-072): test a committed sha in a detached worktree
                 with a throwaway HOME; exit 0 PASS / 1 FAIL / 2 ERROR
  ai ci status [--ref <sha>] [--short] | ai ci list [-n N] | ai ci log [<sha>] [--failed]
                 Read the recorded local CI runs (.ai/state.sqlite ci_runs)
  ai clean [--apply] [--all] [--yes] [--project-only|--home-only] [--json]
                 List (and, with --apply, remove) what earlier Rein versions left
                 behind. Dry run by default; removals move to ~/.rein/trash/<date>/
                 and 'ai clean --restore <date>' puts them back
  ai gate off [--minutes N] [--reason TEXT] | on | status
                 Operator-only escape from the safe-exec policy gate (E-291): a
                 time-boxed override (default 15, max 60 min). Catastrophic commands
                 still block; every bypassed call is announced. Run it in YOUR terminal.
  ai version     Print version

Removed — use the agent skill instead (see .ai/blueprints/cli-collapse.md):
  update / onboard → Run 'ai start', type the planning request in the Architect pane
  preflight        → skill: ai-preflight  (auto-runs at session start)
  digest           → skill: ai-digest
  archive          → skill: ai-archive
  review           → skill: ai-review (Engineer) / skill: arch-review (Architect)
  test [--vibe]    → skill: ai-test  (--generate | --fast | --vibe)
  provider         → removed in v4; providers are configured in .ai/providers.json
  where            → echo \$REIN  (now stored as ~/.rein)

Recovery (used internally by install/init; surfaced by 'ai doctor' hints):
  migrate-state    Rebuild state from TASKS.md — lossy; refused with [LOSSY_RESEED] when the
                   committed state.json holds more (use: ai state import; or --from-tasks)
  mcp-setup        Install MCP-server npm deps under ~/.rein/mcp
USAGE
}

# E-34: Show migration guidance for removed commands. Single source of truth
# for the deprecation map so usage() and dispatch stay aligned.
_show_deprecated() {
  local old_cmd="$1" replacement="$2"
  cat >&2 <<DEP

[rein] "ai ${old_cmd}" was removed (see .ai/blueprints/cli-collapse.md).

Use the agent flow instead:
  ${replacement}

The shell CLI is now scoped to: install, init, sync, doctor, uninstall.
Run "ai" for the full command list.
DEP
  exit 1
}

# ── helpers ──────────────────────────────────────────────────────────────────

ensure_file_if_missing() {
  local src="$1" dst="$2"
  if [[ ! -f "$dst" ]]; then
    cp "$src" "$dst"
  fi
}

# E-52: Regenerate .ai/blueprints/mcp.md from registry.json + DOMAINS map.
# Locates the generator first in the in-repo scripts/ (development mode),
# falling back to ~/.rein/scripts/ (installed mode). Missing node or script
# returns 2 (skipped); a generator error returns 1 (FAILED — later steps still run, E-339).
_regenerate_mcp_docs() {
  if ! command -v node >/dev/null 2>&1; then
    echo "  ⚠ node not found — skipping mcp.md regeneration" >&2
    return 2
  fi
  local SCRIPT=""
  SCRIPT="$(_rein_helper scripts/generate_mcp_docs.mjs || true)"
  if [[ -z "$SCRIPT" ]]; then
    echo "  ⚠ generate_mcp_docs.mjs not found — skipping mcp.md regeneration" >&2
    return 2
  fi
  # E-339 (D-107 r1): the generator's stderr is the ✗ line's cause — never discarded.
  node "$SCRIPT" || return 1
  echo "  ✓ .ai/blueprints/mcp.md regenerated from registry.json"
}

# E-110: regenerate .ai/blueprints/_INDEX.md so it always lists every blueprint
# (the hand-curated index silently omitted 20+). Skipped = 2, generator error = 1 (E-339).
_regenerate_blueprints_index() {
  if ! command -v node >/dev/null 2>&1; then
    echo "  ⚠ node not found — skipping _INDEX.md regeneration" >&2
    return 2
  fi
  local SCRIPT=""
  SCRIPT="$(_rein_helper scripts/generate_blueprints_index.mjs || true)"
  if [[ -z "$SCRIPT" ]]; then
    echo "  ⚠ generate_blueprints_index.mjs not found — skipping _INDEX.md regeneration" >&2
    return 2
  fi
  node "$SCRIPT" || return 1   # E-339: stderr reaches the ✗ line
  echo "  ✓ .ai/blueprints/_INDEX.md regenerated (all blueprints indexed)"
}

# E-53/E-58: Flush .ai/state.sqlite WAL via the node:sqlite-backed
# wal-flusher.mjs helper (drift-resolution-2026.md §State Singularity +
# wal-checkpoint-node.md). Path is hardcoded — the node script also
# enforces .sqlite extension + existence + regular-file invariants. Node
# 22+ ships node:sqlite as a core module so the previous fail-open path
# on dev boxes without the sqlite3 CLI is gone; only a missing `node`
# binary itself can short-circuit, which is treated fail-open since it
# would mean nothing in this CLI works anyway.
_wal_checkpoint_state_db() {
  local DB=".ai/state.sqlite"
  [[ -f "$DB" ]] || return 2   # E-339: 2 = skipped by design (doctor calls this with || true)
  if ! command -v node >/dev/null 2>&1; then
    echo "  ⚠ node not found — skipping WAL checkpoint" >&2
    return 2
  fi
  # E-223: install mirror first, dev tree only inside the framework clone. The old chain
  # started cwd-relative, so running `ai sync` in any directory containing
  # src/shared/wal-flusher.mjs handed THAT file to node.
  local SCRIPT=""
  SCRIPT="$(_rein_helper shared/wal-flusher.mjs || true)"
  if [[ -z "$SCRIPT" ]]; then
    echo "  ⚠ wal-flusher.mjs not found — skipping WAL checkpoint" >&2
    return 2
  fi
  node "$SCRIPT" "$DB" || return 1   # E-339: stderr reaches the ✗ line
  echo "  ✓ WAL checkpoint complete (.ai/state.sqlite-wal flushed)"
}

# E-98: Regenerate .ai/REPO_MAP.md (AST repository map) during `ai sync`.
# Runs the ast-parser-mcp generate-map CLI over the workspace. Per blueprint
# §Execution Constraints this lives in `ai sync` (NOT the synchronous ai init /
# preflight loops). A missing server or node returns 2 (skipped); a parse error
# returns 1 (FAILED, E-339). REIN_DISABLE_REPO_MAP=1 is the rollback escape hatch.
_generate_repo_map() {
  [[ "${REIN_DISABLE_REPO_MAP:-}" == "1" ]] && { echo "  ⚠ REPO_MAP.md skipped (REIN_DISABLE_REPO_MAP=1)"; return 2; }
  if ! command -v node >/dev/null 2>&1; then
    echo "  ⚠ node not found — skipping REPO_MAP.md regeneration" >&2
    return 2
  fi
  local server="${REIN}/mcp/ast-parser-mcp/index.js"
  if [[ ! -f "$server" ]]; then
    echo "  ⚠ ast-parser-mcp not installed — skipping REPO_MAP.md (run: ai install)" >&2
    return 2
  fi
  # E-339 (D-107 r2): no 2>/dev/null — the cause of a failed map is the ✗ line. Non-fatal
  # still holds in the sense of D-107 r1: every later step runs.
  node "$server" --generate-map || return 1
  echo "  ✓ .ai/REPO_MAP.md regenerated (AST repository map)"
}

# E-145 (self-learning-arc, W5-T1): refresh the Memory Palace candidate index during
# sync so the multimodal-RAG memory layer stays current. API-FREE BY DESIGN — this only
# SCANS the workspace for eligible artifacts (memory-batch-scanner) and writes the candidate
# manifest to .ai/memory/palace-index.json. The actual embedding into the Memory Palace is
# the memory_curator agent's job (it has API access in a session) — a sync hook must never
# require network/keys. Fail-open; REIN_DISABLE_MEMORY_PALACE=1 is the escape hatch.
_generate_memory_palace() {
  [[ "${REIN_DISABLE_MEMORY_PALACE:-}" == "1" ]] && { echo "  ⚠ Memory Palace index skipped (REIN_DISABLE_MEMORY_PALACE=1)"; return 2; }
  command -v node >/dev/null 2>&1 || { echo "  ⚠ node not found — skipping Memory Palace index" >&2; return 2; }
  local scanner=""
  scanner="$(_rein_helper shared/memory-batch-scanner.mjs || true)"
  [[ -z "$scanner" ]] && { echo "  ⚠ memory-batch-scanner.mjs not found — skipping Memory Palace index" >&2; return 2; }
  # Every command below is guarded so a filesystem error can NEVER abort do_sync
  # under `set -euo pipefail` (fail-open is the load-bearing invariant — E-145 W5-T1).
  mkdir -p ".ai/memory" 2>/dev/null || { echo "  ⚠ cannot create .ai/memory — Memory Palace index not written" >&2; return 1; }
  if node "$scanner" --scan . > ".ai/memory/palace-index.json.tmp"; then
    # E-346 (D-109 r3): a failed rename leaves the old index in place — FAILED, not ok.
    mv -f ".ai/memory/palace-index.json.tmp" ".ai/memory/palace-index.json" \
      || { rm -f ".ai/memory/palace-index.json.tmp"; return 1; }
    # palace-index.json is the sync-time CANDIDATE manifest (observability + a fresh
    # input the memory_curator agent MAY read). The curator currently runs its own
    # scan when it embeds; wiring it to consume this manifest is an Architect call
    # (scan-on-sync is a §35 seam, not yet in a blueprint — flagged for ratification).
    echo "  ✓ .ai/memory/palace-index.json refreshed (Memory Palace candidate manifest)"
  else
    rm -f ".ai/memory/palace-index.json.tmp" 2>/dev/null || true
    return 1   # E-339: the scanner's stderr is the ✗ line
  fi
}

# E-112 (caching.md §3.1): rebuild the cache-manager System Context cache during
# sync so the cache-manager-mcp is actually exercised in a live flow (it was
# built but never invoked). Fail-open; REIN_DISABLE_CACHE=1 is the escape hatch.
_rebuild_context_cache() {
  [[ "${REIN_DISABLE_CACHE:-}" == "1" ]] && { echo "  ⚠ context cache skipped (REIN_DISABLE_CACHE=1)"; return 0; }
  if ! command -v node >/dev/null 2>&1; then
    echo "  ⚠ node not found — skipping context cache rebuild" >&2
    return 0
  fi
  local server="${REIN}/mcp/cache-manager-mcp/index.js"
  if [[ ! -f "$server" ]]; then
    echo "  ⚠ cache-manager-mcp not installed — skipping context cache (run: ai install)" >&2
    return 0
  fi
  if node "$server" --build 2>/dev/null; then
    echo "  ✓ context cache rebuilt (cache-manager System Context)"
  else
    echo "  ⚠ context cache rebuild failed — non-fatal (sync continues)" >&2
  fi
}

# E-62: Resolve canonical Rein framework clone path. Order (E-304: file first):
#   1. ${REIN}/config/rein-workspace.txt (persisted by install-rein.sh)
#   2. $REIN_WORKSPACE if exported and no file exists
#   3. empty string (no opinion — task-synchronizer-mcp will refuse cross-
#      workspace writes and fall back to local .ai/ per task-routing.md)
# Pure read — never validates path traversal here; consumers enforce.
# E-304 (D-089 r2): the PERSISTED file wins; an exported REIN_WORKSPACE is honoured only when
# no file exists. The old order let a stale `export REIN_WORKSPACE=…` in a shell profile beat
# the installer's own record, so reinstalling from a clean tree did not change where `ai sync`
# copied hooks from (2026-10-04). `ai doctor` warns when the two exist and disagree.
_resolve_rein_workspace() {
  local persisted="${REIN}/config/rein-workspace.txt"
  if [[ -f "$persisted" ]]; then
    head -n 1 "$persisted" 2>/dev/null | tr -d '\n'
    return 0
  fi
  if [[ -n "${REIN_WORKSPACE:-}" ]]; then
    printf "%s" "${REIN_WORKSPACE}"
    return 0
  fi
  printf ""
}

# Generates .mcp.json with absolute paths to ~/.rein/mcp/<server>/index.js
# Uses registry.json as source of truth. Preserves user-set env values.
generate_mcp_json() {
  local DEST_DIR="${1:-.}"
  # E-138 (role-abstraction.md): optional explicit output path + top-level key so the
  # Provider Adapter System can emit per-provider MCP configs. Defaults preserve
  # .mcp.json behaviour.
  local MCP_FILE="${2:-${DEST_DIR}/.mcp.json}"
  local MCP_KEY="${3:-mcpServers}"
  local REGISTRY="${REIN}/config/registry.json"

  if ! command -v python3 &>/dev/null; then
    [[ -f "${REIN}/templates/.mcp.json" ]] && cp "${REIN}/templates/.mcp.json" "$MCP_FILE"
    return
  fi

  # E-274 (D-074 §Components 2): .mcp.json is generated but PARTLY USER-OWNED. A server
  # named in registry.json, or in the legacy registry's registry_history (every server
  # name Rein ever shipped), is OWNED: regenerated from the registry, and removed once
  # retired. Every other entry is USER-ADDED and is carried over byte-for-byte, and a user
  # `env` block on an owned server is carried over too (user keys win over registry keys).
  # This used to rebuild the file from the registry alone — dropping user servers and
  # env — while the comment at the call site said it preserved them.
  python3 - "$REGISTRY" "$MCP_FILE" "$HOME" "$REIN" "$MCP_KEY" "${REIN}/config/legacy-artefacts.json" <<'PY'
import json, sys, os
registry_path, mcp_path, home, rein, mcp_key, legacy_path = sys.argv[1:7]

servers = {
  "filesystem": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.1.14", "."],
    "description": "Scoped filesystem access — enforces CAPABILITIES.md path restrictions. Restricts to project root by default."
  },
  "memory": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-memory@2026.1.26"],
    "description": "Knowledge-graph memory store. Queryable alternative/supplement to DIGEST.md for semantic lookups."
  }
}

if os.path.exists(registry_path):
    with open(registry_path) as f:
        reg = json.load(f)
    for name, info in reg.get("mcp_servers", {}).items():
        if "path" in info:
            abs_path = os.path.join(rein, "mcp", name, "index.js")
            entry = {"command": "node", "args": [abs_path]}
            # E-38: propagate registry-declared env (a server that declares an
            # env block, e.g. a sandbox DISPLAY/HOME). Without this, `ai sync`
            # silently strips it on every run and regresses D-002.
            if isinstance(info.get("env"), dict) and info["env"]:
                entry["env"] = dict(info["env"])
            servers[name] = entry

owned = set(servers)
try:
    with open(legacy_path) as f:
        owned |= {n for n in json.load(f).get("registry_history", []) if isinstance(n, str)}
except Exception:
    # No legacy registry: only the servers generated above count as owned. Unknown names
    # are then all treated as user-added and KEPT — the failure mode is a stale entry
    # left behind, never a user's server deleted.
    pass

existing, other_keys = {}, {}
if os.path.exists(mcp_path):
    try:
        with open(mcp_path) as f:
            doc = json.load(f)
        if isinstance(doc, dict):
            other_keys = {k: v for k, v in doc.items() if k != mcp_key}
            if isinstance(doc.get(mcp_key), dict):
                existing = doc[mcp_key]
    except Exception:
        # An unparsable file cannot be merged. Keep a copy rather than lose what the user
        # had in it, then regenerate.
        try:
            os.replace(mcp_path, mcp_path + ".unparsable.bak")
            sys.stderr.write(f"  ⚠  {mcp_path} was not valid JSON — kept as {mcp_path}.unparsable.bak\n")
        except OSError:
            pass

for name, spec in existing.items():
    if not isinstance(spec, dict):
        continue
    if name in servers:
        # User keys win over registry keys. Trade-off: a registry env value that later
        # changes does not reach a file that already carries the old one; today no
        # registry server declares env at all, so nothing can be stranded yet.
        user_env = spec.get("env")
        if isinstance(user_env, dict) and user_env:
            servers[name]["env"] = {**servers[name].get("env", {}), **user_env}
    elif name not in owned:
        servers[name] = spec          # user-added: byte-for-byte (same JSON value)

with open(mcp_path, "w") as f:
    json.dump({**other_keys, mcp_key: servers}, f, indent=2)
    f.write("\n")
PY
}


# ── E-135 (role-abstraction.md): Role Configuration Store ─────────────────────
# Decouples functional roles (architect/engineer) from specific CLIs. `ai install`
# accepts `--architect <provider:pane>` / `--engineer <provider:pane>` overrides and
# persists them to .ai/roles.json. Defaults (D-066/D-069) map architect=claude:1,
# engineer=claude:0 — any provider may still assume either role via the flags.
ROLE_ARCHITECT=""
ROLE_ENGINEER=""

# Parse --architect/--engineer role-override flags into the ROLE_* globals. Format is
# strict <provider>:<pane> (provider [a-z][a-z0-9_-]*, pane a non-negative integer).
# Unknown args are ignored; malformed role values abort (exit 2).
_parse_role_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --architect) ROLE_ARCHITECT="${2:-}"; shift 2 ;;
      --engineer)  ROLE_ENGINEER="${2:-}";  shift 2 ;;
      *)           shift ;;
    esac
  done
  local re='^[a-z][a-z0-9_-]*:[0-9]+$'
  if [[ -n "$ROLE_ARCHITECT" && ! "$ROLE_ARCHITECT" =~ $re ]]; then
    echo "[ERROR] --architect must be <provider>:<pane> (e.g. claude:1), got '$ROLE_ARCHITECT'" >&2
    exit 2
  fi
  if [[ -n "$ROLE_ENGINEER" && ! "$ROLE_ENGINEER" =~ $re ]]; then
    echo "[ERROR] --engineer must be <provider>:<pane> (e.g. claude:0), got '$ROLE_ENGINEER'" >&2
    exit 2
  fi
}

# Write .ai/roles.json from the parsed flags (legacy defaults for any role left
# unspecified). No-op outside a project (.ai/ absent). Values are pre-validated by
# _parse_role_flags, so direct interpolation is injection-safe.
# D-066: the all-Claude Triad is the DEFAULT — architect on `fable`, engineer on `opus`.
# claude is the only provider in v4 (D-069); roles stay abstract so a future one is config, not code. What changed
# is which topology a project gets when nobody says otherwise.
#
# The MODEL is written per role because the two roles want different ones, and `ai pane`
# already forwards `--model`. A model is emitted only when known: an unrecognised provider
# gets no `model` key rather than a claude model name, which would be meaningless to it.
_write_roles_json() {
  [[ -d ".ai" ]] || return 0
  local arch="${ROLE_ARCHITECT:-claude:1}" eng="${ROLE_ENGINEER:-claude:0}"
  local apr="${arch%%:*}" apn="${arch##*:}" epr="${eng%%:*}" epn="${eng##*:}"
  local amod="${ROLE_ARCHITECT_MODEL:-}" emod="${ROLE_ENGINEER_MODEL:-}"
  [[ -z "$amod" && "$apr" == "claude" ]] && amod="fable"
  [[ -z "$emod" && "$epr" == "claude" ]] && emod="opus"
  local aline="" eline=""
  [[ -n "$amod" ]] && aline=",
      \"model\": \"${amod}\""
  [[ -n "$emod" ]] && eline=",
      \"model\": \"${emod}\""
  cat > ".ai/roles.json" <<EOF
{
  "roles": {
    "architect": {
      "provider": "${apr}",
      "pane_identifier": "${apn}"${aline}
    },
    "engineer": {
      "provider": "${epr}",
      "pane_identifier": "${epn}"${eline}
    },
    "tester": {
      "provider": "claude",
      "model": "sonnet",
      "headless": true
    }
  }
}
EOF
  echo "✓ Wrote .ai/roles.json (architect=${apr}:${apn}${amod:+ · $amod}, engineer=${epr}:${epn}${emod:+ · $emod}, tester=claude · sonnet (headless))"
}

# E-182/E-184 follow-up: cosmetic Triad-banner labels for do_init. Prints
# "<architect_provider>|<engineer_provider>" read from .ai/roles.json, so the
# banner never restales when a role is re-bound. Falls back to the D-066 defaults (architect=claude, engineer=claude)
# when the file is missing/malformed or python3 is unavailable. Cosmetic only —
# this NEVER affects handoff routing (the skills' SendMessage owns that). Safe under set -euo
# pipefail: the python heredoc is guarded by `|| printf ''`.
# D-066/E-243: labels are DERIVED, never literal. Every vendor name a user sees now comes
# from roles.json, so re-binding a role changes the banners, the task owner and the
# footer together — the drift that once left a vendor name on every task
# hard-coded in three places while the project ran all-Claude.
#
# Emits "<arch_provider>·<arch_model>|<eng_provider>·<eng_model>"; the model half is empty
# when a role declares none.
_roles_banner_labels() {
  local roles_file=".ai/roles.json" arch="claude·fable" eng="claude·opus" tst="claude·sonnet" parsed=""
  if [[ -f "$roles_file" ]] && command -v python3 &>/dev/null; then
    parsed="$(python3 - "$roles_file" 2>/dev/null <<'PY' || printf ''
import json, sys
try:
    roles = (json.load(open(sys.argv[1])) or {}).get("roles", {})
    def label(role, dprov, dmodel):
        r = roles.get(role) if isinstance(roles.get(role), dict) else {}
        p = r.get("provider") or dprov
        m = r.get("model") or (dmodel if p == dprov else "")
        return "%s\u00b7%s" % (p, m) if m else p
    sys.stdout.write("%s|%s|%s" % (label("architect", "claude", "fable"),
                                   label("engineer", "claude", "opus"),
                                   label("tester", "claude", "sonnet")))
except Exception:
    sys.stdout.write("")
PY
)"
    if [[ "$parsed" == *"|"*"|"* ]]; then
      IFS='|' read -r arch eng tst <<< "$parsed"
    fi
  fi
  printf '%s|%s|%s' "$arch" "$eng" "$tst"
}

# v3.0 (W3-T3): single source for scaffolding/refreshing the project-scoped agent
# dirs (.claude/) from the installed mirror. Collapses the
# duplicated blocks in ensure_ai_templates (init) and do_sync (sync). $1 selects
# the user-facing wording only ("init" → "Created …", "sync" → indented "… synced");
# the filesystem operations are identical.

# ── E-212 (architect-provider-parity.md §Components 1-2): role-aware provisioning ──
# Locate the role-manifest resolver (dev tree first, then the install mirror).
_locate_role_manifest() {
  local c
  rein_locate "shared/role-manifest.mjs" && return 0
  # F3: keep the script-relative sibling as a LAST candidate. The shared resolver drops
  # the dev tree outside the recorded workspace, so a git worktree or a second framework
  # clone would exec a helper from a DIFFERENT version than the `ai` script that was
  # invoked. The install mirror still wins, so this costs nothing in trust — it only
  # stops silent version skew between this script and the helper it drives.
  local _sd; _sd="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  local _sib="${_sd%/*}/shared/role-manifest.mjs"
  [[ -f "$_sib" ]] && { printf '%s' "$_sib"; return 0; }
  return 1
}

# _provider_source_dirs <provider> [--agents|--roles] → one source dir per line.
# Unions the `shared` role with every role .ai/roles.json binds to <provider>, per the
# registry.json manifest. Empty output is a NORMAL state (a provider serving no role).
# Fail-open: if the resolver or node is unavailable, prints nothing and the caller
# falls back to its legacy hardcoded set, so sync never breaks on a missing helper.
_provider_source_dirs() {
  local provider="$1" flag="${2:-}"
  local rm; rm="$(_locate_role_manifest || true)"
  [[ -z "$rm" ]] && return 0
  command -v node >/dev/null 2>&1 || return 0
  node --no-warnings "$rm" ".ai" "${REIN}/config/registry.json" "$provider" "$flag" 2>/dev/null || true
}

# _provision_workspace <provider> <workspace_dir> <copy_agents:yes|no> [legacy_skill_dirs...]
# Copies every source skill dir the provider serves into <workspace_dir>/skills, and
# (when copy_agents=yes) every agent dir into <workspace_dir>/agents. Falls back to the
# caller-supplied legacy dirs when the manifest yields nothing, so a project whose
# registry.json predates E-212 provisions exactly as before.
#
# Additive by design (sync_skills_20 is cp -rf, never a prune) — matches existing
# behaviour: rebinding a role leaves the previous provider's copies until it re-syncs.
# NOTE ON BASH 3.2 (macOS ships 3.2.57, and this script runs under `set -u`):
# expanding an EMPTY array as "${arr[@]}" raises "unbound variable" on 3.2 — it only
# became safe in bash 4.4. Every array expansion below is therefore either guarded by
# a ${#arr[@]} count or written as ${arr[@]+"${arr[@]}"}. An unserved provider yields
# an empty list, which is a NORMAL state, so this is the common path, not an edge case.
# _sync_skills_no_clobber <src_dir> <dst_dir> <label> — E-212 collision guard.
#
# WHY: two roles can ship DIFFERENT skills under the SAME name. `ai-task` is the live
# case — src/shared/skills/ai-task manages the Engineer's E-## lifecycle, while
# src/agents/skills/ai-task manages the Architect's P-## lifecycle and hands off to
# Claude. (`repo-oracle` is the second.)
#
# THE OVERRIDE RULE DEPENDS ON HOW MANY ROLES THE WORKSPACE SERVES:
#   - SINGLE-role workspace: a role skill legitimately OVERRIDES the shared baseline.
#     That is the historical behaviour (an Architect pane gets the Architect's ai-task)
#     and it is preserved exactly — changing it would regress every split Triad.
#   - MULTI-role workspace (the D-054 same-provider case): the "override" is no longer
#     meaningful, because the shared copy is what the OTHER role in the same directory
#     reads. A flat skills dir cannot hold both, and do_sync cannot know which role the
#     reading pane will hold — so the shared baseline is KEPT and the role variant is
#     reported rather than silently swapped in. Without this, the Engineer pane loaded
#     the Architect's task skill; verified live, it did.
#
# The real fix — role-scoped skill directories, or renaming the colliding Architect
# skills — changes the skill-discovery contract and is an Architect ruling
# (architect-provider-parity.md §Components 2 does not cover same-name collisions).
# Escalated 2026-09-07.
_sync_skills_no_clobber() {
  local src_dir="$1" dst_dir="$2" label="$3"
  local count=0 skipped=0 skill_dir name
  for skill_dir in "${src_dir}"/*/; do
    [[ -d "$skill_dir" && -f "${skill_dir}SKILL.md" ]] || continue
    name="$(basename "$skill_dir")"
    # A name already on DISK is not evidence of a collision: it may simply be a stale
    # copy this same source wrote on an earlier sync. Only a name PROVIDED BY ANOTHER
    # SOURCE IN THIS RUN is a real two-role collision. Comparing against disk residue
    # reported `task-planner` — a skill that exists in exactly one source dir — the
    # moment its content was edited. bash 3.2 has no associative arrays, so the claim
    # set is a delimited string.
    if [[ -e "${dst_dir}/${name}" ]] && [[ "${_SKILL_CLAIMS:-}" == *"|${name}|"* ]]; then
      # Identical content is not a collision — it is the same skill shipped twice.
      if ! diff -rq "${skill_dir%/}" "${dst_dir}/${name}" >/dev/null 2>&1; then
        # E-217 (D-055 R2): a collision in a MULTI-ROLE workspace is now an ERROR, not
        # a warning. The Architect ruled the resolution is renaming (arch-task /
        # arch-oracle), so a remaining collision means a skill was added without one —
        # and silently keeping the older copy is exactly how the Engineer pane ended up
        # loading the Architect's ai-task. Single-role workspaces never reach here:
        # they keep the historical role-overrides-shared behaviour.
        echo "  ✗ COLLISION: '${name}' from ${label} differs from the copy already in ${dst_dir}." >&2
        echo "    A multi-role workspace cannot hold two different skills under one name." >&2
        echo "    Rename the role-specific one (see arch-task / arch-oracle, D-055 R2)." >&2
        skipped=$((skipped + 1))
        SKILL_COLLISIONS=$((${SKILL_COLLISIONS:-0} + 1))
      fi
      continue
    fi
    cp -rf "${skill_dir%/}" "${dst_dir}/"
    _SKILL_CLAIMS="${_SKILL_CLAIMS:-|}${name}|"
    count=$((count + 1))
  done
  # Legacy flat .md files: same first-wins rule.
  local f
  for f in "${src_dir}"/*.md; do
    [[ -f "$f" ]] || continue
    [[ -e "${dst_dir}/$(basename "$f")" ]] && continue
    cp -f "$f" "${dst_dir}/"
  done
  echo "  $count Skills 2.0 folder(s) synced from ${src_dir}$([[ "$skipped" -gt 0 ]] && echo " (${skipped} name collision(s) — see errors above)")"
  _generate_skills_index "${dst_dir}"
}

# _provision_workspace <provider> <ws> <copy_skills:yes|no> <copy_agents:yes|no> [legacy_skill_dirs...]
_provision_workspace() {
  local provider="$1" ws="$2" copy_skills="$3" copy_agents="$4"; shift 4
  local -a legacy=()
  [[ "$#" -gt 0 ]] && legacy=("$@")
  local -a skill_dirs=() agent_dirs=()
  local line

  while IFS= read -r line; do [[ -n "$line" ]] && skill_dirs+=("$line"); done < <(_provider_source_dirs "$provider")
  # A provider bound to NO role keeps its historical provisioning rather than being
  # stripped back to `shared` only. Rebinding a role
  # must not quietly empty the other provider's workspace: the user may switch back,
  # and sync is additive everywhere else. The manifest always yields at least
  # `shared/skills`, so the emptiness test is on SERVED ROLES, not on the dir list.
  if [[ "${#legacy[@]}" -gt 0 ]]; then
    local _served_probe; _served_probe="$(_provider_source_dirs "$provider" --roles)"
    [[ -z "$_served_probe" ]] && skill_dirs=("${legacy[@]}")
  fi

  # How many roles this workspace serves decides the override rule (see the comment
  # on _sync_skills_no_clobber). One role → historical overwrite semantics; two or
  # more → keep the shared baseline and report the collision.
  local -a served_roles=()
  while IFS= read -r line; do [[ -n "$line" ]] && served_roles+=("$line"); done < <(_provider_source_dirs "$provider" --roles)
  local multi_role=0
  [[ "${#served_roles[@]}" -gt 1 ]] && multi_role=1

  if [[ "$copy_skills" == "yes" ]]; then
  # Names claimed by an earlier SOURCE while provisioning THIS workspace.
  _SKILL_CLAIMS="|"
  mkdir -p "${ws}/skills"
  if [[ "${#skill_dirs[@]}" -gt 0 ]]; then
    local first=1
    for line in "${skill_dirs[@]}"; do
      [[ -d "${REIN}/${line}" ]] || continue
      if [[ "$first" -eq 1 || "$multi_role" -eq 0 ]]; then
        sync_skills_20 "${REIN}/${line}" "${ws}/skills"
        first=0
      else
        _sync_skills_no_clobber "${REIN}/${line}" "${ws}/skills" "$line"
      fi
    done
    # Prune with the SAME source array the copy above just consumed. Deriving the
    # canonical list a second way would let provisioning and pruning disagree about
    # what is canonical — which is precisely how a "cleanup" deletes something real.
    local -a _abs=()
    for line in "${skill_dirs[@]}"; do
      [[ -d "${REIN}/${line}" ]] && _abs+=("${REIN}/${line}")
    done
    [[ "${#_abs[@]}" -gt 0 ]] && _prune_workspace_dir "${ws}/skills" "${_abs[@]}"
  fi
  fi

  if [[ "$copy_agents" == "yes" ]]; then
    while IFS= read -r line; do [[ -n "$line" ]] && agent_dirs+=("$line"); done < <(_provider_source_dirs "$provider" --agents)
    mkdir -p "${ws}/agents"
    if [[ "${#agent_dirs[@]}" -gt 0 ]]; then
      for line in "${agent_dirs[@]}"; do
        [[ -d "${REIN}/${line}" ]] && cp -f "${REIN}/${line}/"*.md "${ws}/agents/" 2>/dev/null || true
      done
      # E-273 (D-074 §Components 5): agents get the skills' manifest treatment. An agent
      # sync wrote, nobody edited, and the role manifest no longer provides is pruned; an
      # agent the user added was never recorded and is kept (E-220 evidence rule).
      local -a _aabs=()
      for line in "${agent_dirs[@]}"; do
        [[ -d "${REIN}/${line}" ]] && _aabs+=("${REIN}/${line}")
      done
      [[ "${#_aabs[@]}" -gt 0 ]] && _prune_workspace_dir "${ws}/agents" "${_aabs[@]}"
    fi
  fi

  local served; served="$(_provider_source_dirs "$provider" --roles | tr '\n' ' ')"
  [[ -n "$served" ]] && echo "  ${ws}/ serves role(s): ${served}"
  return 0
}


# ── E-220 (D-056 R2): manifest-scoped pruning ────────────────────────────────
# `ai sync` has always been additive, which is safe but leaky: after the E-217 rename
# the old `ai-task` / `repo-oracle` directories survived in every workspace forever.
# The obvious fix — delete anything not in the source — is the dangerous one, because a
# user's own skill is exactly "not in the source". So a path is removed only when sync
# WROTE it (manifest), NOBODY HAS EDITED IT SINCE (hash), and it is GONE UPSTREAM.
# Everything else is reported as `orphan (kept)`. A first run has no manifest and
# therefore prunes nothing.
#
# Rollback: REIN_NO_PRUNE=1 skips pruning entirely (the manifest is still recorded, so
# a later run can prune once the flag is removed).
_locate_sync_manifest() {
  local c
  rein_locate "shared/sync-manifest.mjs" && return 0
  # F3: keep the script-relative sibling as a LAST candidate. The shared resolver drops
  # the dev tree outside the recorded workspace, so a git worktree or a second framework
  # clone would exec a helper from a DIFFERENT version than the `ai` script that was
  # invoked. The install mirror still wins, so this costs nothing in trust — it only
  # stops silent version skew between this script and the helper it drives.
  local _sd; _sd="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  local _sib="${_sd%/*}/shared/sync-manifest.mjs"
  [[ -f "$_sib" ]] && { printf '%s' "$_sib"; return 0; }
  return 1
}

# _prune_workspace_dir <target_dir> <source_dir...>
# Names provided by the current sources decide what is still upstream.
_prune_workspace_dir() {
  local dst="$1"; shift
  [[ -d "$dst" ]] || return 0
  [[ "${REIN_NO_PRUNE:-0}" == "1" ]] && return 0
  command -v node >/dev/null 2>&1 || return 0
  local sm; sm="$(_locate_sync_manifest || true)"
  [[ -n "$sm" ]] || return 0

  # Names the current sources provide, as JSON for the helper.
  local names_json canon_json d n
  names_json="$(mktemp)"; canon_json="$(mktemp)"
  {
    printf '['
    local first=1
    for d in "$@"; do
      [[ -d "$d" ]] || continue
      for n in "$d"/*/; do
        [[ -d "$n" && -f "${n}SKILL.md" ]] || continue
        [[ "$first" -eq 1 ]] || printf ','
        printf '"%s"' "$(basename "$n")"
        first=0
      done
      for n in "$d"/*.md; do
        [[ -f "$n" ]] || continue
        [[ "$first" -eq 1 ]] || printf ','
        printf '"%s"' "$(basename "$n")"
        first=0
      done
    done
    printf ']'
  } > "$names_json"
  # Canonical source dirs, for the --prune-known identity check.
  { printf '['; local f2=1; for d in "$@"; do [[ -d "$d" ]] || continue; [[ "$f2" -eq 1 ]] || printf ','; printf '"%s"' "$d"; f2=0; done; printf ']'; } > "$canon_json"

  local mode="apply" extra=()
  [[ "${REIN_PRUNE_KNOWN:-0}" == "1" ]] && extra+=("--prune-known")
  local out
  out="$(node --no-warnings "$sm" "$mode" "$dst" "$names_json" "${extra[@]:-}" --canon "$canon_json" 2>/dev/null || true)"
  rm -f "$names_json" "$canon_json"
  [[ -z "$out" ]] && return 0
  local line
  while IFS= read -r line; do
    case "$line" in
      PRUNE*) echo "  - pruned ${line#PRUNE }" ;;
      KEEP*)  echo "  ! orphan (kept) ${line#KEEP }" >&2 ;;
    esac
  done <<< "$out"
  return 0
}


# ── E-244 (D-066 §4): mapped-only provider workspaces ────────────────────────
# `ai sync` provisioned a workspace per vendor on every project unconditionally.
# Under the all-Claude default that leaves two fully-populated workspaces for CLIs no
# role is bound to — and in THIS repository they are tracked, so the noise is in git too.
# Provisioning now follows the binding; the directories stay vendor-named and the
# the single src/claude adapter is untouched.
_locate_provider_workspace() {
  rein_locate "shared/provider-workspace.mjs" && return 0
  local _sd; _sd="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  local _sib="${_sd%/*}/shared/provider-workspace.mjs"
  [[ -f "$_sib" ]] && { printf '%s' "$_sib"; return 0; }
  return 1
}

# _provider_workspace_rows <list|stale> → TSV from the classifier, or nothing.
# FAIL-OPEN: no node, no helper, or a helper error prints nothing. Every caller treats
# "nothing" as "provision everything / prune nothing", so a missing helper can never
# cause a workspace to be skipped or deleted.
# Memoised per process: `ai sync` asks twice per provider and `ai doctor` once more,
# and a node spawn is the single most expensive thing either command does. The cache is
# per-invocation, so it can never go stale relative to a roles.json edit between runs.
_PW_ROWS_LIST=""
_PW_ROWS_STALE=""
_PW_ROWS_CACHED=0
_provider_workspace_rows() {
  local mode="${1:-list}"
  if [[ "$_PW_ROWS_CACHED" -eq 0 ]]; then
    _PW_ROWS_CACHED=1
    command -v node >/dev/null 2>&1 || return 0
    local pw; pw="$(_locate_provider_workspace || true)"
    [[ -n "$pw" ]] || return 0
    _PW_ROWS_LIST="$(node --no-warnings "$pw" list ".ai" "." 2>/dev/null || true)"
    _PW_ROWS_STALE="$(node --no-warnings "$pw" stale ".ai" "." 2>/dev/null || true)"
  fi
  case "$mode" in
    stale) printf '%s' "$_PW_ROWS_STALE" ;;
    *)     printf '%s' "$_PW_ROWS_LIST" ;;
  esac
  return 0
}

# _provider_is_provisionable <provider> → 0 when this project should have that
# provider's workspace. Fail-open: an unclassifiable project provisions as before.
_provider_is_provisionable() {
  local want="$1" rows p d status
  rows="$(_provider_workspace_rows list)"
  [[ -z "$rows" ]] && return 0
  while IFS=$'\t' read -r p d status _rest; do
    [[ "$p" == "$want" ]] || continue
    case "$status" in
      mapped|always) return 0 ;;
      *)             return 1 ;;
    esac
  done <<< "$rows"
  # A provider the classifier does not know about is not one we can judge — provision it.
  return 0
}

# _report_stale_provider_workspaces — read-only. Used by `ai doctor`, and by `ai sync`
# to say once that something is there to clean up. Never deletes: naming the directory
# and the command is the whole job.
_report_stale_provider_workspaces() {
  local rows; rows="$(_provider_workspace_rows stale)"
  [[ -z "$rows" ]] && return 0
  local p d _c n=0
  while IFS=$'\t' read -r p d _c; do
    [[ -n "$p" ]] || continue
    echo "  ! stale provider workspace: ${d}/ — no role is bound to '${p}' (.ai/roles.json)"
    n=$((n + 1))
  done <<< "$rows"
  [[ "$n" -gt 0 ]] && echo "    Remove with: ai sync --prune-providers   (manifest-aware; your own files are kept)"
  return 0
}

# _prune_provider_workspaces — remove the workspaces of providers no role is bound to.
#
# EXPLICIT ONLY. This never runs as part of a plain `ai sync`. A housekeeping feature
# that deletes directories on a command people run reflexively is how a "cleanup" becomes
# an incident; the flag is the consent.
#
# The evidence rules are E-220's, unchanged, applied with an EMPTY source set — for an
# unmapped provider nothing is upstream any more, so every entry sync wrote and nobody
# edited is prunable, and everything else is reported as `orphan (kept)`. That is why
# this reuses _prune_workspace_dir instead of reaching for `rm -rf`: a user's own skill
# sitting in a stale workspace's skills/ is protected here by exactly the same rule that
# protects it during an ordinary sync.
#
# The directory itself is removed ONLY when it ends up empty. Anything left is named,
# with the reason, so the operator finishes the job deliberately or not at all.
_prune_provider_workspaces() {
  local rows; rows="$(_provider_workspace_rows stale)"
  if [[ -z "$rows" ]]; then
    echo "  No stale provider workspaces — every provider with a workspace serves a role."
    return 0
  fi
  local provider dir mcp sub
  while IFS=$'\t' read -r provider dir mcp; do
    [[ -n "$provider" && -n "$dir" && -d "$dir" ]] || continue
    echo "  Pruning ${dir}/ — no role is bound to '${provider}'."
    # Managed entries first: skills/ and agents/ hold the skill dirs and flat .md files
    # sync-manifest knows how to judge. No source dirs are passed, so the source set is
    # empty by construction.
    # Byte-identity with a CURRENT canonical skill is evidence in its own right (E-220's
    # --prune-known): a leftover that matches the framework's own copy exactly carries
    # nothing a user could lose. It matters here more than it does during an ordinary
    # sync, because the leftovers a stale workspace holds are mostly recorded-then-
    # -source-changed copies that the hash check alone reports as "modified since sync
    # wrote it" — true of the manifest, but not of the file, which is identical to what
    # ships today. The NAME set stays empty (nothing is upstream for an unmapped
    # provider); only the identity evidence is added.
    local -a _canon=()
    for sub in shared/skills claude/skills shared/agents claude/agents; do
      [[ -d "${REIN}/${sub}" ]] && _canon+=("${REIN}/${sub}")
    done
    for sub in skills agents; do
      [[ -d "${dir}/${sub}" ]] && REIN_PRUNE_KNOWN=1 \
        _prune_stale_workspace_dir "${dir}/${sub}" ${_canon[@]+"${_canon[@]}"}
    done
    # Sync's own bookkeeping. These are not user content by definition — sync writes them
    # and only sync reads them — so they go with the entries they describe.
    rm -f "${dir}/skills/_SKILLS_INDEX.md" "${dir}/agents/_SKILLS_INDEX.md" \
          "${dir}/skills/_SYNC_MANIFEST.json" "${dir}/agents/_SYNC_MANIFEST.json" 2>/dev/null || true
    # The provider's generated MCP config, when .ai/providers.json declares this path as
    # that provider's — the registry naming the file IS the provenance. Only inside the
    # workspace being pruned: `claude` maps to a root-level .claude.json, and a stale
    # provider must never be able to point the pruner at a file outside its own dir.
    if [[ -n "$mcp" && "$mcp" == "${dir}/"* && -f "$mcp" ]]; then
      rm -f "$mcp" && echo "    - removed ${mcp} (generated MCP config for '${provider}')"
    fi
    # Empty directories are the only ones removed outright.
    find "$dir" -type d -empty -delete 2>/dev/null || true
    if [[ -d "$dir" ]]; then
      echo "    ! ${dir}/ kept — it still holds files this command cannot prove are disposable:" >&2
      find "$dir" -type f 2>/dev/null | sed 's/^/      /' >&2
      echo "      Review them and remove ${dir}/ by hand if they are not yours." >&2
    else
      echo "    ✓ ${dir}/ removed."
    fi
  done <<< "$rows"
  return 0
}

# _prune_stale_workspace_dir <dst> <canonical_source_dir...>
# Like _prune_workspace_dir, but the SOURCE-NAME set is empty by construction: for a
# provider no role is bound to, nothing upstream provides anything. The directories are
# passed only as the identity corpus for --prune-known.
_prune_stale_workspace_dir() {
  local dst="$1"; shift
  [[ -d "$dst" ]] || return 0
  [[ "${REIN_NO_PRUNE:-0}" == "1" ]] && return 0
  command -v node >/dev/null 2>&1 || return 0
  local sm; sm="$(_locate_sync_manifest || true)"
  [[ -n "$sm" ]] || return 0

  local names_json canon_json d
  names_json="$(mktemp)"; canon_json="$(mktemp)"
  printf '[]' > "$names_json"
  { printf '['; local f=1; for d in "$@"; do [[ -d "$d" ]] || continue; [[ "$f" -eq 1 ]] || printf ','; printf '"%s"' "$d"; f=0; done; printf ']'; } > "$canon_json"

  local extra=()
  [[ "${REIN_PRUNE_KNOWN:-0}" == "1" ]] && extra+=("--prune-known")
  local out
  out="$(node --no-warnings "$sm" apply "$dst" "$names_json" "${extra[@]:-}" --canon "$canon_json" 2>/dev/null || true)"
  rm -f "$names_json" "$canon_json"
  [[ -z "$out" ]] && return 0
  local line
  while IFS= read -r line; do
    case "$line" in
      PRUNE*) echo "    - pruned ${line#PRUNE }" ;;
      KEEP*)  echo "    ! kept ${line#KEEP }" >&2 ;;
    esac
  done <<< "$out"
  return 0
}

# ── E-254 (D-069 §Components 2): legacy workspace pruning ────────────────────
#
# A project upgraded from v3 still has the two retired providers' workspace dirs and shims
# — directories and shims for two providers v4 no longer has. Leaving them is confusing
# (they look current) and deleting them outright is worse: sync did not write everything
# inside them, and a tool that removes a file a person wrote is a tool nobody trusts again.
#
# The rule is the E-220 one, unchanged: remove ONLY what the sync manifest says sync
# generated and the file still matches; print the rest with the exact `rm` the operator can
# run. Never delete a file this command did not generate.
#
# Rollback: REIN_KEEP_LEGACY_WORKSPACES=1 prints every leftover and deletes nothing.
_prune_legacy_workspaces() {
  local mode="${1:-sync}"
  local keep="${REIN_KEEP_LEGACY_WORKSPACES:-0}"
  local -a legacy_dirs=(".gemini" ".agents")
  local -a legacy_files=("GEMINI.md" "AGENTS.md")
  local found=0 d f

  for d in "${legacy_dirs[@]}"; do [[ -d "$d" ]] && found=1; done
  for f in "${legacy_files[@]}"; do [[ -f "$f" ]] && found=1; done
  [[ "$found" -eq 0 ]] && return 0

  if [[ "$keep" == "1" ]]; then
    echo "  Legacy v3 workspaces present (REIN_KEEP_LEGACY_WORKSPACES=1 — nothing removed):"
    for d in "${legacy_dirs[@]}"; do [[ -d "$d" ]] && echo "    legacy leftover (not generated by sync): ${d} — remove with: rm -r ${d}"; done
    for f in "${legacy_files[@]}"; do [[ -f "$f" ]] && echo "    legacy leftover (not generated by sync): ${f} — remove with: rm ${f}"; done
    return 0
  fi

  # Manifest-owned entries first. The canonical set is src/claude + src/shared only: in v4
  # those are the ONLY directories that ship, so a leftover matching one of them byte for
  # byte is provably a copy of something the framework still distributes.
  local -a _canon=()
  local sub
  for sub in shared/skills claude/skills shared/agents claude/agents; do
    [[ -d "${REIN}/${sub}" ]] && _canon+=("${REIN}/${sub}")
  done

  for d in "${legacy_dirs[@]}"; do
    [[ -d "$d" ]] || continue
    for sub in skills agents; do
      [[ -d "${d}/${sub}" ]] && REIN_PRUNE_KNOWN=1 \
        _prune_stale_workspace_dir "${d}/${sub}" ${_canon[@]+"${_canon[@]}"}
    done
    # Sync's own bookkeeping — written by sync, read only by sync. NOT settings.json: v3
    # MERGED into it, keeping the user's own keys, so nothing proves it is ours to delete.
    rm -f "${d}/skills/_SKILLS_INDEX.md" "${d}/agents/_SKILLS_INDEX.md" \
          "${d}/skills/_SYNC_MANIFEST.json" "${d}/agents/_SYNC_MANIFEST.json" 2>/dev/null || true
    find "$d" -type d -empty -delete 2>/dev/null || true
    if [[ -d "$d" ]]; then
      echo "  legacy leftover (not generated by sync): ${d} — remove with: rm -r ${d}"
      find "$d" -type f 2>/dev/null | sed 's/^/      /'
    else
      echo "  pruned legacy workspace: ${d}"
    fi
  done

  # The shims. Removable only when BYTE-IDENTICAL to the template this install shipped —
  # the one piece of evidence that proves nobody edited them. v4 no longer ships either
  # template, so the comparison runs against the last-installed copy when it is still
  # present and otherwise refuses, which is the safe direction.
  for f in "${legacy_files[@]}"; do
    [[ -f "$f" ]] || continue
    if [[ -f "${REIN}/templates/${f}" ]] && cmp -s "$f" "${REIN}/templates/${f}"; then
      rm -f "$f" && echo "  pruned legacy shim: ${f} (unmodified copy of the template)"
    else
      echo "  legacy leftover (not generated by sync): ${f} — remove with: rm ${f}"
    fi
  done
}

# ── E-282 (D-075 §Component 2): path-scoped rules ────────────────────────────
# Rules that matter only for part of the tree ship in src/claude/rules/*.md with a
# `paths:` frontmatter list; Claude Code loads one when a matching file is read. They are
# mirrored to .claude/rules/ through the E-220 manifest (sync-manifest.mjs provision),
# which never overwrites a rule it cannot prove it wrote — teams write their own rules
# there, and a same-named one must survive a sync. Rollback: REIN_NO_PRUNE=1 keeps
# retired rules; deleting .claude/rules/ is safe (the next sync re-provisions it).
_provision_rules() {
  local dst="${1:-.claude/rules}"
  local src="${REIN}/claude/rules"
  [[ -d "$src" ]] || return 0
  command -v node >/dev/null 2>&1 || return 0
  local sm; sm="$(_locate_sync_manifest || true)"
  [[ -n "$sm" ]] || return 0
  local -a extra=()
  [[ "${REIN_NO_PRUNE:-0}" == "1" ]] && extra+=("--no-prune")
  local out line n=0
  out="$(node --no-warnings "$sm" provision "$src" "$dst" ${extra[@]+"${extra[@]}"} 2>/dev/null || true)"
  while IFS= read -r line; do
    case "$line" in
      WROTE*) n=$((n + 1)) ;;
      KEEP*)  echo "  ! rule kept ${line#KEEP }" >&2 ;;
      PRUNE*) echo "  - pruned rule ${line#PRUNE }" ;;
    esac
  done <<< "$out"
  [[ "$n" -gt 0 ]] && echo "  ${dst}/ synced (${n} path-scoped rule(s))"
  return 0
}

# ── E-291 (D-081 r2, D-083 r5-8): `ai gate off|on|status` ──────────────────────
# The operator's escape from the safe-exec POLICY gate, replacing the two environment
# switches (removed in E-291) that a project's settings `env` could set. It writes
# ~/.rein/gate-override.json through src/shared/gate-override.py — the same module the hook
# reads it with — so writer and reader agree on what "active" means. Default 15 minutes,
# hard max 60 (clamped, with a notice). The catastrophic set and the self-disable guard
# still block under an override, and every bypassed call is loud (systemMessage + telemetry).
# Run it in YOUR terminal: the analyzer blocks `ai gate` for every agent role (GATE_SELF_DISABLE).
_gate_py() { rein_locate shared/gate-override.py 2>/dev/null || printf '%s' "${REIN}/shared/gate-override.py"; }

do_gate() {
  local sub="${1:-status}"; shift || true
  local f="${REIN}/gate-override.json" py out rc
  py="$(_gate_py)"
  [[ -f "$py" ]] || { echo "ai gate: ${py} missing — run: bash install-rein.sh" >&2; return 2; }
  case "$sub" in
    off)
      local minutes=15 reason=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --minutes)   minutes="${2:-}"; shift 2 ;;
          --minutes=*) minutes="${1#*=}"; shift ;;
          --reason)    reason="${2:-}"; shift 2 ;;
          --reason=*)  reason="${1#*=}"; shift ;;
          *) echo "ai gate off: unknown argument '$1' (usage: ai gate off [--minutes N] [--reason TEXT])" >&2; return 2 ;;
        esac
      done
      out="$(python3 -I "$py" write "$f" "$minutes" "$reason")" || return 2
      local until m clamped
      IFS=$'\t' read -r until m clamped <<< "$out"
      [[ "$clamped" == "1" ]] && echo "ai gate: --minutes ${minutes} exceeds the 60-minute maximum — clamped to 60." >&2
      echo "⚠ safe-exec policy gate OFF until ${until} (${m} min). Catastrophic commands and gate self-disable still block."
      echo "  Every bypassed call is announced in the session. Restore early: ai gate on"
      ;;
    on)
      rm -f "$f"
      echo "✓ safe-exec gate fully on (no override)."
      ;;
    status)
      out="$(python3 -I "$py" status "$f")"
      case "$out" in
        OK*)      IFS=$'\t' read -r _ until reason <<< "$out"; echo "⚠ override ACTIVE until ${until} (${reason}) — ai gate on to end it" ;;
        IGNORED*) echo "! override file present but IGNORED (${out#IGNORED$'\t'}) — the gate is fully on" ;;
        *)        echo "✓ no override — the safe-exec gate is fully on" ;;
      esac
      ;;
    *) echo "Usage: ai gate off [--minutes N] [--reason TEXT] | on | status" >&2; return 2 ;;
  esac
}

# E-286 (D-078): `ai doctor` line for the hook toolchain pin. Parsed with the same strict
# pattern the hooks use (src/shared/toolchain-pin.sh) — never sourced.
_doctor_toolchain_report() {
  local f="${REIN}/shared/toolchain.sh" line node="" py=""
  local re='^REIN_TC_(NODE|PYTHON3)=(/[A-Za-z0-9._/@+:-]+)$'
  if [[ ! -f "$f" ]]; then
    echo "  ✗ hook toolchain: ${f} missing — run: bash install-rein.sh"
    return 0
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ $re ]] || continue
    [[ "${BASH_REMATCH[1]}" == "NODE" ]] && node="${BASH_REMATCH[2]}" || py="${BASH_REMATCH[2]}"
  done < "$f"
  local p
  for p in "${node:-node (unrecorded)}" "${py:-python3 (unrecorded)}"; do
    if [[ "$p" != /* || ! -x "$p" ]]; then
      echo "  ✗ hook toolchain: ${p} missing — run: bash install-rein.sh"
      return 0
    fi
  done
  echo "  ✓ hook toolchain: node $("$node" --version 2>/dev/null) · python3 $("$py" -I -c 'import platform;print(platform.python_version())' 2>/dev/null)"
}

# The scanner lives in its own function: bash 3.2 mis-parses a heredoc inside $( ) whose
# body carries an unbalanced quote, and fails at an unrelated later line.
_doctor_hook_form_scan() {
  REIN_HOOKS="$(cd "${REIN}/hooks" 2>/dev/null && pwd -P)" python3 - "$1" <<'PY' 2>/dev/null
import json, os, re, sys
want_dir = os.environ.get("REIN_HOOKS", "")
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("unparseable"); sys.exit(0)
bad = []
for ev, lst in (d.get("hooks") or {}).items():
    for e in lst or []:
        for h in e.get("hooks") or []:
            args = [str(a) for a in (h.get("args") or [])]
            text = " ".join([str(h.get("command") or "")] + args)
            m = re.search(r"(\S*\.(?:rein|ai-os)/hooks/[\w.-]+\.sh)", text)  # rename:legacy-fallback
            if not m:
                continue                      # not a Rein hook — the user's own entry
            ok = (h.get("command") == "/bin/bash" and args[:1] == ["-p"] and len(args) >= 2
                  and os.path.isabs(args[1]) and os.path.dirname(args[1]) == want_dir)
            if not ok:
                bad.append(f"{ev}:{os.path.basename(m.group(1))}")
print(" ".join(bad))
PY
}

# E-290 (D-083 r2-4): `ai doctor` lines for the hook form. Since E-290 .claude/settings.json
# is generated (absolute exec-form hook paths) and gitignored, so a project can be missing
# it, still track it, or carry entries from before E-290 that keep the shell-form line
# running; and the git stubs in an existing clone are only refreshed by `ai sync`/`ai init`.
_doctor_hook_form_report() {
  local f=".claude/settings.json"
  if [[ ! -f "$f" ]]; then
    echo "  ✗ .claude/settings.json missing (generated since E-290) — run: ai sync"
  else
    local stale
    stale="$(_doctor_hook_form_scan "$f")"
    if [[ -n "$stale" ]]; then
      echo "  ✗ .claude/settings.json: stale Rein hook entries (not exec-form /bin/bash -p under ${REIN}/hooks): ${stale} — run: ai sync"
    else
      echo "  ✓ .claude/settings.json: Rein hooks in exec form (/bin/bash -p, absolute path)"
    fi
    if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      echo "  ! .claude/settings.json is tracked but machine-specific — run: git rm --cached .claude/settings.json"
    fi
  fi
  local gd stub
  gd="$(git rev-parse --git-path hooks 2>/dev/null)" || return 0
  for stub in pre-commit pre-push post-commit post-merge post-checkout post-rewrite; do
    [[ -f "${gd}/${stub}" ]] && _is_rein_stub "${gd}/${stub}" || continue
    head -1 "${gd}/${stub}" | grep -qx '#!/bin/bash -p' || echo "  ✗ git ${stub} stub predates E-290 (not #!/bin/bash -p) — run: ai sync"
  done
  return 0
}

# E-383 (D-132 r3-4, rein-rename.md §Component 4): what still carries the old name.
#   [LEGACY_HOME_LINK]  ~/.ai-os is the symlink the installer left  (rename:legacy-fallback)
#   [LEGACY_ENV]        an AI_OS_<X> variable in the environment `ai` was started with  (rename:legacy-fallback)
#   [RENAME_PENDING]    a project file `ai sync` rewrites (settings hook paths and env keys,
#                       .ai/.gitattributes, .ai/.gitignore, the merge driver, the state key)
_doctor_rename_report() {
  local n=0 e old new how f
  if [[ -L "${HOME}/.ai-os" ]]; then  # rename:legacy-fallback
    echo "  [LEGACY_HOME_LINK] ~/.ai-os → $(readlink "${HOME}/.ai-os") (remove after 0.5)"; n=$((n+1))  # rename:legacy-fallback
  fi
  for e in "${REIN_LEGACY_ENV_SEEN[@]+"${REIN_LEGACY_ENV_SEEN[@]}"}"; do
    read -r old new how <<< "$e"
    if [[ "$how" == "ignored" ]]; then
      echo "  [LEGACY_ENV] ${old} → ${new} (ignored: ${new} is set) — unset ${old}"
    else
      echo "  [LEGACY_ENV] ${old} → ${new} — rename it in your shell profile"
    fi
    n=$((n+1))
  done
  if [[ -d .ai ]]; then
    f=".claude/settings.json"
    if [[ -f "$f" ]] && grep -qE '\.ai-os/hooks/|"AI_OS_[A-Z_]+"|"AIOS_WORKSPACE"' "$f" 2>/dev/null; then  # rename:legacy-fallback
      echo "  [RENAME_PENDING] ${f} — run: ai sync"; n=$((n+1))
    fi
    while IFS=$'\t' read -r e f how; do
      [[ "$e" == "pending" ]] && { echo "  [RENAME_PENDING] ${f} — run: ai sync"; n=$((n+1)); }
    done < <(_upgrade_records rename --check)
    if git config --get merge.aios-record.driver >/dev/null 2>&1; then  # rename:legacy-fallback
      echo "  [RENAME_PENDING] .git/config merge driver — run: ai sync"; n=$((n+1))
    fi
  fi
  [[ "$n" -eq 0 ]] && echo "  ✓ nothing carries the old name"
  return 0
}

# E-282: `ai doctor` line for .claude/rules/. Missing = a shipped rule is absent; stale = it
# differs from the shipped copy. A rule the user edited reads as stale too — sync keeps it,
# so the message says so instead of implying sync will overwrite it.
_doctor_gate_report() {
  local gp st
  gp="$(_rein_helper shared/gate-probe.sh || true)"
  if [[ -z "$gp" ]]; then
    echo "  ✗ [SAFE_EXEC_BROKEN] shared/gate-probe.sh not found — run: bash install-rein.sh"; return 0
  fi
  # shellcheck source=src/shared/gate-probe.sh
  . "$gp"
  if st="$(rein_gate_probe)"; then
    echo "  ✓ safe-exec gate: ${st}"
  else
    echo "  ✗ safe-exec gate: [SAFE_EXEC_BROKEN] ${st} — run: bash install-rein.sh"
  fi
}

# E-338 (D-104 r4a): detection, not cooperation — the model may forget the commit, doctor
# does not. Neither finding is fatal.
_doctor_comm_report() {
  local cs st
  cs="$(rein_locate shared/comm-status.sh 2>/dev/null || true)"
  [[ -n "$cs" ]] || { echo "  ! comm-status probe not installed — run: bash install-rein.sh"; return 0; }
  # shellcheck source=src/shared/comm-status.sh
  . "$cs"
  st="$(rein_comm_status .)"
  case "$st" in
    IGNORED)       echo "  [COMM_IGNORED] .ai/COMM.md is gitignored — run: ai sync" ;;
    UNCOMMITTED*)  echo "  [COMM_UNCOMMITTED] .ai/COMM.md has uncommitted changes — commit it: git add .ai/COMM.md && git commit --only .ai/COMM.md" ;;
    tracked)       echo "  ✓ tracked and committed" ;;
    absent)        echo "  ✓ no handoff written yet" ;;
    *)             echo "  - not a git work tree" ;;
  esac
}

_doctor_rules_report() {
  local src="${REIN}/claude/rules" f name missing=0 stale=0 total=0
  [[ -d "$src" ]] || return 0
  for f in "$src"/*.md; do
    [[ -f "$f" ]] || continue
    name="$(basename "$f")"; total=$((total + 1))
    if [[ ! -f ".claude/rules/${name}" ]]; then missing=$((missing + 1))
    elif ! cmp -s "$f" ".claude/rules/${name}"; then stale=$((stale + 1)); fi
  done
  if [[ "$missing" -gt 0 ]]; then
    echo "  ✗ .claude/rules: ${missing} of ${total} path-scoped rule(s) missing — run: ai sync"
  elif [[ "$stale" -gt 0 ]]; then
    echo "  ! .claude/rules: ${stale} of ${total} rule(s) differ from the shipped copy — run: ai sync (rules you edited are kept)"
  else
    echo "  ✓ .claude/rules: ${total} path-scoped rule(s) current"
  fi
}

_sync_workspace_dirs() {
  local mode="${1:-sync}"
  # E-217: counts unresolved multi-role skill-name collisions across every workspace.
  SKILL_COLLISIONS=0

  mkdir -p ".claude/agents" ".claude/skills" ".claude/commands"
  # E-212: role-aware. Under an all-Claude Triad (D-054) this pulls in the Architect's
  # skills and agents too, instead of only the Engineer-side src/claude/* dirs.
  _provision_workspace "claude" ".claude" "yes" "yes" "shared/skills" "claude/skills"
  _configure_project_claude_settings ".claude"
  _write_role_settings_overlays ".claude" ".ai"   # E-208: per-role overlays
  _provision_rules ".claude/rules"                 # E-282: path-scoped rules
  if [[ "$mode" == "init" ]]; then
    echo "Created .claude/ (project-scoped agents + skills + settings.json)"
  else
    echo "  .claude/ synced (agents + skills + _SKILLS_INDEX.md + settings.json)"
  fi

  # E-254 (D-069): v4 is Claude-native — one provider, three Claude roles — so there is
  # exactly one workspace to provision, and E-244's "provisioned only when a role is bound
  # to it" machinery has nothing left to decide.
  # A project upgrading from v3 still has the old workspaces; _prune_legacy_workspaces
  # removes the ones sync generated and reports the rest rather than guessing.
  _prune_legacy_workspaces "$mode"
}

ensure_ai_templates() {
  mkdir -p .ai .ai/archive

  local T="${REIN}/templates"

  ensure_file_if_missing "$T/RULES.md"         ".ai/RULES.md"
  ensure_file_if_missing "$T/SEED.md"          ".ai/SEED.md"
  ensure_file_if_missing "$T/DIGEST.md"        ".ai/DIGEST.md"
  ensure_file_if_missing "$T/BRIEF.md"         ".ai/BRIEF.md"
  ensure_file_if_missing "$T/TASKS.md"         ".ai/TASKS.md"
  ensure_file_if_missing "$T/LOG.md"           ".ai/LOG.md"
  ensure_file_if_missing "$T/architect.md.template" ".ai/architect.md"
  ensure_file_if_missing "$T/state.json"          ".ai/state.json"
  ensure_file_if_missing "$T/roles.json"          ".ai/roles.json"   # E-135: Role Configuration Store
  ensure_file_if_missing "$T/providers.json"      ".ai/providers.json" # E-138: Provider Adapter Registry

  # E-270 (D-074 §Components 2): an EXISTING roles.json/providers.json is merged with the
  # template (missing roles added, retired providers and the roles bound to them dropped)
  # BEFORE .claude/ is provisioned below, because the per-role overlays read roles.json.
  local _k _f _d
  UPGRADE_MERGED=()
  while IFS=$'\t' read -r _k _f _d; do
    case "$_k" in
      merged) UPGRADE_MERGED+=("${_f}: ${_d}"); echo "Merged ${_f}: ${_d}" ;;
      error)  echo "  ⚠  ${_f}: ${_d}" ;;
    esac
  done < <(_upgrade_records merge; _upgrade_records rename)

  # .gitignore for sensitive .ai/ files
  if [[ ! -f ".ai/.gitignore" ]]; then
    cp "$T/_gitignore" ".ai/.gitignore"
    echo "Created .ai/.gitignore (review it — sensitive files excluded from git)"
  fi

  # E-233: and the project-root patterns for the artefacts `ai sync` regenerates.
  _ensure_generated_gitignore "."

  # .mcp.json — always regenerate to pick up new servers. Servers the user added and env
  # they set on ours are carried over (E-274; see generate_mcp_json).
  generate_mcp_json "."
  echo "Updated .mcp.json (MCP servers: filesystem + memory + Rein custom servers)"

  # Bootloaders (D-050/E-183): ENGINEER.md/ARCHITECT.md are the canonical rulefiles;
  # CLAUDE.md is a thin @import shim so Claude Code's auto-load
  # still bootstraps the right persona. Copy all four so skill invocation stays current.
  cp -f "$T/ENGINEER.md"  "ENGINEER.md"
  cp -f "$T/ARCHITECT.md" "ARCHITECT.md"
  cp -f "$T/CLAUDE.md"    "CLAUDE.md"
  echo "Updated ENGINEER.md/ARCHITECT.md (canonical bootloaders) + CLAUDE.md (shim)"

  # .claude/ — the project-scoped agent dir (v3.0 W3-T3: shared helper).
  _sync_workspace_dirs init

  # .github/copilot-instructions.md — read automatically by GitHub Copilot Chat
  local C="${REIN}/copilot"
  if [[ -f "${C}/copilot-instructions.md" && ! -f ".github/copilot-instructions.md" ]]; then
    mkdir -p .github
    cp "${C}/copilot-instructions.md" ".github/copilot-instructions.md"
    echo "Created .github/copilot-instructions.md (fill in project-specific Copilot context)"
  fi
}

migrate_legacy_ai_if_present() {
  local legacy=0
  for f in MASTER.md HANDOFF.md OWNERSHIP.md RUNBOOK.md 00_context.md 01_repo_state.md 05_input.md 50_acceptance.md 40_implementation_log.md; do
    [[ -f ".ai/$f" ]] && legacy=1 && break
  done
  if [[ $legacy -eq 1 ]]; then
    mkdir -p .ai/legacy
    for f in MASTER.md HANDOFF.md OWNERSHIP.md RUNBOOK.md 00_context.md 01_repo_state.md 05_input.md 50_acceptance.md 40_implementation_log.md; do
      [[ -f ".ai/$f" ]] && mv ".ai/$f" ".ai/legacy/$f"
    done
    { echo ""; echo "## Legacy migration ($(date '+%Y-%m-%d'))"; echo "- Moved legacy .ai files to .ai/legacy/"; echo "- Review and copy relevant content into BRIEF/TASKS/REPO."; } >> .ai/MIGRATION.md
    echo "Legacy .ai files moved to .ai/legacy/ — review MIGRATION.md"
  fi
}


# Writes .claude/settings.json in a project directory with project-scoped hooks,
# agent teams env var and registry-driven MCP tool permissions.
# $1: target dir (e.g. ".claude")

# ── E-208 (D-054, role-abstraction.md §Components 3): per-role settings overlay ──
# Generates .claude/settings.<role>.json for every role that .ai/roles.json maps to
# the `claude` provider. `ai pane <role>` selects it via `claude --settings <file>`.
#
# The overlay carries ENV ONLY — deliberately NO SessionStart hook. Claude Code
# MERGES hook arrays rather than replacing them, so registering a second
# `session-start.sh <role>` here would mint TWO role tokens for one session id with
# undefined ordering (D-054 §Alternatives, option 3). The launch-time role reaches
# the hook through REIN_PANE_ROLE instead, which has a single authoritative value.
_write_role_settings_overlays() {
  local target_dir="${1:-.claude}"
  local ai_dir="${2:-.ai}"
  [[ -d "$ai_dir" ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$target_dir" "$ai_dir" <<'PY'
import json, os, sys

target_dir, ai_dir = sys.argv[1], sys.argv[2]

def load(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f) or default
    except Exception:
        return default

import re
# .ai/roles.json is ARCHITECT-WRITABLE, so its keys are untrusted input to a path
# join. A key containing parent-directory segments would write outside .claude/
# (E-208 audit). Constrain role names to a safe charset before os.path.join sees them.
ROLE_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")

roles = load(os.path.join(ai_dir, "roles.json"), {}).get("roles", {})
for role, cfg in roles.items():
    if not ROLE_RE.match(str(role)):
        print(f"  ! skipping role '{role}' — invalid role name (must match [a-z][a-z0-9_-]*)")
        continue
    if not isinstance(cfg, dict) or cfg.get("provider") != "claude":
        continue
    # E-255: a headless role runs as the Engineer's delegate and inherits its overlay;
    # it gets no pane, so an overlay of its own would be a launch surface nobody uses.
    if cfg.get("headless") is True:
        continue
    path = os.path.join(target_dir, f"settings.{role}.json")
    data = load(path, {})
    env = data.setdefault("env", {})
    # Authoritative (not setdefault) so a stale/forged role can never linger.
    env["REIN_CALLER_ROLE"] = role
    env.pop("AI_OS_CALLER_ROLE", None)  # rename:legacy-fallback (E-383: the pre-rename key)
    # NEVER register hooks here — see the comment above _write_role_settings_overlays.
    data.pop("hooks", None)

    # E-213 (§Components 3): the Architect's own tool surface. --settings MERGES with
    # the base file, so these are ADDITIVE to the Engineer allow-list; they are the
    # tools an Architect needs to plan and hand off without a permission prompt.
    #
    # E-216 (D-055 R1): deny rules are now ALSO applied, for the filesystem-mutating
    # MCP tools. They remain a SECOND layer, not the mechanism — the pre-tool-use hook
    # (E-208, widened here) and the Git Lane (E-214) are what is enforced, because a
    # settings file is config the session could in principle be started without. The
    # hook cannot see a pre-approved MCP call's arguments reliably, which is exactly
    # why the MCP channel needs the deny list rather than a path check.
    if role == "architect":
        arch_allow = [
            "Bash(ai add-task *)",
            "mcp__task-synchronizer-mcp__add_topic_seed",
            "mcp__task-synchronizer-mcp__add_cluster_page",
            "mcp__context-guardian-mcp__check_role_access",
            # D-099 (E-321): the Architect wakes the Engineer with SendMessage.
            "ListAgents",
            "SendMessage",
        ]
        # Every MCP tool that can mutate the filesystem. The Architect writes through
        # Write/Edit under .ai//plans/ (path-gated by the hook); these bypass that gate
        # entirely, so they are denied outright rather than scoped.
        arch_deny = [
            "mcp__filesystem__write_file",
            "mcp__filesystem__edit_file",
            "mcp__filesystem__move_file",
            "mcp__filesystem__create_directory",
            "mcp__patch-mcp__patch_file",
            "mcp__propose-patch-mcp__propose_patch",
            "mcp__propose-patch-mcp__confirm_patch",
            # E-216 audit: the deny list matches TOOL NAMES, so a router forwarding to the
            # same server under another name walked straight past it. E-277 (D-075) retired
            # that router; a future forwarding server must be denied here the same way.
            # The MCP analogue of the "interactive editors" residual: these drive any
            # GUI editor to write any file. E-279 (D-075) retired that server, but its
            # mirror copy stays in ~/.rein/mcp until `ai clean` runs, and a hand-added or
            # user-scope entry could still launch it — so the deny stays; it costs nothing.
            "mcp__computer-use-mcp__type_text",
            "mcp__computer-use-mcp__key_press",
        ]
        ov_perms = data.setdefault("permissions", {})
        ov_allow = ov_perms.get("allow", [])
        for rule in arch_allow:
            if rule not in ov_allow:
                ov_allow.append(rule)
        ov_perms["allow"] = ov_allow
        ov_deny = ov_perms.get("deny", [])
        for rule in arch_deny:
            if rule not in ov_deny:
                ov_deny.append(rule)
        ov_perms["deny"] = ov_deny
    os.makedirs(target_dir, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    _kind = "env + allow/deny rules" if role == "architect" else "env only"
    print(f"  .claude/settings.{role}.json written (role overlay, {_kind})")
PY
}

_configure_project_claude_settings() {
  local TARGET_DIR="${1:-.claude}"
  local REGISTRY="${REIN}/config/registry.json"
  mkdir -p "$TARGET_DIR"
  # E-62: pass resolved REIN_WORKSPACE through to the python heredoc via env
  # so the framework clone path can be propagated into project settings.json
  # without changing the heredoc's positional-arg contract.
  local REIN_WORKSPACE_VALUE
  REIN_WORKSPACE_VALUE="$(_resolve_rein_workspace)"
  REIN_WORKSPACE="${REIN_WORKSPACE_VALUE}" python3 - "$TARGET_DIR" "$REGISTRY" "${REIN}/config/legacy-artefacts.json" <<'PY'
import json, os, sys

target_dir = sys.argv[1]
registry_path = sys.argv[2]
legacy_path = sys.argv[3] if len(sys.argv) > 3 else ""
path = os.path.join(target_dir, "settings.json")

data = {}
if os.path.exists(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f) or {}
    except Exception:
        pass

# Enable agent teams
env = data.setdefault("env", {})
env["CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS"] = "1"
# E-50: Restore native terminal scrollback for tmux users by disabling
# Claude Code's TUI alternate-screen mode. Per claude-obsidian-optimizations
# §"Terminal Emancipation" + §Rollback: revert this if specific OSes show
# rendering bugs.
env.setdefault("CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN", "1")
# E-62: Propagate REIN_WORKSPACE so Claude (and tools spawned by it) can
# route framework-level tasks to the canonical @vimurai/rein clone regardless
# of which project tree the user is currently working in. Empty string
# means install-rein.sh hasn't run yet — leave the key absent so a stale
# value from an earlier install doesn't linger.
_rein_ws = os.environ.get("REIN_WORKSPACE", "")
if _rein_ws:
    env.setdefault("REIN_WORKSPACE", _rein_ws)

# E-127 (sovereignty-hardening.md §Security): bootloader-inject the Triad role so
# safe-exec trusts the ENVIRONMENT over the agent-self-reported caller_role
# (anti-impersonation). This is Claude's project → engineer. Set authoritatively
# (not setdefault) so a stale/forged value can never linger.
env["REIN_CALLER_ROLE"] = "engineer"
# E-383: the pre-rename keys this writer once set; the new ones above replace them.
for _old in ("AI_OS_CALLER_ROLE", "AIOS_WORKSPACE"):  # rename:legacy-fallback
    env.pop(_old, None)

# Permissions: registry-driven MCP tools.
# E-213/E-254: the legacy v3 vendor-CLI shell grants are DROPPED and actively stripped from
# any settings.json carried over from v3. The CLI they granted was retired
# (D-050) and the A2A bridge is provider-aware as of E-210, so the base Engineer
# settings no longer need a vendor-specific shell grant. Existing entries are pruned
# on sync so the rule does not linger in projects that already have it.
GH_READ_GRANTS = ["Bash(gh pr view *)", "Bash(gh pr list *)", "Bash(gh pr status *)", "Bash(gh pr checks *)", "Bash(gh pr diff *)", "Bash(gh issue view *)", "Bash(gh issue list *)", "Bash(gh auth status)"]  # E-279: see the gh block below
GH_ASK_RULES = ["Bash(gh * --jq*)", "Bash(gh * -q*)", "Bash(gh * --template*)", "Bash(gh * -t*)"]  # E-279: --jq/--template read $ENV
perms = data.setdefault("permissions", {})
allow = perms.get("allow", [])
new_allow = []
for entry in allow:
    if entry in ("Bash(gemini *)", "Bash(gemini -p *)"):
        print(f"Removed legacy grant: {entry} (E-213)")
        continue
    new_allow.append(entry)
# E-273 (D-074 §Components 5): an allow for a server Rein once shipped and has since
# retired (in the legacy registry's registry_history, absent from registry.json) is dead
# weight that also keeps a retired tool name pre-approved. Remove those. A server name
# that was NEVER in any registry version is the user's own and its allows are kept;
# without the legacy registry nothing is removed. settings.local.json is never touched.
try:
    with open(legacy_path) as lf:
        _history = {n for n in json.load(lf).get("registry_history", []) if isinstance(n, str)}
    with open(registry_path) as rf:
        _live = set(json.load(rf).get("mcp_servers", {}))
    _live |= {"filesystem", "memory"}          # always generated into .mcp.json
    _retired = _history - _live
    # A retired name the project's .mcp.json still configures is the user's own server
    # now (critic_security, E-273): its allows stay.
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(target_dir)), ".mcp.json")) as mf:
            _retired -= set((json.load(mf).get("mcpServers") or {}).keys())
    except Exception:
        pass
except Exception:
    _retired = set()
def _allow_server(entry):
    if not isinstance(entry, str) or not entry.startswith("mcp__"):
        return None
    rest = entry[len("mcp__"):]
    return rest.split("__", 1)[0] if rest else None
_kept = []
for entry in new_allow:
    srv = _allow_server(entry)
    if srv and srv in _retired:
        print(f"Removed allow for retired server: {entry} (E-273)")
        continue
    _kept.append(entry)
new_allow = _kept
if os.path.exists(registry_path):
    with open(registry_path) as rf:
        reg = json.load(rf)
    for srv, info in reg.get("mcp_servers", {}).items():
        if "path" not in info:
            continue
        for tool in info.get("allowed-tools", []):
            if tool == "*":
                continue
            perm = f"mcp__{srv}__{tool}"
            if perm not in new_allow:
                new_allow.append(perm)
                print(f"Added MCP permission: {perm}")
# E-279 (D-075): the GitHub MCP bridge is retired; `gh` runs under Bash with grants for
# the READ verbs the bridge exposed, and nothing else. Write verbs (merge, close, delete,
# create, comment, edit, review, checkout) stay on the permission prompt: issue and PR
# bodies are untrusted (T-PI-001), and an unprompted write verb is how injected text
# would turn into an irreversible action (30_SECURITY.md: no destructive command without
# explicit human approval; THREAT_MODEL T-GH-001). The wildcards are removed if present,
# and so are the verb-less Bash(gh pr *)/Bash(gh issue *) a first cut of E-279 granted.
# `gh auth status` is granted EXACTLY: with a trailing * it would also match
# `gh auth status --show-token` / `-t`, which prints the token (critic_security, E-279).
for wide in ("Bash(gh *)", "Bash(gh:*)", "Bash(gh pr *)", "Bash(gh pr:*)",
             "Bash(gh issue *)", "Bash(gh issue:*)", "Bash(gh auth status *)", "Bash(gh auth status:*)"):
    if wide in new_allow:
        new_allow.remove(wide)
        print(f"Removed over-broad gh grant: {wide} (E-279 — read verbs only)")
for gh_rule in GH_READ_GRANTS:
    if gh_rule not in new_allow:
        new_allow.append(gh_rule)
        print(f"Added read-only gh grant: {gh_rule}")
perms["allow"] = new_allow
# E-279: gh evaluates --jq (-q) with gojq and --template (-t) with Go templates, and both
# can read the environment: `gh pr list --json number --jq '$ENV.GH_TOKEN'` printed a
# probe variable here. The read grants above would run that without a prompt, so any gh
# command carrying those flags is moved back to the prompt. Ask outranks allow in Claude
# Code's permission order, so this narrows the grants rather than blocking the command.
ask = perms.setdefault("ask", [])
for rule in GH_ASK_RULES:
    if rule not in ask:
        ask.append(rule)
        print(f"Added ask rule: {rule} (E-279 — gh jq/template can read $ENV)")

# Hooks
hooks = data.setdefault("hooks", {})

# E-290 (D-081 r1, D-083 r1-3; sovereignty-hardening.md §Hook Toolchain Pinning C5):
# every Rein hook is the documented EXEC form — no shell at all. A shell-form line runs
# through `sh -c`, and macOS /bin/sh (bash in sh mode) honours SHELLOPTS/PS4 from a
# project's settings `env` BEFORE `/bin/bash -p` starts (probed). `args` carries the
# install-time ABSOLUTE path, so `$HOME` is gone from the hook lines; that makes this file
# machine-specific, so it is gitignored (E-233 mechanism) and regenerated here.
# Before writing, EVERY Rein-owned entry for the six hooks is removed in ANY older form
# (shell form, stale path) — appending beside an old entry would leave the vulnerable line
# running. User entries are never touched. History kept from the entries this replaces:
#   E-125/E-208 pre-tool-use is the fail-closed gate on Bash + the write tools;
#   E-126/E-129/E-294 session-start injects the context cache and mints the role token; the
#     role comes from the launch-record walk (D-087), never from an argument or the env. It
#     fires on clear and compact too: `/clear` issues a NEW session id in the same process
#     (measured 2026-10-04), which needs its own token or the session falls into the union;
#   E-105 post-tool-use matcher ".*" (universal telemetry; the AQG self-gates);
#   E-284 permission-denied books REJECTED rows for denied built-ins.
import re as _re
_HOOKS_DIR = os.path.realpath(os.path.join(os.path.expanduser("~"), ".rein", "hooks"))
_SPECS = [  # (event, matcher, script, extra args)
    ("Stop", ".*", "stop-hook.sh", []),
    ("PreToolUse", "Bash|Write|Edit|MultiEdit|NotebookEdit", "pre-tool-use.sh", []),
    ("SessionStart", "startup|resume|clear|compact", "session-start.sh", []),
    ("PostToolUse", "Write|Edit", "post-tool-log.sh", []),
    ("PostToolUse", ".*", "post-tool-use.sh", []),
    ("PermissionDenied", ".*", "permission-denied.sh", []),
]
def _is_rein_hook(h, script):
    text = " ".join([str(h.get("command") or "")] + [str(x) for x in (h.get("args") or [])])
    # Same reach as the `ai doctor` scanner (critic_security P2): a quoted path or one
    # followed by a separator is still ours — otherwise doctor reports a stale entry that
    # sync never removes.
    # E-383: an entry written before the rename points under ~/.ai-os — ours too, so it is  (rename:legacy-fallback)
    # replaced rather than left beside the new one.
    return _re.search(r"\.(?:rein|ai-os)/hooks/" + _re.escape(script) + r"(?=[\s\"';|&)]|$)", text) is not None  # rename:legacy-fallback
for _event, _matcher, _script, _extra in _SPECS:
    _want = {"type": "command", "command": "/bin/bash",
             "args": ["-p", os.path.join(_HOOKS_DIR, _script)] + _extra, "timeout": 30}
    _lst = hooks.setdefault(_event, [])
    _removed = 0
    for _e in _lst:
        _before = len(_e.get("hooks", []))
        _e["hooks"] = [h for h in _e.get("hooks", []) if not _is_rein_hook(h, _script)]
        _removed += _before - len(_e["hooks"])
    _lst[:] = [e for e in _lst if e.get("hooks")]
    _lst.append({"matcher": _matcher, "hooks": [_want]})

with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(f"{path} updated ✓")
PY
}


install_global() {
  _parse_role_flags "$@"   # E-135: --architect/--engineer overrides (validated; bad format aborts)
  echo "Preparing Rein v${VERSION} installation..."

  # Copilot CLI
  mkdir -p "${HOME}/.config/github-copilot"
  if [[ -f "${REIN}/copilot/COPILOT.md" ]]; then
    cp -f "${REIN}/copilot/COPILOT.md" "${HOME}/.config/github-copilot/COPILOT.md"
  fi
  echo "✓ Installed Copilot config → ~/.config/github-copilot"

  if command -v gh &>/dev/null && gh extension list 2>/dev/null | grep -q "github/gh-copilot"; then
    gh copilot config set telemetry false 2>/dev/null || true
    echo "  gh copilot: configured ✓ (telemetry off)"
  else
    echo "  gh copilot: not installed — Recommended: gh extension install github/gh-copilot"
  fi

  # Hooks
  chmod +x "${REIN}/hooks/"*.sh 2>/dev/null || true
  echo "✓ Hooks ready → ${REIN}/hooks"

  # E-129 (sovereignty-hardening.md §Security): provision the per-machine HMAC key
  # + runtime dirs for the tamper-resistant role token. getMachineKey() also
  # lazily creates these, so this is just first-run priming with correct perms.
  mkdir -p "${HOME}/.rein/secrets" "${HOME}/.rein/run" 2>/dev/null || true
  chmod 700 "${HOME}/.rein/secrets" "${HOME}/.rein/run" 2>/dev/null || true
  if command -v node >/dev/null 2>&1 && [[ ! -f "${HOME}/.rein/secrets/role-hmac.key" ]]; then
    node -e 'const c=require("node:crypto"),fs=require("fs"),p=process.env.HOME+"/.rein/secrets/role-hmac.key"; try{fs.writeFileSync(p,c.randomBytes(32).toString("hex"),{mode:0o600})}catch(e){}' 2>/dev/null || true
  fi
  echo "✓ Role-token key ready → ~/.rein/secrets (E-129)"

  # MCP servers
  if [[ -d "${REIN}/mcp" ]]; then
    echo "✓ MCP servers available → ${REIN}/mcp"
  fi

  # Install MCP server npm dependencies
  if command -v node &>/dev/null; then
    echo "Setting up MCP server dependencies..."
    local _ms_rc=0
    do_mcp_setup 2>/dev/null || _ms_rc=$?
    # E-305: a gate dependency off its pin is a REFUSAL (the installer stops), not a warning.
    [[ "$_ms_rc" -eq 3 ]] && return 3
    [[ "$_ms_rc" -ne 0 ]] && echo "  ⚠  MCP setup: some servers failed — run: ai mcp-setup"
  else
    echo "  ⚠  Node.js not found — MCP setup skipped. Install Node.js then run: ai mcp-setup"
  fi

  # E-135: persist explicit role overrides to .ai/roles.json when run inside a project.
  if [[ -n "$ROLE_ARCHITECT" || -n "$ROLE_ENGINEER" ]]; then
    if [[ -d ".ai" ]]; then
      _write_roles_json
    else
      echo "  ⚠  Role flags given but no .ai/ here — run 'ai init' first, then re-run install with the flags."
    fi
  fi

  # E-318 (D-097 r2, D-098): an outdated copy is replaced in place in ~/.claude and every
  # registered account — consent-free, so a non-TTY install leaves none of them outdated. The
  # offer below then meets PRESENT or ABSENT only. E-346: it now returns 1/2 for sync's step
  # counter; a failure has already printed its ✗ line and must not abort the install.
  _classifier_refresh_all || :
  # E-293 (D-083 r5(iii)): offer the auto-mode classifier backstop — interactive only.
  _classifier_offer

  echo ""
  echo "✓ Rein global installation complete → ${REIN}"
  echo "  Run 'ai init' inside any project to scaffold .ai/ and .claude/."
}

# ── E-293 (D-083 r5(iii), D-080): the auto-mode classifier backstop ─────────────────────
# ONE prose rule in autoMode.hard_deny of the OPERATOR's ~/.claude/settings.json — the one
# layer a project cannot reach (a project's autoMode is ignored), so a second, independently
# configured gate in front of the safe-exec gate. All reading/writing is
# src/shared/classifier-backstop.py; `ai install` OFFERS it (y/N, default N) and never writes
# without a TTY or under CI; `ai doctor` reports it.
_cb_py() { rein_locate shared/classifier-backstop.py 2>/dev/null || printf '%s' "${REIN}/shared/classifier-backstop.py"; }
_cb_settings() { printf '%s' "${HOME}/.claude/settings.json"; }

_classifier_offer() {
  local py; py="$(_cb_py)"
  [[ -f "$py" ]] && command -v python3 >/dev/null 2>&1 || return 0
  if [[ -n "${CI:-}" || -n "${REIN_CI:-}" || ! -t 0 ]]; then
    echo "  ○ classifier backstop: not offered (no terminal) — run 'ai install' in a terminal to add it"
    return 0
  fi
  local out rc
  out="$(python3 -I "$py" plan "$(_cb_settings)" 2>&1)" && rc=0 || rc=$?   # set -e: capture, never abort
  case "$rc" in
    1) echo "✓ Classifier backstop present (autoMode.hard_deny in ~/.claude/settings.json)"; return 0 ;;
    5) echo "  ○ classifier backstop: ~/.claude does not exist yet — run Claude Code once, then 'ai install'"; return 0 ;;
    3) echo "  ✗ classifier backstop: ~/.claude/settings.json left untouched — ${out#UNPARSABLE$'\t'}"; return 0 ;;
    0) ;;
    *) echo "  ⚠  classifier backstop: could not plan the change (rc ${rc}) — nothing written"; return 0 ;;
  esac
  echo ""
  echo "Classifier backstop (E-293): add ONE rule to autoMode.hard_deny in ~/.claude/settings.json."
  echo "  Auto mode's classifier then refuses gate tampering even if the safe-exec gate were"
  echo "  bypassed; no project can override it. Resulting hard_deny list:"
  printf '%s\n' "$out" | sed -n '2,$p' | sed 's/^/    /'
  [[ "$(printf '%s\n' "$out" | sed -n '1p')" == $'CHANGE\t1' ]] \
    && echo "  Note: the file is rewritten in Claude Code's own JSON format (formatting normalised)."
  local reply=""
  printf 'Add the classifier backstop? [y/N] '
  IFS= read -r reply || reply=""
  case "$reply" in
    y|Y|yes|YES|Yes)
      out="$(python3 -I "$py" apply "$(_cb_settings)" 2>&1)" && rc=0 || rc=$?   # set -e: capture, never abort
      case "$rc" in
        0) echo "✓ Classifier backstop added. Check its wording in YOUR terminal: claude auto-mode critique" ;;
        1) echo "✓ Classifier backstop already present" ;;
        *) echo "  ✗ classifier backstop not written: ${out#*$'\t'}" ;;
      esac ;;
    *) echo "  ○ classifier backstop: skipped (ai doctor will remind you)" ;;
  esac
}

_classifier_report() {
  _classifier_report_one "$(_cb_settings)" ""
  # E-314 (D-095, accounts.md §4): every registered account's directory carries its own copy of
  # settings.json, so a rule missing there is reported like one missing in ~/.claude.
  declare -F _account_rows >/dev/null || return 0
  local name dir _rest
  while IFS=$'\t' read -r name dir _rest; do
    [[ -n "$name" ]] && _classifier_report_one "${dir}/settings.json" "$name"
  done <<< "$(_account_rows)"
  return 0
}

# E-318 (D-097, accounts.md §4 "never goes stale"): refresh the Rein-owned backstop entry in
# ~/.claude AND every registered account's settings.json — REPLACE ONLY. An OUTDATED labelled
# copy is replaced in place (the label is the operator's earlier consent, E-306); ABSENT is
# reported, never added (adding stays the y/N in `ai install`); unparsable is reported and left.
# One line per directory changed or needing attention; a current copy prints nothing.
#
# E-346 (D-109 r3): the worst outcome over every settings file — 1 if any refresh FAILED (an
# ERROR, or output outside the helper's protocol), else 2 when the helper or python3 is
# missing (skipped), else 0. Every file is still visited. Before, an ERROR printed ✗ on
# stdout and the step counted ok.
_classifier_refresh_all() {
  local rc=0 one name dir _rest
  _classifier_refresh_one "$(_cb_settings)" "" && one=0 || one=$?
  rc="$one"
  declare -F _account_rows >/dev/null || return "$rc"
  while IFS=$'\t' read -r name dir _rest; do
    [[ -n "$name" ]] || continue
    _classifier_refresh_one "${dir}/settings.json" "$name" && one=0 || one=$?
    [[ "$one" -eq 1 || ( "$one" -eq 2 && "$rc" -eq 0 ) ]] && rc="$one"
  done <<< "$(_account_rows)"
  return "$rc"
}

_classifier_refresh_one() {  # <settings.json> <account name, "" = default>
  local py out rc settings="$1" lbl="classifier backstop" shown="~/.claude/settings.json"
  if [[ -n "$2" ]]; then
    lbl="classifier backstop [account $2]"; shown="${settings#"$HOME"/}"; [[ "$shown" != "$settings" ]] && shown="~/${shown}"
  fi
  py="$(_cb_py)"
  [[ -f "$py" ]] && command -v python3 >/dev/null 2>&1 || return 2
  out="$(python3 -I "$py" refresh "$settings" 2>&1)" && rc=0 || rc=$?   # set -e: capture, never abort
  case "$out" in
    APPLIED*)  echo "  ✓ ${lbl}: outdated copy in ${shown} replaced with the current rule" ;;
    ABSENT*)   if [[ -n "$2" ]]; then
                 echo "  ○ ${lbl}: not configured in ${shown} — run: ai account sync $2 (copies ~/.claude/settings.json)"
               else
                 echo "  ○ ${lbl}: not configured — ai install offers it"
               fi ;;
    REFUSED*)  echo "  ✗ ${lbl}: ${shown} left untouched — ${out#REFUSED$'\t'}" ;;
    CHANGED*)  echo "  ⚠ ${lbl}: ${shown} changed while it was being refreshed — nothing written; re-run" ;;
    ERROR*)    echo "  ✗ ${lbl}: could not refresh ${shown} (${out#ERROR$'\t'})" >&2; return 1 ;;
    NOCHANGE*|NOFILE*|NODIR*) ;;   # nothing to say
    *)         echo "  ✗ ${lbl}: unexpected helper output for ${shown} (exit ${rc}): $(printf '%s' "$out" | tail -1 | cut -c1-200)" >&2
               return 1 ;;
  esac
  return 0
}

_classifier_report_one() {  # <settings.json> <account name, "" = default>
  local py out rc settings="$1" lbl="classifier backstop" shown="~/.claude/settings.json"
  if [[ -n "$2" ]]; then
    lbl="classifier backstop [account $2]"; shown="${settings#"$HOME"/}"; [[ "$shown" != "$settings" ]] && shown="~/${shown}"
  fi
  py="$(_cb_py)"
  if [[ ! -f "$py" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "  ⚠ ${lbl}: cannot check (helper or python3 missing — run: bash install-rein.sh)"
    return 0
  fi
  out="$(python3 -I "$py" status "$settings" 2>&1)" && rc=0 || rc=$?   # set -e: capture, never abort
  case "$(printf '%s\n' "$out" | sed -n '1p')" in
    PRESENT)   echo "  ✓ ${lbl}: present" ;;
    OUTDATED*) _cb_old="${out%%$'\n'*}"; _cb_old="${_cb_old#OUTDATED}"; _cb_old="${_cb_old#$'\t'}"
               echo "  ○ ${lbl}: outdated${_cb_old:+ (${_cb_old})} wording — ai install offers the current rule" ;;
    UNPARSABLE*) echo "  ✗ ${lbl}: ${shown} is not valid JSON — Claude Code ignores it, so NO autoMode rules are active (${out#UNPARSABLE$'\t'})" ;;
    ERROR*)    echo "  ✗ ${lbl}: could not check ${shown} (${out#ERROR$'\t'})" ;;
    *)         if [[ -n "$2" ]]; then
                 echo "  ○ ${lbl}: not configured in ${shown} — run: ai account sync $2 (copies ~/.claude/settings.json)"
               else
                 echo "  ○ ${lbl}: not configured — ai install offers it"
               fi ;;
  esac
  printf '%s\n' "$out" | sed -n "s/^WARN\t/  ⚠ ${lbl}: /p"
  printf '%s\n' "$out" | sed -n 's/^INFO\t/  ⓘ /p'   # D-086: $defaults off, effective default mode
  return 0
}

# ── E-294 (D-087, sovereignty-hardening.md Component 8h): launch records and role tokens ──
# Prunes ONLY records and tokens whose process is gone (or whose start time no longer
# matches — a reused pid); a live or undisciplined record is never removed, since removing
# it could only loosen a session. Reports this pane's live record and the pre-E-294 (v1)
# tokens, which never verify: those sessions run in the union until relaunched.
_launch_record_prune() {  # quiet: prints the module's JSON counts or nothing
  local lr; lr="$(rein_locate shared/launch-record.py || true)"
  [[ -n "$lr" ]] && command -v python3 >/dev/null 2>&1 || return 0
  python3 -I "$lr" prune 2>/dev/null || true
}

# E-305: the gate path's pinned dependencies, and whether the mirror holds exactly them.
_gate_pins_report() {
  local gp out rc=0
  gp="$(rein_locate shared/gate-pins.mjs 2>/dev/null || true)"
  [[ -n "$gp" ]] && command -v node >/dev/null 2>&1 || { echo "  ⚠ gate dependencies: cannot check (gate-pins.mjs or node missing)"; return 0; }
  out="$(node --no-warnings "$gp" check "${REIN}/mcp" 2>&1)" || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    echo "  ✓ gate dependencies pinned: $(node --no-warnings "$gp" list "${REIN}/mcp" 2>/dev/null | tr '\n' ' ')"
  else
    printf '%s\n' "$out" | sed 's/^/  ✗ /'
  fi
  return 0
}

# E-304 (D-089 r2): where the mirror came from, and whether two workspace sources disagree.
_install_report() {
  local stamp="${REIN}/config/install-stamp.json" ws_file=""
  [[ -f "${REIN}/config/rein-workspace.txt" ]] && ws_file="$(head -1 "${REIN}/config/rein-workspace.txt" 2>/dev/null)"
  if [[ -n "${REIN_WORKSPACE:-}" && -n "$ws_file" && "${REIN_WORKSPACE%/}" != "${ws_file%/}" ]]; then
    echo "  ⚠ workspace: exported REIN_WORKSPACE=${REIN_WORKSPACE} disagrees with the installed record ${ws_file} — the record wins (E-304); remove the export from your shell profile"
  fi
  if [[ -f "$stamp" ]] && command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
src, sha = d.get("source", "?"), (d.get("commit") or "?")[:7]
if d.get("dirty"):
    print("  ⚠ install: installed from an UNCOMMITTED tree (--allow-dirty) — %s @ %s; reinstall from a clean commit" % (src, sha))
else:
    print("  ✓ install: %s @ %s (clean tree)" % (src, sha))
' "$stamp" 2>/dev/null || echo "  ⚠ install: install-stamp.json unreadable"
  else
    echo "  ○ install: no install stamp (installed before E-304) — run: bash install-rein.sh"
  fi
  return 0
}

_launch_record_report() {
  local lr out
  lr="$(rein_locate shared/launch-record.py || true)"
  if [[ -z "$lr" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "  ⚠ launch records: cannot check (launch-record.py or python3 missing — run: bash install-rein.sh)"
    return 0
  fi
  out="$(python3 -I "$lr" status 2>/dev/null)" || out=""
  [[ -z "$out" ]] && { echo "  ⚠ launch records: status unavailable"; return 0; }
  printf '%s' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
live = d.get("live") or []
w = d.get("walk") or {}
if live:
    for r in live:
        print("  ✓ launch record: pid %s → %s (%s)" % (r["pid"], r["role"], r["project"]))
elif w.get("result") == "role":
    print("  ⓘ launch record: none on this process chain — a session here runs as %s (%s launch)" % (w.get("role"), w.get("launch")))
if w.get("result") == "union":
    print("  ✗ launch record: %s — sessions on this chain run in the union" % w.get("why"))
if d.get("v1_tokens"):
    print("  ⓘ role tokens: %d pre-E-294 (v1) token(s) on disk; v1 never verifies, so a pane still running from before the install is in the union until relaunched (ai pane <role>)" % d["v1_tokens"])
stale = (d.get("records") or 0) + (d.get("tokens") or 0)
if stale:
    print("  ○ launch records: %d stale record(s)/token(s) whose process is gone — pruned now" % stale)
' 2>/dev/null || echo "  ⚠ launch records: status unreadable"
  _launch_record_prune >/dev/null
  return 0
}

# Marker emitted in every Rein execution stub. Anything containing this line
# is recognised as a current-format stub by _is_rein_stub / the do_sync
# upgrader. Legacy copies of pre-commit.sh do NOT carry it.
REIN_STUB_MARKER="# Rein Execution Stub (E-41)"
# E-383: stubs written before the rename carry the old marker; they count as ours so the
# refresh rewrites them instead of chaining them as a user hook. Removed in 0.5.
REIN_LEGACY_STUB_MARKER="# AI-OS Execution Stub (E-41)"  # rename:legacy-fallback

# Returns 0 when $1 is a Rein execution stub (current format), 1 otherwise.
# Callers that want to distinguish "legacy Rein copy" from "third-party hook"
# should also test for the canonical "Rein Gate 2" / "TASKS.md Auto-Sync"
# headers that appear inside the original copied scripts.
_is_rein_stub() {
  local f="$1"
  [[ -f "$f" ]] && grep -qF -e "$REIN_STUB_MARKER" -e "$REIN_LEGACY_STUB_MARKER" "$f" 2>/dev/null
}

# Writes a pre-commit execution stub. Fails closed: if the canonical hook is
# absent at commit time the stub aborts the commit (Gate 2 must always run).
# E-290 (D-081 r1, D-083 r4): every stub runs PRIVILEGED bash by absolute path — the
# shebang, the canonical exec and any chained user hook. `-p` skips BASH_ENV/ENV, imports
# no exported functions and ignores SHELLOPTS/BASHOPTS; `/bin/bash` (not `bash`) means a
# decoy on PATH is never resolved. CANONICAL is the install-time absolute path, so an
# inherited HOME cannot redirect it.
_write_pre_commit_stub() {
  local dst="$1" backup="${2:-}"
  cat > "$dst" <<STUB
#!/bin/bash -p
${REIN_STUB_MARKER} — Gate 2 pre-commit
# This file is a thin redirector. The canonical script lives at
# \$HOME/.rein/hooks/pre-commit.sh and is always upgraded by 'ai sync'.
set -uo pipefail

CANONICAL="${REIN}/hooks/pre-commit.sh"   # E-290: install-time absolute path, never \$HOME
STUB

  if [[ -n "$backup" ]]; then
    cat >> "$dst" <<STUB
# E-41: chained execution — call the user's pre-Rein hook first.
USER_HOOK="\${0%/*}/${backup##*/}"
if [[ -x "\$USER_HOOK" ]]; then
  /bin/bash -p "\$USER_HOOK" "\$@" || exit \$?
fi

STUB
  fi

  cat >> "$dst" <<'STUB'
if [[ ! -f "$CANONICAL" ]]; then
  echo "[Rein] pre-commit canonical missing: $CANONICAL — run: bash install-rein.sh" >&2
  exit 1   # fail closed (Gate 2 contract)
fi
exec /bin/bash -p "$CANONICAL" "$@"
STUB
  chmod +x "$dst"
}

# E-267 (D-072 §5b): pre-push execution stub. Fails CLOSED like pre-commit — a local CI
# gate that vanishes when its canonical is missing would wave every push through. stdin
# (git's ref lines) and "$@" (remote name, url) are preserved: `exec` hands both over, and
# a chained user hook gets its own copy of stdin.
_write_pre_push_stub() {
  local dst="$1" backup="${2:-}"
  cat > "$dst" <<STUB
#!/bin/bash -p
${REIN_STUB_MARKER} — Local CI pre-push
# This file is a thin redirector. The canonical script lives at
# \$HOME/.rein/hooks/pre-push.sh and is always upgraded by 'ai sync'.
set -uo pipefail

CANONICAL="${REIN}/hooks/pre-push.sh"   # E-290: install-time absolute path, never \$HOME
STUB

  if [[ -n "$backup" ]]; then
    cat >> "$dst" <<STUB
# Chained execution — the user's pre-Rein hook sees the same stdin first.
USER_HOOK="\${0%/*}/${backup##*/}"
_REFS="\$(cat)"
if [[ -x "\$USER_HOOK" ]]; then
  printf '%s\\n' "\$_REFS" | /bin/bash -p "\$USER_HOOK" "\$@" || exit \$?
fi
if [[ ! -f "\$CANONICAL" ]]; then
  echo "[Rein] pre-push canonical missing: \$CANONICAL — run: bash install-rein.sh" >&2
  exit 1   # fail closed (local CI gate)
fi
printf '%s\\n' "\$_REFS" | exec /bin/bash -p "\$CANONICAL" "\$@"
STUB
  else
    cat >> "$dst" <<'STUB'
if [[ ! -f "$CANONICAL" ]]; then
  echo "[Rein] pre-push canonical missing: $CANONICAL — run: bash install-rein.sh" >&2
  exit 1   # fail closed (local CI gate)
fi
exec /bin/bash -p "$CANONICAL" "$@"
STUB
  fi
  chmod +x "$dst"
}

# Writes a post-commit execution stub. Fails open: post-commit work is
# advisory (TASKS.md auto-sync), so a missing canonical must not break a
# successful commit.
_write_post_commit_stub() {
  local dst="$1" backup="${2:-}"
  cat > "$dst" <<STUB
#!/bin/bash -p
${REIN_STUB_MARKER} — TASKS.md Auto-Sync post-commit
# This file is a thin redirector. The canonical script lives at
# \$HOME/.rein/hooks/post-commit.sh and is always upgraded by 'ai sync'.
set -uo pipefail

CANONICAL="${REIN}/hooks/post-commit.sh"   # E-290: install-time absolute path, never \$HOME
STUB

  if [[ -n "$backup" ]]; then
    cat >> "$dst" <<STUB
# E-41: chained execution — call the user's pre-Rein hook first (advisory).
USER_HOOK="\${0%/*}/${backup##*/}"
if [[ -x "\$USER_HOOK" ]]; then
  /bin/bash -p "\$USER_HOOK" "\$@" || true
fi

STUB
  fi

  cat >> "$dst" <<'STUB'
if [[ ! -f "$CANONICAL" ]]; then
  echo "[Rein] post-commit canonical missing: $CANONICAL (skipping TASK-SYNC)" >&2
  exit 0   # fail open (post-commit is advisory)
fi
/bin/bash -p "$CANONICAL" "$@" || true
exit 0
STUB
  chmod +x "$dst"
}

# E-326 (D-102 §Component 2): post-merge / post-checkout / post-rewrite stubs. Each runs the
# ONE canonical hooks/state-import.sh with its own name, which imports the pulled record files
# of a team project (a legacy project exits before starting node). Fail open like post-commit:
# an import must never break a pull, a checkout or a rebase.
_write_import_stub() {  # <dst> <hook> [backup]
  local dst="$1" hook="$2" backup="${3:-}"
  cat > "$dst" <<STUB
#!/bin/bash -p
${REIN_STUB_MARKER} — State import ${hook}
# This file is a thin redirector. The canonical script lives at
# \$HOME/.rein/hooks/state-import.sh and is always upgraded by 'ai sync'.
set -uo pipefail

CANONICAL="${REIN}/hooks/state-import.sh"   # E-290: install-time absolute path, never \$HOME
STUB
  if [[ -n "$backup" ]]; then
    cat >> "$dst" <<STUB
# E-41: chained execution — call the user's pre-Rein hook first (advisory).
USER_HOOK="\${0%/*}/${backup##*/}"
if [[ -x "\$USER_HOOK" ]]; then
  /bin/bash -p "\$USER_HOOK" "\$@" || true
fi

STUB
  fi
  cat >> "$dst" <<STUB
if [[ ! -f "\$CANONICAL" ]]; then
  echo "[Rein] ${hook} canonical missing: \$CANONICAL (skipping state import)" >&2
  exit 0   # fail open (an import never blocks git)
fi
/bin/bash -p "\$CANONICAL" ${hook} "\$@" || true
exit 0
STUB
  chmod +x "$dst"
}
_write_post_merge_stub()    { _write_import_stub "$1" post-merge    "${2:-}"; }
_write_post_checkout_stub() { _write_import_stub "$1" post-checkout "${2:-}"; }
_write_post_rewrite_stub()  { _write_import_stub "$1" post-rewrite  "${2:-}"; }
IMPORT_HOOKS="post-merge:_write_post_merge_stub post-checkout:_write_post_checkout_stub post-rewrite:_write_post_rewrite_stub"

# E-326: the git merge driver for team record files (.ai/.gitattributes names it). Config is
# per clone; a clone without it falls back to git's text merge and its conflict markers.
_install_record_merge_driver() {
  local cs="${REIN}/shared/cli-state.mjs"
  # The driver line is a shell command persisted in .git/config: refuse an install path that
  # is relative or carries a quote (a session's env can set HOME) rather than store it.
  if [[ "$REIN" != /* || "$REIN" == *"'"* ]]; then
    echo "  ⚠  not configuring the rein-record merge driver: install path ${REIN} is not a plain absolute path"; return 0
  fi
  [[ -f "$cs" ]] || { echo "  ⚠  cli-state.mjs not found at ${cs} — run: ai install"; return 0; }
  git config --remove-section merge.aios-record 2>/dev/null || true  # rename:legacy-fallback (E-383: the pre-rename driver)
  git config merge.rein-record.name "Rein team record (D-102 policy)" || return 0
  git config merge.rein-record.driver "node --no-warnings '${cs}' state merge-driver %O %A %B %P" || return 0
  echo "  ✓ Configured the rein-record merge driver (team record files)"
}

install_git_hooks() {
  # E-244: `git rev-parse` exits 128 outside a repository, and under `set -e` a PLAIN
  # assignment carries the substitution's status — so this line ABORTED the whole script
  # in a non-git directory instead of reaching the "not a git repo" branch three lines
  # below it. That is the long-standing `ai init` exit-128 in a fresh directory; it was
  # invisible from `ai sync` only because the call sat in unreachable code. `|| true`
  # keeps the status, and the empty-string guard then does what it always meant to.
  local _git_dir GIT_HOOKS_DIR
  _git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
  GIT_HOOKS_DIR="${_git_dir:+${_git_dir}/hooks}"
  if [[ -z "$GIT_HOOKS_DIR" || ! -d "$GIT_HOOKS_DIR" ]]; then
    echo "  ⚠  Not a git repo — skipping git hook install"
    return
  fi

  local HOOK_SRC="${REIN}/hooks/pre-commit.sh"
  local HOOK_DST="${GIT_HOOKS_DIR}/pre-commit"

  if [[ ! -f "$HOOK_SRC" ]]; then
    echo "  ⚠  pre-commit.sh not found at ${HOOK_SRC} — run: ai install"
    return
  fi

  if [[ -f "$HOOK_DST" ]]; then
    if _is_rein_stub "$HOOK_DST"; then
      # E-270: an existing stub is refreshed when an older version wrote it.
      if _refresh_stub _write_pre_commit_stub "$HOOK_DST"; then
        echo "  ✓ Refreshed pre-commit stub (Gate 2)"
      else
        echo "  ✓ pre-commit stub already installed (Gate 2)"
      fi
    elif grep -qE "(Rein|AI-OS) Gate 2" "$HOOK_DST" 2>/dev/null; then  # rename:legacy-fallback
      # Legacy copy — upgrade in place to a stub.
      _write_pre_commit_stub "$HOOK_DST"
      echo "  ✓ Upgraded legacy pre-commit copy → execution stub (Gate 2)"
    else
      # Preserve existing third-party hook; chain it through the stub.
      local BACKUP="${HOOK_DST}.pre-rein"
      mv "$HOOK_DST" "$BACKUP"
      echo "  ✓ Backed up existing pre-commit hook → pre-commit.pre-rein"
      _write_pre_commit_stub "$HOOK_DST" "$BACKUP"
      echo "  ✓ Installed Gate 2 stub (chained → pre-commit.pre-rein) → ${HOOK_DST}"
    fi
  else
    _write_pre_commit_stub "$HOOK_DST"
    echo "  ✓ Installed Gate 2 (Quality Gate) pre-commit stub → ${HOOK_DST}"
  fi

  # E-267 (D-072 §5b): pre-push local CI gate — same stub model, fails closed.
  local PP_SRC="${REIN}/hooks/pre-push.sh"
  local PP_DST="${GIT_HOOKS_DIR}/pre-push"
  if [[ ! -f "$PP_SRC" ]]; then
    echo "  ⚠  pre-push.sh not found at ${PP_SRC} — run: ai install"
  elif [[ -f "$PP_DST" ]] && _is_rein_stub "$PP_DST"; then
    if _refresh_stub _write_pre_push_stub "$PP_DST"; then
      echo "  ✓ Refreshed pre-push stub (local CI gate)"
    else
      echo "  ✓ pre-push stub already installed (local CI gate)"
    fi
  elif [[ -f "$PP_DST" ]]; then
    local PP_BACKUP="${PP_DST}.pre-rein"
    mv "$PP_DST" "$PP_BACKUP"
    echo "  ✓ Backed up existing pre-push hook → pre-push.pre-rein"
    _write_pre_push_stub "$PP_DST" "$PP_BACKUP"
    echo "  ✓ Installed local CI gate stub (chained → pre-push.pre-rein) → ${PP_DST}"
  else
    _write_pre_push_stub "$PP_DST"
    echo "  ✓ Installed local CI gate pre-push stub → ${PP_DST}"
  fi

  # E-55: Install post-commit hook (TASKS.md auto-sync) — same stub model.
  local PC_SRC="${REIN}/hooks/post-commit.sh"
  local PC_DST="${GIT_HOOKS_DIR}/post-commit"

  if [[ ! -f "$PC_SRC" ]]; then
    echo "  ⚠  post-commit.sh not found at ${PC_SRC} — run: ai install"
  elif [[ -f "$PC_DST" ]]; then
    if _is_rein_stub "$PC_DST"; then
      if _refresh_stub _write_post_commit_stub "$PC_DST"; then
        echo "  ✓ Refreshed post-commit stub (TASK-SYNC)"
      else
        echo "  ✓ post-commit stub already installed (TASK-SYNC)"
      fi
    elif grep -q "Rein.*TASK-SYNC\|TASKS.md Auto-Sync" "$PC_DST" 2>/dev/null; then
      _write_post_commit_stub "$PC_DST"
      echo "  ✓ Upgraded legacy post-commit copy → execution stub (TASK-SYNC)"
    else
      local PC_BACKUP="${PC_DST}.pre-rein"
      mv "$PC_DST" "$PC_BACKUP"
      echo "  ✓ Backed up existing post-commit hook → post-commit.pre-rein"
      _write_post_commit_stub "$PC_DST" "$PC_BACKUP"
      echo "  ✓ Installed TASK-SYNC stub (chained → post-commit.pre-rein) → ${PC_DST}"
    fi
  else
    _write_post_commit_stub "$PC_DST"
    echo "  ✓ Installed TASK-SYNC post-commit stub → ${PC_DST}"
  fi

  # E-326: state import on pull / checkout / rebase — same stub model, fails open.
  local pair hook writer dst
  if [[ ! -f "${REIN}/hooks/state-import.sh" ]]; then
    echo "  ⚠  state-import.sh not found at ${REIN}/hooks — run: ai install"
  else
    for pair in $IMPORT_HOOKS; do
      hook="${pair%%:*}"; writer="${pair#*:}"; dst="${GIT_HOOKS_DIR}/${hook}"
      if [[ -f "$dst" ]] && _is_rein_stub "$dst"; then
        _refresh_stub "$writer" "$dst" && echo "  ✓ Refreshed ${hook} stub (state import)" \
          || echo "  ✓ ${hook} stub already installed (state import)"
      elif [[ -f "$dst" ]]; then
        mv "$dst" "${dst}.pre-rein"
        "$writer" "$dst" "${dst}.pre-rein"
        echo "  ✓ Installed state import stub (chained → ${hook}.pre-rein) → ${dst}"
      else
        "$writer" "$dst"
        echo "  ✓ Installed state import ${hook} stub → ${dst}"
      fi
    done
  fi
  _install_record_merge_driver
}

# E-41: Idempotent in-place upgrade of legacy copied hooks to the stub model.
# Called from do_sync; walks .git/hooks/{pre,post}-commit and rewrites any
# legacy Rein copy (no stub marker, has Gate 2 / TASK-SYNC headers) to a
# fresh stub. Skips third-party hooks (no Rein markers at all) so user
# tooling is never silently overwritten.
_upgrade_legacy_git_hooks() {
  local git_dir
  git_dir="$(git rev-parse --git-dir 2>/dev/null)" || return 0
  [[ -d "${git_dir}/hooks" ]] || return 0
  local HOOKS_DIR="${git_dir}/hooks"

  local pc="${HOOKS_DIR}/pre-commit"
  if [[ -f "$pc" ]] && ! _is_rein_stub "$pc" \
       && grep -qE "(Rein|AI-OS) Gate 2" "$pc" 2>/dev/null; then  # rename:legacy-fallback
    _write_pre_commit_stub "$pc"
    echo "  ✓ Upgraded .git/hooks/pre-commit → stub (E-41)"
  fi

  local poc="${HOOKS_DIR}/post-commit"
  if [[ -f "$poc" ]] && ! _is_rein_stub "$poc" \
       && grep -qE "Rein.*TASK-SYNC|TASKS.md Auto-Sync" "$poc" 2>/dev/null; then
    _write_post_commit_stub "$poc"
    echo "  ✓ Upgraded .git/hooks/post-commit → stub (E-41)"
  fi
}

# E-114: Query global memory store for similar projects during ai init (§31 advisory hint)
# Silent failure — project-local context always takes priority.
_query_similar_signatures() {
  local MEM_DIR="${REIN}/memory"
  local SIG_FILE="${MEM_DIR}/signatures.json"
  if ! command -v python3 &>/dev/null; then return 0; fi
  if [[ ! -f "$SIG_FILE" ]]; then return 0; fi
  local PROJECT_TAG
  PROJECT_TAG="$(basename "$(pwd)")"

  python3 - "$SIG_FILE" "$PROJECT_TAG" <<'PY' 2>/dev/null || true
import json, sys
sig_file  = sys.argv[1]
query_tag = sys.argv[2].lower()

try:
    sigs = json.load(open(sig_file))
    if not isinstance(sigs, list) or not sigs:
        sys.exit(0)
    matched = [
        s for s in sigs
        if query_tag in str(s.get("project_name", "")).lower()
        or query_tag in str(s.get("tag", "")).lower()
        or any(query_tag in str(t).lower() for t in (s.get("tags") or []))
    ]
    if not matched:
        sys.exit(0)
    print("\nSimilar projects from memory palace (advisory):")
    for s in matched[:3]:
        print(f"  • {s.get('project_name','?')}: {str(s.get('summary',''))[:100]}")
except Exception:
    pass  # Silent failure per §31
PY
}

# ── E-270 (D-074 §Components 2): `ai init` as an idempotent upgrade ───────────
# Re-running `ai init` in an existing project brings it to the installed version:
# generated files are REFRESHED, schema-bearing templates are MERGED
# (shared/project-upgrade.mjs), user content (BRIEF, RULES, SEED, DIGEST, TASKS, LOG,
# architect.md, blueprints) is never written — ensure_ai_templates only creates those
# when missing — and removal stays with `ai clean`.

_upgrade_helper() { _rein_helper shared/project-upgrade.mjs; }

# The stamped version of the project in the cwd, or nothing. No side effects.
_project_version() {
  local h; h="$(_upgrade_helper || true)"
  [[ -n "$h" && -d ".ai" ]] && command -v node >/dev/null 2>&1 || return 0
  node "${_CI_NODE_FLAGS[@]}" "$h" version --ai-dir .ai 2>/dev/null || true
}

# _upgrade_records <merge|stamp|rename> [--check] — TAB records on stdout (kind, file, detail).
_upgrade_records() {
  local sub="$1"; shift
  local h; h="$(_upgrade_helper || true)"
  if [[ -z "$h" ]] || ! command -v node >/dev/null 2>&1; then
    printf 'error\tproject-upgrade.mjs\tunavailable — run: ai install\n'; return 0
  fi
  local -a a=(--ai-dir .ai --version "$VERSION")
  [[ "$sub" == "merge" ]] && a+=(--templates "${REIN}/templates" --legacy "${REIN}/config/legacy-artefacts.json")
  node "${_CI_NODE_FLAGS[@]}" "$h" "$sub" "${a[@]}" "$@" 2>/dev/null \
    || printf 'error\tproject-upgrade.mjs\t%s failed\n' "$sub"
}

# The generated surface `ai init` refreshes, one path per line, relative to the cwd (git
# hooks absolute). _SYNC_MANIFEST.json is excluded: it is sync bookkeeping and carries a
# written_at timestamp, so it changes on every run without anything being refreshed.
# settings.local.json is user-owned (never written by Rein).
_generated_surface() {
  local f
  for f in ENGINEER.md ARCHITECT.md CLAUDE.md .mcp.json .gitignore .ai/.gitignore; do
    [[ -f "$f" ]] && printf '%s\n' "$f"
  done
  [[ -d .claude ]] && find .claude -type f ! -name _SYNC_MANIFEST.json ! -name settings.local.json 2>/dev/null | LC_ALL=C sort
  local gd; gd="$(git rev-parse --git-dir 2>/dev/null || true)"
  if [[ -n "$gd" ]]; then
    for f in pre-commit pre-push post-commit post-merge post-checkout post-rewrite; do [[ -f "${gd}/hooks/${f}" ]] && printf '%s\n' "${gd}/hooks/${f}"; done
  fi
  return 0
}

# "<cksum> <path>" per generated file — compared before/after to count what was refreshed.
_surface_digest() {
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] && printf '%s %s\n' "$(cksum < "$f" | awk '{print $1"-"$2}')" "$f"
  done < <(_generated_surface)
}

# Paths whose digest differs (changed, added or removed) between two digests.
_surface_changes() {  # <before-file> <after-file>
  LC_ALL=C comm -3 <(LC_ALL=C sort "$1") <(LC_ALL=C sort "$2") | awk '{print $NF}' | LC_ALL=C sort -u
}

# ── git hook stubs: refresh an existing Rein stub whose text is out of date ──
# install_git_hooks used to leave any existing stub alone, so a stub written by an older
# version was never upgraded. The chained user hook (the USER_HOOK line) is preserved.
_stub_backup_of() {
  sed -nE 's|^USER_HOOK="\$\(dirname "\$0"\)/([^"]+)"$|\1|p' "$1" 2>/dev/null | head -1
}
_expected_stub() {  # <writer> <existing-stub> <out>
  local b; b="$(_stub_backup_of "$2")"
  if [[ -n "$b" ]]; then "$1" "$3" "$(dirname "$2")/${b}"; else "$1" "$3"; fi
}
_stub_is_current() {  # <writer> <stub>
  local t rc=0; t="$(mktemp "${TMPDIR:-/tmp}/rein-stub.XXXXXX")"
  _expected_stub "$1" "$2" "$t"
  cmp -s "$t" "$2" || rc=1
  rm -f "$t"
  return "$rc"
}
_refresh_stub() {  # <writer> <stub> — rewrite in place when stale; 0 = refreshed
  local t; t="$(mktemp "${2}.rein.XXXXXX")" || return 1
  _expected_stub "$1" "$2" "$t"
  if cmp -s "$t" "$2"; then rm -f "$t"; return 1; fi
  chmod +x "$t"; mv -f "$t" "$2"
  return 0
}

# Count of actionable legacy findings (safe + prompt) for the upgrade summary.
_legacy_count() {
  local h root; h="$(_rein_helper shared/ai-clean.mjs || true)"
  [[ -n "$h" ]] && command -v node >/dev/null 2>&1 || { echo "?"; return 0; }
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  # plan --json exits 1 WITH findings (E-272): read the output, never the status.
  local out; out="$(node "${_CI_NODE_FLAGS[@]}" "$h" plan --project "$root" --json 2>/dev/null || true)"
  printf '%s' "$out" | python3 -c 'import json,sys
try:
  c=json.load(sys.stdin)["counts"]; print(c.get("safe",0)+c.get("prompt",0))
except Exception: print("?")' 2>/dev/null || echo "?"
}

# `ai init --check`: the dry run. Every refresh step is replayed in a scratch copy of the
# generated surface, so --check and the real run cannot disagree about what "current"
# means; the merge and the stamp are asked in their own --check mode. Exit 1 = pending.
_init_check() {
  if [[ ! -d ".ai" ]]; then
    echo "ai init --check: no .ai/ here — ai init would provision a new project."
    return 1
  fi
  local -a pending=()
  local kind file detail
  while IFS=$'\t' read -r kind file detail; do
    [[ -n "$kind" ]] || continue
    case "$kind" in
      pending) pending+=("merge    ${file}: ${detail}") ;;
      error)   echo "  ⚠  ${file}: ${detail}" ;;
    esac
  done < <(_upgrade_records merge --check; _upgrade_records rename --check; _upgrade_records stamp --check)

  local scratch; scratch="$(mktemp -d "${TMPDIR:-/tmp}/rein-init-check.XXXXXX")"
  mkdir -p "${scratch}/.ai"
  local f
  for f in ENGINEER.md ARCHITECT.md CLAUDE.md .mcp.json .gitignore; do
    [[ -f "$f" ]] && cp -p "$f" "${scratch}/$f"
  done
  for f in roles.json providers.json .gitignore; do
    [[ -f ".ai/$f" ]] && cp -p ".ai/$f" "${scratch}/.ai/$f"
  done
  [[ -d .claude ]] && cp -Rp .claude "${scratch}/.claude"
  (
    cd "$scratch" || exit 1
    _upgrade_records merge >/dev/null
    _ensure_generated_gitignore "." >/dev/null 2>&1
    generate_mcp_json "." >/dev/null 2>&1
    cp -f "${REIN}/templates/ENGINEER.md"  "ENGINEER.md"
    cp -f "${REIN}/templates/ARCHITECT.md" "ARCHITECT.md"
    cp -f "${REIN}/templates/CLAUDE.md"    "CLAUDE.md"
    _sync_workspace_dirs sync >/dev/null 2>&1
  ) || true
  local proj_digest scratch_digest
  proj_digest="$(mktemp "${TMPDIR:-/tmp}/rein-dig.XXXXXX")"; scratch_digest="$(mktemp "${TMPDIR:-/tmp}/rein-dig.XXXXXX")"
  # Hooks are compared by content below, not through the scratch copy (it has no .git).
  _surface_digest | grep -v '/hooks/' > "$proj_digest" || true
  ( cd "$scratch" && _surface_digest ) > "$scratch_digest" || true
  while IFS= read -r f; do
    [[ -n "$f" ]] && pending+=("refresh  ${f}")
  done < <(_surface_changes "$proj_digest" "$scratch_digest")
  rm -rf "$scratch" "$proj_digest" "$scratch_digest"

  local gd; gd="$(git rev-parse --git-dir 2>/dev/null || true)"
  if [[ -n "$gd" && -d "${gd}/hooks" ]]; then
    local pair hook writer
    for pair in pre-commit:_write_pre_commit_stub pre-push:_write_pre_push_stub post-commit:_write_post_commit_stub $IMPORT_HOOKS; do
      hook="${pair%%:*}"; writer="${pair#*:}"
      if [[ ! -f "${gd}/hooks/${hook}" ]] || ! _is_rein_stub "${gd}/hooks/${hook}"; then
        pending+=("install  ${gd}/hooks/${hook}")
      elif ! _stub_is_current "$writer" "${gd}/hooks/${hook}"; then
        pending+=("refresh  ${gd}/hooks/${hook}")
      fi
    done
  fi

  local pv; pv="$(_project_version)"
  if [[ "${#pending[@]}" -eq 0 ]]; then
    echo "ai init --check: project ${pv:-(unstamped)} is current with installed ${VERSION} — nothing to do."
    return 0
  fi
  echo "ai init --check: project ${pv:-(unstamped)} → installed ${VERSION} — ${#pending[@]} change(s) pending:"
  printf '  %s\n' "${pending[@]}"
  echo "Run: ai init"
  return 1
}

do_init() {
  local _arg
  for _arg in "$@"; do
    case "$_arg" in
      --check) _init_check; return $? ;;
      *) echo "ai init: unknown option '${_arg}' (only --check)" >&2; return 2 ;;
    esac
  done

  # E-270: an existing project is an UPGRADE — say from what to what, and measure it.
  local _existing=0 _before="" _old_version=""
  if [[ -d ".ai" ]]; then
    _existing=1
    _old_version="$(_project_version)"
    echo "Upgrading: project ${_old_version:-(unstamped)} → installed ${VERSION}"
    _before="$(mktemp "${TMPDIR:-/tmp}/rein-dig.XXXXXX")"
    _surface_digest > "$_before" || true
  fi

  ensure_ai_templates
  migrate_legacy_ai_if_present
  install_git_hooks

  # E-33: Auto-setup MCP server dependencies (Battery-Included onboarding)
  if command -v node &>/dev/null && [[ -d "${REIN}/mcp" ]]; then
    echo ""
    echo "Setting up MCP servers (Node.js detected)..."
    do_mcp_setup 2>/dev/null || echo "  ⚠  MCP setup incomplete — run: ai mcp-setup"
  else
    echo ""
    echo "MCP servers: Node.js not found — run 'ai mcp-setup' after installing Node.js"
  fi

  # E-93: Structured-First init — seed state.json from TASKS.md automatically.
  # NO --force: only seed when state.json is empty/missing. Forcing here would
  # re-parse the lossy TASKS.md view over an already-populated state and strip
  # time-of-day timestamps + depends_on (the recurring corruption). The guard in
  # do_migrate_state declines (exit 1) on a populated state, handled by the || below.
  if [[ -f ".ai/TASKS.md" ]]; then
    echo ""
    echo "Seeding state.json from TASKS.md (Structured-First init)..."
    # E-270: in a SUBSHELL. do_migrate_state declines with `exit 1`, not `return 1`, and
    # called directly that exit ended `ai init` right here on every populated project —
    # the stamp, the summary and everything after this line never ran on a re-init.
    ( do_migrate_state ) 2>/dev/null || echo "  (state.json already populated — skipped re-seed)"
  fi

  # E-114: Query global memory store for similar architectural patterns (§31 advisory)
  _query_similar_signatures 2>/dev/null || true

  # E-270 (D-074 §Components 1): stamp the version that provisioned this project — after
  # the seed above: when state.sqlite does not exist yet, the stamp imports state.json first.
  local _sk _sf _sd _stamp_line=""
  while IFS=$'\t' read -r _sk _sf _sd; do
    case "$_sk" in
      stamped)       _stamp_line="${_sd}" ;;
      skipped|error) _stamp_line="not stamped — ${_sf}: ${_sd}" ;;
    esac
  done < <(_upgrade_records stamp)

  if [[ "$_existing" -eq 1 ]]; then
    local _after _n_refreshed _n_merged="${#UPGRADE_MERGED[@]}" _n_legacy
    _after="$(mktemp "${TMPDIR:-/tmp}/rein-dig.XXXXXX")"
    _surface_digest > "$_after" || true
    _n_refreshed="$(_surface_changes "$_before" "$_after" | grep -c . || true)"
    rm -f "$_before" "$_after"
    _n_legacy="$(_legacy_count)"
    echo ""
    [[ -n "$_stamp_line" ]] && echo "Stamp: ${_stamp_line}"
    echo "Upgrade: ${_n_refreshed} refreshed, ${_n_merged} merged, ${_n_legacy} legacy items$( [[ "$_n_legacy" != "0" ]] && printf ' — run: ai clean')"
    echo "Rein v${VERSION} — user files (BRIEF, RULES, SEED, DIGEST, TASKS, LOG, architect.md, blueprints) untouched."
    return 0
  fi

  echo ""
  echo "Initialized .ai/ + .github/ (safe — no overwrites) with Rein v${VERSION}"
  echo ""
  echo "Next (MANDATORY):"
  echo "1) Fill in .ai/BRIEF.md and .ai/REPO.md"
  echo "2) Fill in .ai/DIGEST.md — Include Triad Health (Planning/Execution/Testing)"
  echo "3) Define the initial vision in .ai/architect.md (Template provided)"
  echo "4) Fill in .github/copilot-instructions.md (project-specific context)"
  echo "5) Open a provider CLI in this repo — the bootloader auto-runs ai-preflight"
  echo ""
  # E-228 (D-059): name the one command that does step 5 for you. Without this the
  # launcher exists but is only discoverable by reading the README.
  echo "Or let the launcher do it:  ai start"
  echo "  Builds the tmux Triad layout and binds each pane to its role."
  echo "  Idempotent — safe to re-run.  ai start --status | --kill   (ai doctor checks readiness)"
  echo ""
  local _arch_label _eng_label _tst_label
  IFS='|' read -r _arch_label _eng_label _tst_label <<< "$(_roles_banner_labels)"
  echo "Triad Workflow (commands now run as agent prompts/skills):"
  # %-18s, not %-12s: labels now carry a model ("claude · fable") and the old width
  # silently truncated nothing but misaligned the arrows.
  printf '  Architect %-18s → Writes to architect.md / blueprints\n' "(${_arch_label})"
  printf '  Engineer  %-18s → Implements code based on blueprints\n' "(${_eng_label})"
  # E-255: the Tester is a headless Claude role — its label is derived like the other two.
  printf '  Tester    %-18s → Quality gate via skill: ai-test (headless)\n' "(${_tst_label})"
  echo ""
  echo "MCP servers enabled in .mcp.json (filesystem + memory)."
}










do_migrate_state() {
  local FORCE="" FROM_TASKS=0 _a
  for _a in "$@"; do
    case "$_a" in
      --force)      FORCE="--force" ;;
      --from-tasks) FROM_TASKS=1 ;;
    esac
  done

  if [[ ! -d ".ai" ]]; then
    echo "✗ No .ai/ directory found. Run: ai init"
    exit 1
  fi

  local STATE_FILE=".ai/state.json"
  local TASKS_FILE=".ai/TASKS.md"

  if [[ ! -f "$TASKS_FILE" ]]; then
    echo "✗ .ai/TASKS.md not found — nothing to migrate."
    exit 1
  fi

  # E-325 (D-102): in a team project TASKS.md and state.json are views of the record files;
  # rebuilding state from the view would be backwards.
  if [[ -f ".ai/project.json" ]]; then
    echo "✗ team project (.ai/project.json; records under .ai/tasks/) — TASKS.md is a view; nothing to migrate."
    exit 1
  fi

  if ! command -v python3 &>/dev/null; then
    echo "✗ python3 required for migration"
    exit 1
  fi

  # E-344 (D-108 r8): TASKS.md is a lossy view (no summaries, stamps or dependencies). When the
  # committed state.json holds more tasks than it lists, the lossless source is the import.
  if [[ "$FROM_TASKS" -eq 0 ]]; then
    local _head_n _md_n
    _head_n="$(git show HEAD:.ai/state.json 2>/dev/null | python3 -c 'import json,sys
try: print(len(json.load(sys.stdin).get("tasks", [])))
except Exception: print(0)' 2>/dev/null || echo 0)"
    _md_n="$(grep -cE '^- \[[ xX]\] [A-Z]+-[0-9]+:' "$TASKS_FILE" 2>/dev/null || true)"
    if [[ "${_head_n:-0}" -gt "${_md_n:-0}" ]]; then
      echo "[LOSSY_RESEED] HEAD:.ai/state.json has ${_head_n} tasks, TASKS.md lists ${_md_n:-0} — run: ai state import (lossless)."
      echo "  To rebuild from TASKS.md anyway: ai migrate-state --from-tasks"
      exit 1
    fi
  fi

  if ! command -v node &>/dev/null; then
    echo "✗ node required for migration"
    exit 1
  fi

  # Guard: if state.json already has tasks, require --force
  if [[ -f "$STATE_FILE" ]]; then
    local task_count
    task_count=$(python3 -c "
import json, sys
try:
    d = json.load(open('${STATE_FILE}'))
    print(len(d.get('tasks', [])))
except:
    print(0)
" 2>/dev/null || echo "0")
    if [[ "$task_count" -gt 0 && "$FORCE" != "--force" ]]; then
      echo "[MIGRATE-STATE] state.json already has ${task_count} tasks. Use --force to re-migrate."
      exit 1
    fi
  fi

  echo "[MIGRATE-STATE] Parsing .ai/TASKS.md..."

  # `mktemp <tmpl>` only substitutes X's at the END of the template on BSD/macOS, so
  # `/tmp/ai_migrate_XXXXXX.json` was a FIXED, PREDICTABLE path — it never randomised.
  # Two concurrent migrations collide, and on a shared machine any other user can
  # pre-create that exact path (as a symlink, even) because the name is known in advance.
  # A private temp DIRECTORY randomises on both BSD and GNU and is not world-writable.
  local PARSED_TMPDIR PARSED_TMPFILE
  PARSED_TMPDIR=$(mktemp -d)
  PARSED_TMPFILE="${PARSED_TMPDIR}/parsed.json"

  local _al _el _tl
  IFS='|' read -r _al _el _tl <<< "$(_roles_banner_labels)"
  REIN_ARCH_OWNER="Architect (${_al})" REIN_TESTER_OWNER="Tester (${_tl//·/ · })" \
  python3 - "$TASKS_FILE" "$PARSED_TMPFILE" <<'PY'
import json, re, sys

tasks_file = sys.argv[1]
out_file   = sys.argv[2]
# Derived label (E-243). Falls back to a bare role name rather than a vendor: if roles.json
# cannot be read, "Architect" is still true, whereas a vendor-qualified label may not be.
import os as _os
ARCH_OWNER = _os.environ.get("REIN_ARCH_OWNER") or "Architect"
TESTER_OWNER = _os.environ.get("REIN_TESTER_OWNER") or "Tester"

tasks = []

SECTION_RE = re.compile(r'^#{1,3}\s+(.+)$')
TASK_RE    = re.compile(r'^- \[([ x])\] (E|P|T)-(\d+):?\s+(.+?)(?:\s*\|\s*Tier:\s*(\d))?$')
STATUS_RE  = re.compile(r'^\s{2}Status:\s+DONE\s+(\d{4}-\d{2}-\d{2})\s+[—–-]\s+(.+)$')

OWNER_PATTERNS = [
    # D-066/E-243: the owner label is DERIVED from roles.json, passed in as ARCH_OWNER.
    # It was hard-coded with a vendor name, so an all-Claude project stamped every
    # Architect-owned task with a vendor that no role was bound to.
    (re.compile(r'\bArchitect\b',                re.IGNORECASE), ARCH_OWNER),
    (re.compile(r'\bEngineer\b|\(Claude\)',      re.IGNORECASE), 'Engineer (Claude)'),
    (re.compile(r'\bTester\b',                  re.IGNORECASE), TESTER_OWNER),
]

current_owner = None
last_task     = None

with open(tasks_file, encoding='utf-8') as f:
    lines = f.readlines()

for line in lines:
    line_s = line.rstrip('\n')

    # Section header — update owner if recognisable
    m = SECTION_RE.match(line_s)
    if m:
        header = m.group(1).strip()
        for pattern, owner in OWNER_PATTERNS:
            if pattern.search(header):
                current_owner = owner
                break
        last_task = None
        continue

    # Task line
    m = TASK_RE.match(line_s)
    if m:
        status_char, prefix, num, desc, tier = m.groups()
        task = {
            'id':           f'{prefix}-{int(num)}',
            'owner':        current_owner or 'Unassigned',
            'status':       'DONE' if status_char == 'x' else 'OPEN',
            'tier':         int(tier) if tier else None,
            'description':  desc.strip(),
            'created_at':   None,
            'completed_at': None,
            'summary':      None,
        }
        tasks.append(task)
        last_task = task
        continue

    # Status line (must immediately follow a task line)
    if last_task:
        m = STATUS_RE.match(line_s)
        if m:
            date_str, summary = m.groups()
            last_task['completed_at'] = date_str + 'T00:00:00.000Z'
            last_task['summary']      = summary.strip()
        elif line_s.strip() and not line_s.startswith(' '):
            last_task = None

with open(out_file, 'w', encoding='utf-8') as f:
    json.dump(tasks, f, indent=2)

print(f'[MIGRATE-STATE] Parsed {len(tasks)} tasks from TASKS.md.')
PY

  local TASK_COUNT
  TASK_COUNT=$(python3 -c "import json; print(len(json.load(open('${PARSED_TMPFILE}'))))" 2>/dev/null || echo "0")

  if [[ "$TASK_COUNT" -eq 0 ]]; then
    echo "[MIGRATE-STATE] Warning: 0 tasks parsed. Check TASKS.md format."
    rm -rf "$PARSED_TMPDIR"
    exit 0
  fi

  echo "[MIGRATE-STATE] Writing ${TASK_COUNT} tasks to ${STATE_FILE}..."

  # E-325: state.json has one writer, record-store.mjs writeStateFile.
  local _rs; _rs="$(_rein_helper mcp/shared/record-store.mjs || true)"
  if [[ -z "$_rs" ]]; then
    echo "✗ record-store.mjs not found (run: bash install-rein.sh)"
    rm -rf "$PARSED_TMPDIR"
    exit 1
  fi
  node --no-warnings --input-type=module -e "
    import fs from 'fs';
    import { dirname } from 'path';
    import { pathToFileURL } from 'url';
    const { writeStateFile } = await import(pathToFileURL(process.argv[3]).href);
    const statePath  = process.argv[1];
    const parsedPath = process.argv[2];
    const parsedTasks = JSON.parse(fs.readFileSync(parsedPath, 'utf8'));

    let state;
    try {
      state = JSON.parse(fs.readFileSync(statePath, 'utf8'));
    } catch {
      state = { version: '1.0', project: { current_tier: null, release_verdict: null, focus: null }, tasks: [], stamps: [] };
    }

    const now = new Date().toISOString();
    // Non-destructive merge. TASKS.md is a LOSSY *view* of state.json — it carries
    // date-only timestamps (→ midnight), no depends_on/ready/blocked_by, and
    // truncated summaries. Overwriting state.tasks with the parse therefore
    // CORRUPTS any populated state (this was the recurring 'timestamps zeroed +
    // depends_on stripped' regression). state.json is authoritative for tasks it
    // already has (it is the source TASKS.md is generated from), so never clobber
    // an existing record — only APPEND genuinely-new tasks parsed from TASKS.md.
    if (!Array.isArray(state.tasks)) state.tasks = [];
    const existingIds = new Set(state.tasks.map(t => t.id));
    let appended = 0;
    for (const t of parsedTasks) {
      if (existingIds.has(t.id)) continue;          // preserve the rich existing record
      if (!t.created_at) t.created_at = t.completed_at || now;
      if (!('depends_on' in t)) t.depends_on = [];
      if (!('ready' in t))      t.ready = true;
      if (!('blocked_by' in t)) t.blocked_by = [];
      state.tasks.push(t);
      appended++;
    }
    writeStateFile(dirname(statePath), state);
    console.log('[MIGRATE-STATE] state.json: ' + appended + ' new task(s) appended, ' + existingIds.size + ' preserved (non-destructive).');
  " "$STATE_FILE" "$PARSED_TMPFILE" "$_rs"

  rm -rf "$PARSED_TMPDIR"

  echo ""
  echo "[MIGRATE-STATE] Migration complete."
  printf "  Tasks seeded to state.json: %s\n" "$TASK_COUNT"
  echo "  state.sqlite: seeded from state.json by its next opener (an empty index counts as unseeded — D-108)"
  echo "  To verify: open Claude Code and run skill: ai-test"
}



sync_skills_20() {
  # Copy Skills 2.0 folder-based skills (skill-name/SKILL.md structure)
  local src_dir="$1" dst_dir="$2"
  local count=0
  for skill_dir in "${src_dir}"/*/; do
    if [[ -d "$skill_dir" && -f "${skill_dir}SKILL.md" ]]; then
      local skill_name
      skill_name=$(basename "$skill_dir")
      cp -rf "${skill_dir%/}" "${dst_dir}/"
      _SKILL_CLAIMS="${_SKILL_CLAIMS:-|}${skill_name}|"
      count=$((count + 1))
    fi
  done
  # Also copy any remaining legacy flat .md files
  cp -f "${src_dir}"/*.md "${dst_dir}/" 2>/dev/null || true
  echo "  $count Skills 2.0 folder(s) + legacy flat files synced from ${src_dir}"
  # Regenerate _SKILLS_INDEX.md in dst_dir (metadata-only manifest for §29 Level 1 loading)
  _generate_skills_index "${dst_dir}"
}

_generate_skills_index() {
  # Generate _SKILLS_INDEX.md — name + one-line description for each skill.
  # Agents use this for Level 1 (metadata-only) discovery without loading full SKILL.md content.
  # E-31: deterministic across locales/filesystems — entries sorted with LC_ALL=C
  # so the same set of skills always produces byte-identical output. The file
  # itself is gitignored (regenerated on every `ai sync`), but determinism still
  # matters for cross-machine consistency and reproducible installs.
  local dir="$1"
  local index_file="${dir}/_SKILLS_INDEX.md"
  {
    echo "# Skills Index (metadata-only — §29 JIT Skill Loading)"
    echo "# Invoke with the Skill tool (skill: \"<name>\") to load full content."
    echo ""
    # Skills 2.0: folder-based — collect, sort with LC_ALL=C, then emit
    local skill_dirs
    skill_dirs=$(find "${dir}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | LC_ALL=C sort)
    while IFS= read -r skill_dir; do
      [[ -n "$skill_dir" && -f "${skill_dir}/SKILL.md" ]] || continue
      local name desc
      name=$(basename "$skill_dir")
      desc=$(python3 -c "
import re, sys
try:
    c = open('${skill_dir}/SKILL.md').read()
    m = re.match(r'^---\n(.*?)\n---', c, re.DOTALL)
    if m:
        for line in m.group(1).splitlines():
            if line.startswith('description:'):
                print(line.split(':', 1)[1].strip())
                sys.exit(0)
except: pass
print('')
" 2>/dev/null)
      if [[ -n "$desc" ]]; then
        echo "- ${name}: ${desc}"
      else
        echo "- ${name}"
      fi
    done <<< "$skill_dirs"
    # Legacy flat .md files — collect, sort with LC_ALL=C, then emit
    local skill_files
    skill_files=$(find "${dir}" -mindepth 1 -maxdepth 1 -type f -name '*.md' 2>/dev/null | LC_ALL=C sort)
    while IFS= read -r skill_file; do
      [[ -n "$skill_file" && -f "$skill_file" ]] || continue
      local fname
      fname=$(basename "$skill_file" .md)
      [[ "$fname" == "_SKILLS_INDEX" ]] && continue
      local desc
      desc=$(python3 -c "
import re, sys
try:
    c = open('${skill_file}').read()
    m = re.match(r'^---\n(.*?)\n---', c, re.DOTALL)
    if m:
        for line in m.group(1).splitlines():
            if line.startswith('description:'):
                print(line.split(':', 1)[1].strip())
                sys.exit(0)
except: pass
print('')
" 2>/dev/null)
      if [[ -n "$desc" ]]; then
        echo "- ${fname}: ${desc}"
      else
        echo "- ${fname}"
      fi
    done <<< "$skill_files"
  } > "$index_file"
}

do_sync_github() {
  # §28 GitHub Bridge: fetch assigned issues.
  # Usage: ai sync --github [--repo owner/repo] [--limit N]
  local REPO="" LIMIT="20"
  local _args=("$@")
  local i=0
  while [[ $i -lt ${#_args[@]} ]]; do
    case "${_args[$i]}" in
      --repo)  i=$((i+1)); REPO="${_args[$i]}" ;;
      --limit) i=$((i+1)); LIMIT="${_args[$i]}" ;;
    esac
    i=$((i+1))
  done

  if ! command -v gh &>/dev/null; then
    echo "✗ GitHub CLI (gh) not found. Install: https://cli.github.com/"
    return 1
  fi

  if ! gh auth status &>/dev/null 2>&1; then
    echo "✗ GitHub CLI not authenticated. Run: gh auth login"
    return 1
  fi

  if [[ ! -d ".ai" ]]; then
    echo "✗ Not in a Rein project — run: ai init"
    return 1
  fi

  echo "Fetching assigned GitHub issues (limit=${LIMIT})..."

  local GH_ARGS=(issue list --assignee @me --state open --limit "$LIMIT" --json "number,title,labels,url,body")
  [[ -n "$REPO" ]] && GH_ARGS+=(-R "$REPO")

  local ISSUES_JSON
  ISSUES_JSON=$(gh "${GH_ARGS[@]}" 2>/dev/null) || { echo "✗ gh issue list failed."; return 1; }

  local DATE
  DATE=$(date '+%Y-%m-%d')

  GITHUB_ISSUES_JSON="$ISSUES_JSON" python3 - "$DATE" <<'PY'
import json, sys, os
date = sys.argv[1]
try:
    issues = json.loads(os.environ.get("GITHUB_ISSUES_JSON", "[]"))
except Exception:
    issues = []
if not issues:
    print("No issues found.")
    sys.exit(0)
header = f"\n## GitHub Issues — imported {date}\n\n"
parts = []
for issue in issues:
    labels = ", ".join(l["name"] for l in issue.get("labels", []))
    # E-279: issue text is UNTRUSTED (T-PI-001; 30_SECURITY.md) — fence it so the pane it
    # is pasted into can tell data from instructions.
    block = "\n".join(filter(None, [
        f"<!-- UNTRUSTED: github issue #{issue['number']} -->",
        f"### Issue #{issue['number']}: {issue['title']}",
        f"URL: {issue.get('url', '')}",
        f"Labels: {labels}" if labels else None,
        "",
        (issue.get("body") or "(no description)")[:800],
        "<!-- /UNTRUSTED -->",
    ]))
    parts.append(block)
# E-243: role-derived, not vendor-literal — an all-Claude project was told to hand work to
# a vendor no role was bound to.
_arch_owner = os.environ.get("REIN_ARCH_OWNER") or "Architect"
footer = "\n## Action Required\n%s: Review the issues above and create P-## blueprint tasks via:\n  mcp__task-synchronizer-mcp__add_task({ prefix: 'P', owner: '%s', description: '...', tier: N })\nThis writes to state.sqlite and regenerates TASKS.md automatically.\n" % (_arch_owner, _arch_owner)
print(header + "\n\n---\n\n".join(parts) + "\n" + footer)
PY

  echo "✓ Issues fetched. Paste the output above into the Architect pane to blueprint them."
}

# ── E-233 (D-060 §4): keep generated sync artefacts out of git ────────────────────
# `ai sync` rewrites these on every run, and _SYNC_MANIFEST.json holds sha256 hashes that
# are only true for the machine that wrote them — committing one ships another machine a
# manifest that LIES about what is on disk, which is worse than the diff noise because the
# prune then trusts it. A project that never adds the patterns shows a permanently dirty
# tree after every sync, so init/sync add them instead of leaving each project to discover
# the rule the hard way.
#
# Idempotent by MEANING, not by exact line: a project that already ignores the artefact in
# any form is left alone, so re-running never accumulates near-duplicate patterns.
_ensure_generated_gitignore() {
  local root="${1:-.}"
  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  local gi="${root%/}/.gitignore"
  # E-290 (D-083 r2): .claude/settings.json now carries install-time ABSOLUTE hook paths
  # (exec-form hooks), i.e. it is machine-specific — generated
  # by `ai sync`, never committed. The role overlays (settings.<role>.json) stay tracked.
  # E-333 (D-102 §8): .ai/start.local.json is one developer's account binding.
  # E-342 (D-106 r2): .ai/.last-import-blob mirrors the index's last imported state.json blob.
  # E-343 (D-108 r9): .ai/ci.local.json is one machine's CI env allow-list (may hold values).
  local want=("**/_SKILLS_INDEX.md" "**/_SYNC_MANIFEST.json" ".ai/blueprints/_INDEX.md" ".claude/settings.json" ".ai/start.local.json" ".ai/.last-import-blob" ".ai/ci.local.json")
  local add=()
  local pat base
  for pat in "${want[@]}"; do
    base="${pat##*/}"
    # A base name shared with other files (settings.json) must match the WHOLE path: the
    # base-name test would read ANY other dir/settings.json line as already covering it.
    [[ "$base" == "settings.json" ]] && base="$pat"
    # Any non-comment line naming the artefact counts as already ignored.
    if [[ -f "$gi" ]] && grep -v '^[[:space:]]*#' "$gi" 2>/dev/null | grep -qF "$base"; then
      continue
    fi
    add+=("$pat")
  done
  # A gitignore line does not untrack a file git already tracks. Rewriting the user's index
  # from a sync is too invasive, so name the one command that finishes the job.
  if git -C "$root" ls-files --error-unmatch .claude/settings.json >/dev/null 2>&1; then
    echo "  ! .claude/settings.json is tracked but machine-specific since E-290 — untrack it:"
    echo "      git rm --cached .claude/settings.json && git commit -m 'Untrack generated .claude/settings.json'"
  fi
  [[ "${#add[@]}" -eq 0 ]] && return 0

  {
    # The LEADING newline here is load-bearing, not cosmetic: a .gitignore that does not
    # end in a newline would otherwise splice our header onto the project's last line,
    # silently rewriting THEIR rule into something else. Keep it.
    printf '\n# Rein generated artefacts — regenerated by `ai sync` (E-233 / D-060 §4).\n'
    printf '# Machine-local by construction; committing them produces a diff on every sync.\n'
    printf '%s\n' "${add[@]}"
  } >> "$gi" || return 1   # E-346: an unwritable .gitignore is FAILED, not "added"
  echo "  .gitignore: added ${#add[@]} Rein generated-artefact pattern(s)"
}

# _untrack_comm_gitignore — E-338 (D-104 r1): COMM.md is tracked, no opt-out. Remove the
# non-comment `COMM.md` pattern older templates wrote into .ai/.gitignore and touch nothing
# else in the file (the comment above it may stay). A project that re-adds it by hand is
# reported by `ai doctor` [COMM_IGNORED], not fought on every sync.
_untrack_comm_gitignore() {
  local gi="${1:-.}/.ai/.gitignore" tmp
  [[ -f "$gi" ]] || return 0
  grep -qxE '[[:space:]]*/?COMM\.md[[:space:]]*' "$gi" || return 0
  tmp="${gi}.e338.$$"
  awk '!/^[[:space:]]*\/?COMM\.md[[:space:]]*$/' "$gi" > "$tmp" && mv "$tmp" "$gi" || { rm -f "$tmp"; return 1; }
  echo "  .ai/.gitignore: removed COMM.md — the handoff channel is tracked now (D-104)"
}

# _report_policy_staleness — name any MCP server process that started before the policy
# modules were last written (E-237 / D-061 §5).
#
# The comparison is START TIME vs FILE mtime, because that is what actually decides whether
# a running process can have the new policy: a server older than the file cannot have
# imported it, hot-reload or not. Reported per server rather than as one global verdict, so
# the operator knows which pane to restart.
#
# Fail-open throughout: this is a NOTICE. A diagnostic that can break `ai sync` is worse
# than no diagnostic.
_report_policy_staleness() {
  command -v python3 >/dev/null 2>&1 || return 2
  local newest=0 f
  for f in "${REIN}/shared/traversal-policy.mjs" "${REIN}/shared/markdown-exec.mjs" \
           "${REIN}/mcp/safe-exec-mcp/architect-writes.mjs" "${REIN}/mcp/shared/caller-role.mjs"; do
    [[ -f "$f" ]] || continue
    local m
    m="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)"
    [[ "${m:-0}" -gt "$newest" ]] && newest="$m"
  done
  [[ "$newest" -eq 0 ]] && return 0

  # E-346 (D-109 r3): the scan's exit status is kept and its stderr reaches the step's log —
  # it was `2>/dev/null || true`, so a crashing scan read as "no stale servers". No `ps` on
  # the host is the one by-design skip (exit 2).
  local stale _prc=0
  stale="$(NEWEST="$newest" python3 - <<'PY'
import os, re, subprocess, time
newest = int(os.environ.get("NEWEST", "0"))
try:
    out = subprocess.run(["ps", "-axo", "pid=,etime=,command="],
                         capture_output=True, text=True, timeout=5).stdout
except Exception:
    raise SystemExit(2)

def secs(et):
    et = et.strip()
    d, _, rest = et.partition("-")
    if not rest:
        rest, d = d, "0"
    parts = [int(x) for x in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return int(d) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]

now = time.time()
names = []
for line in out.splitlines():
    m = re.match(r"\s*(\d+)\s+(\S+)\s+(.*)$", line)
    if not m:
        continue
    pid, et, cmd = m.group(1), m.group(2), m.group(3)
    if "/mcp/" not in cmd or "node" not in cmd:
        continue
    try:
        started = now - secs(et)
    except Exception:
        continue
    if started < newest:
        srv = re.search(r"/mcp/([^/]+)/", cmd)
        names.append((srv.group(1) if srv else "mcp-server") + " (pid " + pid + ")")

for n in sorted(set(names)):
    print(n)
PY
)" || _prc=$?
  [[ "$_prc" -eq 0 ]] || return "$(( _prc == 2 ? 2 : 1 ))"
  [[ -z "$stale" ]] && return 0
  echo ""
  echo "Note: these MCP servers started before the policy modules were last written:"
  # E-244: this was `printf '  %s\n' $stale` — unquoted, so bash word-split each
  # "advisor-mcp (pid 123)" into three lines and the note rendered as a column of
  # fragments. It shipped in E-237 and nobody ever saw it, because its only call site
  # sat in the unreachable tail of do_sync. Restoring the tail is what put it on screen.
  local _stale_line
  while IFS= read -r _stale_line; do
    [[ -n "$_stale_line" ]] && echo "  ${_stale_line}"
  done <<< "$stale"
  echo "  They hot-reload policy per request (E-237), so no action is needed unless one was"
  echo "  started before E-237 shipped — in that case restart it, or the session, to clear"
  echo "  stale verdicts (REIN_POLICY_HOT_RELOAD=0 disables hot reload entirely)."
}

# ── E-249 (D-067 §3): booted-build staleness ──────────────────────────────────
#
# The neighbour above (E-237's policy note) answers a DIFFERENT question and must not be
# confused with this one. That note lists servers older than the four HOT-RELOADED policy
# modules, and its own text says no action is needed. This one lists servers whose booted
# build no longer matches what is on disk at all — state-db, the projectors, every handler
# — and those are NOT hot-reloaded by ruling (D-067 §3 refusal): they must be restarted.
#
# The scan itself lives in src/shared/build-stamp.mjs so there is exactly one definition of
# "stale" in the tree; this is a thin printer. It never fails the sync: staleness is an
# announcement, and the CLI it calls always exits 0 for the same reason.
# The raw `[STALE_SERVER] …` lines, indented, or nothing. Two callers frame them
# differently (sync explains the restart, doctor reports the clean case), so the SCAN is
# shared and the prose is not.
#
# E-346 (D-109 r3): 0 = scanned, 2 = cannot scan (no node / no probe), 1 = the probe failed
# (its stderr inherited). The probe always exits 0 by design, so a non-zero is a crash; it
# was `2>/dev/null || true` and a crashed scan printed "every server booted the build".
_stale_server_lines() {
  command -v node >/dev/null 2>&1 || return 2
  local probe; probe="$(rein_locate shared/build-stamp.mjs 2>/dev/null || true)"
  [[ -n "${probe:-}" && -f "$probe" ]] || return 2
  local out; out="$(node --no-warnings "$probe" --stale)" || return 1
  [[ -z "$out" ]] && return 0
  local _l
  while IFS= read -r _l; do
    [[ -n "$_l" ]] && echo "  ${_l}"
  done <<< "$out"
}

_report_stale_servers() {
  command -v node >/dev/null 2>&1 || return 2

  local lines _src=0
  lines="$(_stale_server_lines)" || _src=$?
  [[ "$_src" -eq 0 ]] || return "$_src"
  [[ -z "$lines" ]] && return 0

  echo ""
  echo "Stale MCP servers (E-249) — these booted a build that is no longer on disk:"
  printf '%s\n' "$lines"
  echo "  Unlike the policy note above, these do NOT hot-reload (D-067 §3): state-db and the"
  echo "  projectors are never swapped mid-process. Restart the MCP servers — in Claude Code,"
  echo "  /mcp then restart, or restart the session."
  echo "  Rollback: REIN_BUILD_STAMP=0 suppresses this check."
}

# ── E-247 (D-067 §1): fail-open step wrapper for the second half of `ai sync` ──
#
# Every step in sync's tail was designed to be fail-open — each one already guards its own
# work and returns 0 on trouble. That was not enough twice over. First, the steps became
# UNREACHABLE (E-217's early return) and their internal fail-open behaviour proved nothing,
# because they never ran. Second, a trial restore (E-244, reverted) still made `ai sync`
# exit 1 under `set -e`: one step's internal guard was not as complete as its comment
# claimed, and under `set -euo pipefail` that killed the whole command.
#
# So the guarantee is moved OUT of the individual steps and made structural. `"$@"` runs as
# an `if` condition, where `set -e` is suspended by definition, so no step — however it is
# edited later — can abort the sync. A failure is reported and counted; it is never silent
# and never fatal.
#
# The counters are plain globals on purpose: _sync_step is called directly from do_sync, not
# through a command substitution, so they survive. (A `$( )` here would put them in a
# subshell and every count would come back zero — the subshell-state mistake this codebase
# has now made four times, recorded as review question #4.)
#
# E-339 (D-107 r1): three outcomes, read from the step's return code — 0 ok, 2 skipped by
# design (the tool is absent or disabled by its env var), anything else FAILED. Before, a
# failure was counted as a "skip" and a step that swallowed its own error counted as "ok",
# so a sync that left REPO_MAP unbuilt and the gate broken still ended "13 ok". Each step's
# stderr is captured to a log: replayed (and the log removed) when the step is ok or
# skipped, kept and summarised on one ✗ line when it failed.
#
# E-346 (D-109 r2): the log is `mktemp "${TMPDIR:-/tmp}/ai-sync-<step>.<pid>.XXXXXX"`. E-339's
# fixed `ai-sync-<step>.<pid>.log` could be pre-planted as a symlink in a shared /tmp, and
# `2>` follows it. The `.<pid>` stays so a human can find one run's logs. mktemp failing is
# the step FAILING with [LOG_UNAVAILABLE] — the step is not run without a place for its
# stderr. Kept logs are reaped by the first step of the next sync once they are a day old.
_SYNC_STEPS_OK=0
_SYNC_STEPS_SKIPPED=0
_SYNC_STEPS_FAILED=0

# _sync_step <name> <command...> — run one sync step, never fatally.
_sync_step() {
  local name="$1"; shift
  local log _rc=0 last
  if ! log="$(mktemp "${TMPDIR:-/tmp}/ai-sync-${name}.$$.XXXXXX" 2>/dev/null)"; then
    echo "  ✗ ${name}: [LOG_UNAVAILABLE] cannot create a log under ${TMPDIR:-/tmp} — step not run" >&2
    _SYNC_STEPS_FAILED=$(( _SYNC_STEPS_FAILED + 1 ))
    return 0
  fi
  # Test hook for the fail-open property itself. Asserting "a broken step does not abort
  # the sync" needs a step that actually breaks, and breaking a real one from a test means
  # corrupting the environment it reads. Named after the task so it cannot be mistaken for
  # a feature. The forced failure is a real process run through the same capture path.
  if [[ "${REIN_E247_FORCE_FAIL:-}" == "$name" ]]; then
    set -- bash -c 'echo "forced failure (REIN_E247_FORCE_FAIL=$1)" >&2; exit 1' _ "$name"
  fi
  "$@" 2>"$log" || _rc=$?
  case "$_rc" in
    0|2)
      [[ -s "$log" ]] && cat "$log" >&2
      rm -f "$log"
      if [[ "$_rc" -eq 0 ]]; then _SYNC_STEPS_OK=$(( _SYNC_STEPS_OK + 1 ))
      else _SYNC_STEPS_SKIPPED=$(( _SYNC_STEPS_SKIPPED + 1 )); fi ;;
    *)
      # E-346: `|| :` — a step that failed with NO stderr made grep exit 1, pipefail carried it
      # and set -e killed the whole sync here, so its own "no stderr" fallback was unreachable.
      # E-352 (D-112 r6): a [REAP_FAILED] cause is printed whole — the reason sat past char 200.
      last="$( { grep -v '^[[:space:]]*$' "$log" 2>/dev/null || :; } | tail -1)"
      [[ "$last" == "[REAP_FAILED] "* ]] || last="${last:0:200}"
      echo "  ✗ ${name}: ${last:-exited ${_rc} with no stderr} (log: ${log})" >&2
      _SYNC_STEPS_FAILED=$(( _SYNC_STEPS_FAILED + 1 )) ;;
  esac
  return 0
}

# E-346 (D-109 r2): the first sync step — remove the caller's own failed-step logs older than
# 24 h. Only regular files named by _sync_step's template (`ai-sync-*.??????`) and owned by
# the caller: never anyone else's, never a newer one (a concurrent sync's), never a symlink.
_sync_reap_step_logs() {
  local d="${TMPDIR:-/tmp}"
  [[ -d "$d" ]] || return 2
  find "$d" -maxdepth 1 -type f -name 'ai-sync-*.??????' -user "$(id -u)" -mmin +1440 -delete
}

# E-339 (D-107 r3/r4): the last sync step — is the gate this sync leaves behind able to give
# a verdict? Runs `true` through the mirror's analyzer exactly as hooks/pre-tool-use.sh does
# (shared/gate-probe.sh). Never repairs: reinstalling the gate is the operator's action.
_sync_gate_check() {
  local gp st
  gp="$(_rein_helper shared/gate-probe.sh || true)"
  [[ -n "$gp" ]] || { echo "[SAFE_EXEC_BROKEN] shared/gate-probe.sh not found — run: bash install-rein.sh" >&2; return 1; }
  # shellcheck source=src/shared/gate-probe.sh
  . "$gp"
  if st="$(rein_gate_probe)"; then
    echo "  ✓ safe-exec gate: ${st}"
    return 0
  fi
  echo "[SAFE_EXEC_BROKEN] ${st} — run: bash install-rein.sh" >&2
  return 1
}

# E-342 (D-106 r2): bring the index up to what HEAD tracks — the pulled record files of a
# team project, HEAD:.ai/state.json of a legacy one — before the steps below regenerate a
# view from it. The import never fails; its lines are the step's output.
_sync_state_import() {
  local cs out
  [[ -d .ai ]] || return 2
  cs="$(_rein_helper shared/cli-state.mjs || true)"
  [[ -n "$cs" ]] && command -v node >/dev/null 2>&1 || return 2
  out="$(node --no-warnings "$cs" state import)" || return 1
  [[ -n "$out" ]] && printf '%s\n' "$out" | sed 's/^/  /'
  return 0
}

# E-270 (D-074 §Components 1): `ai sync` keeps its scope but records the installed version
# through the same helper as `ai init`. Silent when the stamp is already current.
_sync_stamp_version() {
  local k f d rc=0
  while IFS=$'\t' read -r k f d; do
    case "$k" in
      stamped) echo "  Stamped ${d}" ;;
      error)   echo "  ⚠  version not stamped — ${f}: ${d}"; rc=1 ;;
    esac
  done < <(_upgrade_records stamp)
  return "$rc"
}

# E-383 (D-132 r4, rein-rename.md §Component 4): the pre-rename lines in .ai/.gitattributes
# and .ai/.gitignore, one `merged` line per file. Silent when nothing carries the old name.
_sync_rename_legacy() {
  local k f d rc=0
  while IFS=$'\t' read -r k f d; do
    case "$k" in
      merged) echo "  Merged ${f}: ${d}" ;;
      error)  echo "  ⚠  ${f}: ${d}"; rc=1 ;;
    esac
  done < <(_upgrade_records rename)
  return "$rc"
}

# _sync_reap_moved <json> — the number of entries `ai-clean.mjs apply --json` moved.
# E-346 (D-109 r3): both reapers parsed this with `|| echo 0`, so a crashing reaper counted as
# ok. Output that is not the helper's JSON object is "[REAP_BAD_OUTPUT] <first 200 chars>"
# and the step FAILS. Parsed with node: the reapers already require it, python3 they do not.
_sync_reap_moved() {
  local n
  if n="$(printf '%s' "$1" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
    try{const j=JSON.parse(s);if(!j||typeof j!=="object"||Array.isArray(j))throw 0;
        const m=j.moved===undefined?[]:j.moved;if(!Array.isArray(m))throw 0;console.log(m.length)}
    catch{process.exit(1)}})' 2>/dev/null)"; then
    printf '%s' "$n"
    return 0
  fi
  echo "[REAP_BAD_OUTPUT] ${1:0:200}" >&2
  return 1
}

# _sync_reap_failure <stdout> — ai-clean reports a failed move in its JSON, not on stderr; put
# the first one on stderr so the ✗ line names it — whole, its newlines folded onto one line
# (E-352). Silent when there is none (a crash has already written its own stderr).
_sync_reap_failure() {
  printf '%s' "$1" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
    try{const f=JSON.parse(s).failures;if(Array.isArray(f)&&f.length)console.error("[REAP_FAILED] "+String(f[0]).replace(/\s*\n\s*/g," "))}catch{}})' || :
}

# D-099 (E-322): the project-side leftovers of the removed watcher — its lock, the signal
# queue and the queue's write lock — are reaped on every sync, through `ai clean`'s mover
# (trash + manifest, restorable) and with --project, so the project's LOG.md records it.
# Each entry is guarded by the watcher's own pid: a watcher still running from an older
# install keeps all three until it exits.
_sync_reap_watcher_state() {
  local h out n
  h="$(_rein_helper shared/ai-clean.mjs || true)"
  [[ -n "$h" ]] && command -v node >/dev/null 2>&1 || return 2
  [[ "${REIN_CLEAN_DISABLE:-0}" == "1" ]] && return 2
  [[ -d .ai ]] || return 0
  # E-346 (D-109 r3): stderr inherited (the step captures it), exit status kept.
  out="$(node "${_CI_NODE_FLAGS[@]}" "$h" apply --project "$PWD" --scope project \
          --only watcher-lock,watcher-signal-queue,watcher-signal-lock --json)" \
    || { _sync_reap_failure "$out"; return 1; }
  n="$(_sync_reap_moved "$out")" || return 1
  [[ "$n" != "0" ]] && echo "  Removed ${n} leftover(s) of the retired ai watch (restore: ai clean --restore $(date -u +%Y-%m-%d))"
  return 0
}

# E-273 (D-074 §Components 5): dead ~/.rein/run/ records are reaped on every sync — the
# two registry entries only (dead-role-lock, dead-build-record), through `ai clean`'s own
# mover, so they land in the trash with a manifest like any other removal. No --project:
# a sync must not append to the project's LOG.md for housekeeping in HOME.
_sync_reap_run_records() {
  local h out n
  h="$(_rein_helper shared/ai-clean.mjs || true)"
  [[ -n "$h" ]] && command -v node >/dev/null 2>&1 || return 2
  [[ "${REIN_CLEAN_DISABLE:-0}" == "1" ]] && return 2
  out="$(node "${_CI_NODE_FLAGS[@]}" "$h" apply --only dead-role-lock,dead-build-record --json)" \
    || { _sync_reap_failure "$out"; return 1; }   # E-346
  n="$(_sync_reap_moved "$out")" || return 1
  [[ "$n" != "0" ]] && echo "  Reaped ${n} dead ~/.rein/run/ record(s) (restore: ai clean --restore $(date -u +%Y-%m-%d))"
  return 0
}

# _sync_install_hooks — this project's git-hook stubs + legacy upgrade, as one step.
#
# (Re)install this project's git-hook stubs so commits run the canonical Rein hooks, and
# upgrade any legacy copied .git/hooks/* to the stub model (E-41) so there is no
# copy-by-value drift.
#
# E-304 (D-089 r2): `ai sync` NEVER writes into ~/.rein. It used to copy
# ${REIN_WORKSPACE}/hooks/*.sh into the mirror — hooks WITHOUT the mcp/ and shared/ they call
# — and on 2026-10-04 that put E-294's uncommitted hooks live machine-wide twice, against the
# old safe-exec, so every project's commits hit the Architect lane. `bash install-rein.sh`
# is the one installer.
_sync_install_hooks() {
  install_git_hooks
  _upgrade_legacy_git_hooks
  return 0
}


do_sync() {
  # §28: handle --github flag before normal sync
  for arg in "$@"; do
    if [[ "$arg" == "--github" ]]; then
      do_sync_github "$@"
      return
    fi
  done

  # E-244 (D-066 §4): pruning is opt-in per invocation and never implied by anything
  # else. `ai sync` is run reflexively; a flag that deletes directories has to be typed.
  local PRUNE_PROVIDERS=0
  for arg in "$@"; do
    [[ "$arg" == "--prune-providers" ]] && PRUNE_PROVIDERS=1
  done

  # Sync project-scoped dirs only — global ~/.claude is user-owned (§21)
  if [[ -d ".ai" ]]; then
    echo "Syncing project-scoped .claude/ from ${REIN} ..."

    # Always update bootloaders so skill invocation stays current (D-050/E-183:
    # canonical ENGINEER.md/ARCHITECT.md + the CLAUDE.md @import shim).
    local T="${REIN}/templates"
    cp -f "$T/ENGINEER.md"  "ENGINEER.md"  && echo "  ENGINEER.md updated (canonical bootloader)"
    cp -f "$T/ARCHITECT.md" "ARCHITECT.md" && echo "  ARCHITECT.md updated (canonical bootloader)"
    cp -f "$T/CLAUDE.md"    "CLAUDE.md"    && echo "  CLAUDE.md updated (shim → ENGINEER.md)"

    # Always regenerate .mcp.json to pick up new servers; user-added servers and env on
    # ours are carried over (E-274; see generate_mcp_json).
    generate_mcp_json "." && echo "  .mcp.json updated (MCP server registry)"

    # .claude/ — the project-scoped workspace (v3.0 W3-T3: shared helper).
    _sync_workspace_dirs sync
    if [[ "${SKILL_COLLISIONS:-0}" -gt 0 ]]; then
      echo "" >&2
      echo "ai sync: ${SKILL_COLLISIONS} unresolved skill-name collision(s) — see the errors above." >&2
      echo "  A provider serving BOTH roles cannot hold two different skills under one name," >&2
      echo "  and sync cannot know which role the reading pane holds. Rename the role-specific" >&2
      echo "  skill (D-055 R2 precedent: arch-task, arch-oracle, arch-review)." >&2
      return 1
    fi
    # E-244: explicit provider-workspace pruning, after provisioning so a workspace that
    # was just (re)synced for a live binding is never a candidate. Reporting is the
    # default; deleting requires the flag.
    if [[ "$PRUNE_PROVIDERS" -eq 1 ]]; then
      echo ""
      echo "Pruning provider workspaces no role is bound to (--prune-providers) ..."
      _prune_provider_workspaces
    else
      _report_stale_provider_workspaces
    fi

    # ── E-247 (D-067 §1): the second half of sync, restored under fail-open guards ──
    #
    # Everything below this line was UNREACHABLE from E-217 until now. E-217 added a
    # `return 0` here to fix the exit status — do_sync used to return whatever ran last,
    # and a stray 128 from `git rev-parse` in a non-git directory made a clean sync look
    # like a failure — but placing it before these steps silently retired nine ruled
    # features in a command people run after every pull. Nothing failed; `ai sync` simply
    # stopped printing "Done." and no one was watching for a missing line.
    #
    # EVERY STEP IS WRAPPED. Each was written to be fail-open, and a first restore attempt
    # (E-244, reverted) still managed to make `ai sync` exit 1 under `set -e`. The wrapper
    # makes that impossible to reach the caller: a step that fails prints
    # `sync: <name> skipped — <reason>` and the rest continue. The exit status is settled
    # once, at the end, so the property E-217 wanted survives.
    if [[ "${REIN_SYNC_MINIMAL:-0}" == "1" ]]; then
      echo ""
      echo "  Stopping after provisioning (REIN_SYNC_MINIMAL=1) — hooks, doc regeneration,"
      echo "  the WAL checkpoint, REPO_MAP, the Memory Palace index and the policy report"
      echo "  were NOT run. Unset it to complete a full sync."
      return 0
    fi

    echo ""
    _SYNC_STEPS_OK=0
    _SYNC_STEPS_SKIPPED=0
    _SYNC_STEPS_FAILED=0

    _sync_step log_reap        _sync_reap_step_logs      # E-346 (D-109 r2): FIRST — before this run writes its own
    _sync_step hooks           _sync_install_hooks
    _sync_step mcp_docs        _regenerate_mcp_docs
    _sync_step blueprint_index _regenerate_blueprints_index
    _sync_step wal             _wal_checkpoint_state_db
    _sync_step state_import    _sync_state_import         # E-342 (D-106 r2): before anything writes a view
    _sync_step rename_legacy   _sync_rename_legacy        # E-383 (D-132 r4): until 0.5
    _sync_step version_stamp   _sync_stamp_version
    _sync_step run_reap        _sync_reap_run_records
    _sync_step watcher_reap    _sync_reap_watcher_state
    _sync_step repo_map        _generate_repo_map
    _sync_step memory_palace   _generate_memory_palace
    _sync_step gitignore       _ensure_generated_gitignore "."
    _sync_step comm_tracked    _untrack_comm_gitignore "."   # E-338 (D-104 r1)
    _sync_step policy_report   _report_policy_staleness
    _sync_step stale_servers   _report_stale_servers
    _sync_step classifier      _classifier_refresh_all   # E-318 (D-097): replace-only, every account
    _sync_step gate_check      _sync_gate_check          # E-339 (D-107 r3): LAST — the gate we leave behind

    # The summary is what makes a silent loss loud. "Done." on its own returned in E-217's
    # shape too — a function reaching its end says nothing about how much of it ran, which
    # is precisely how nine steps went missing without a symptom.
    if [[ "$_SYNC_STEPS_FAILED" -gt 0 ]]; then
      echo "Done. (steps: ${_SYNC_STEPS_OK} ok, ${_SYNC_STEPS_SKIPPED} skipped, ${_SYNC_STEPS_FAILED} FAILED — see the ✗ lines)"
    elif [[ "$_SYNC_STEPS_SKIPPED" -gt 0 ]]; then
      echo "Done. (steps: ${_SYNC_STEPS_OK} ok, ${_SYNC_STEPS_SKIPPED} skipped)"
    else
      echo "Done. (steps: ${_SYNC_STEPS_OK} ok)"
    fi
    # E-228 (D-059): only when the project can actually use it — printing a tmux hint on a
    # host without tmux is noise that teaches the reader to ignore the line.
    if command -v tmux >/dev/null 2>&1; then
      echo "Tip: 'ai start' opens the Triad layout for this project (--status / --kill)."
    fi

    # Explicit success: without it do_sync returns the status of whatever ran last, which
    # picked up a stray 128 from a `git rev-parse` in a non-git directory and made a clean
    # sync look like a failure. It now sits AFTER the steps rather than before them, which
    # is the whole of E-247. E-339 (D-107 r1): the one non-zero it may return is the
    # deliberate one — a step FAILED, and every step still ran first.
    [[ "$_SYNC_STEPS_FAILED" -gt 0 ]] && return 1
    return 0
  else
    echo "  Not in a Rein project (.ai/ not found) — nothing to sync."
    echo "  Run 'ai init' first to scaffold .ai/ and .claude/."
    exit 0
  fi

}

# ── E-215 (architect-provider-parity.md §Components 6): per-role provisioning ──
# Answers the question a same-provider Triad actually raises: "is the pane bound to
# THIS role actually equipped for it?" Provisioning is role-aware as of E-212, so a
# per-provider view is no longer enough — one provider dir can serve two roles, and a
# role can be bound to a provider whose workspace was never synced for it.
#
# Purely diagnostic: reads only, changes nothing, and never fails the doctor run.
_report_role_provisioning() {
  [[ -d ".ai" ]] || return 0
  command -v node >/dev/null 2>&1 || return 0
  local rm; rm="$(_locate_role_manifest || true)"
  [[ -n "$rm" ]] || return 0

  echo "Per-role provisioning (E-215):"

  local roles_json=".ai/roles.json"
  if [[ ! -f "$roles_json" ]]; then
    echo "  ! .ai/roles.json missing — falling back to the D-050 defaults (architect=claude, engineer=claude)"
  fi

  # Role -> provider straight from roles.json, defaults applied by the shared helper.
  local role provider ws skills_dir agents_dir rulefile n_sk n_ag
  for role in architect engineer; do
    provider="$(node --no-warnings -e '
const { pathToFileURL } = require("node:url");
import(pathToFileURL(process.argv[1]).href).then(m =>
  process.stdout.write(m.roleProvider(".ai", process.argv[2]) || ""));
' "${REIN}/shared/provider-adapter.mjs" "$role" 2>/dev/null || true)"
    [[ -z "$provider" ]] && provider="(unmapped)"

    # Vendor workspace for that provider (D-052 keeps these vendor-named).
    case "$provider" in
      claude) ws=".claude" ;;
      *)      ws="" ;;
    esac

    echo "  ${role} → ${provider}"
    if [[ -z "$ws" ]]; then
      echo "      ! no known workspace directory for provider '${provider}'"
      continue
    fi

    # Skills: does the workspace hold this role's skill set?
    skills_dir="${ws}/skills"
    if [[ -d "$skills_dir" ]]; then
      n_sk="$(find "$skills_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d " ")"
      echo "      ✓ skills   ${skills_dir} (${n_sk})"
    else
      echo "      ✗ skills   ${skills_dir} missing — run: ai sync"
    fi

    # Agents
    agents_dir="${ws}/agents"
    if [[ -d "$agents_dir" ]]; then
      n_ag="$(find "$agents_dir" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l | tr -d " ")"
      echo "      ✓ agents   ${agents_dir} (${n_ag})"
    else
      echo "      ✗ agents   ${agents_dir} missing — run: ai sync"
    fi

    # Settings overlay (E-208) — only meaningful for a claude-hosted role.
    if [[ "$provider" == "claude" ]]; then
      if [[ -f "${ws}/settings.${role}.json" ]]; then
        echo "      ✓ overlay  ${ws}/settings.${role}.json"
      else
        echo "      ✗ overlay  ${ws}/settings.${role}.json missing — run: ai sync"
      fi
    else
      echo "      - overlay  n/a for provider '${provider}'"
    fi

    # Rulefile, named by the registry manifest rather than hardcoded here.
    rulefile="$(node --no-warnings -e '
const { pathToFileURL } = require("node:url");
import(pathToFileURL(process.argv[1]).href).then(m =>
  process.stdout.write(m.rulefileForRole(process.argv[2], process.argv[3]) || ""));
' "${REIN}/shared/role-manifest.mjs" "${REIN}/config/registry.json" "$role" 2>/dev/null || true)"
    [[ -z "$rulefile" ]] && rulefile="$( [[ "$role" == "architect" ]] && echo ARCHITECT.md || echo ENGINEER.md )"
    if [[ -f "$rulefile" ]]; then
      echo "      ✓ rulefile ${rulefile}"
    else
      echo "      ✗ rulefile ${rulefile} missing — run: ai sync"
    fi
  done
  echo ""
}

# Flags for every ci-record.mjs call. Two notices would otherwise land on stderr, which
# `ai ci` callers (and the skills that inject `status --short`) see: state-db.js is ESM in
# a package.json without "type" (MODULE_TYPELESS_PACKAGE_JSON), and on Node 22 node:sqlite
# is still experimental (ExperimentalWarning — silent on Node 26, which is why the E-266
# suite passed locally and failed on the Node 22 runner).
_CI_NODE_FLAGS=(--disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning)

# _report_local_ci — one doctor line for HEAD's newest certifying ci_runs row.
_report_local_ci() {
  local sha helper line
  sha="$(git rev-parse --verify --quiet HEAD 2>/dev/null)" || { echo "  - not a git repository"; return 0; }
  helper="$(_rein_helper shared/ci-record.mjs || true)"
  if [[ -z "$helper" ]] || ! command -v node >/dev/null 2>&1; then
    echo "  ✗ local CI: ci-record.mjs or node unavailable — run: ai install"; return 0
  fi
  line="$(node "${_CI_NODE_FLAGS[@]}" "$helper" status --ai-dir ".ai" --sha "$sha" --short 2>/dev/null || true)"
  set -- $line
  case "${1:-}" in
    PASS) echo "  ✓ local CI: HEAD ${2} PASS ${3} ${4}" ;;
    FAIL|ERROR|SKIPPED) echo "  ✗ local CI: HEAD ${2} ${1} ${3} ${4} — run: ai ci log --failed" ;;
    DIRTY) echo "  ✗ local CI: HEAD ${2} has only a dirty run — run: ai ci run" ;;
    SHARD) echo "  ✗ local CI: HEAD ${3} has only shard run ${2} (E-386: a shard never certifies) — run: ai ci run" ;;
    *) echo "  ✗ local CI: no run for HEAD ${sha:0:7} — run: ai ci run" ;;
  esac
  # E-303: the test budget the next run is held to.
  line="$(node "${_CI_NODE_FLAGS[@]}" "$helper" budget --ai-dir ".ai" 2>/dev/null || true)"
  # E-366: the budget, then any [BUDGET_DRIFT] lines — one doctor line each.
  [[ -n "$line" ]] && printf '%s\n' "$line" | sed 's/^/  - /'
  # E-386 (D-135 r2): the census baseline a fresh hosted runner packs its lanes by.
  line="$(node "${_CI_NODE_FLAGS[@]}" "$helper" census-stale --ai-dir ".ai" --sha "$sha" 2>/dev/null || true)"
  case "$line" in
    STALE*) echo "  ✗ [CENSUS_BASELINE_STALE] ${line#STALE } full runs since tests/census-baseline.tsv — run: ai ci run, then commit it" ;;
    MISSING) echo "  - census baseline: none committed — the next green ai ci run writes tests/census-baseline.tsv" ;;
  esac
  return 0
}

# _report_hosted_ci — E-335 (D-103 r2): the provider, whether its wrapper is the current
# rendering, and an origin/team.json mismatch (a warning, never a block).
_report_hosted_ci() {
  local root helper
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  helper="$(_rein_helper shared/hosted-ci.mjs || true)"
  [[ -n "$helper" ]] && command -v node >/dev/null 2>&1 || { echo "  ✗ hosted check: hosted-ci.mjs or node unavailable — run: ai install"; return 0; }
  node --no-warnings "$helper" --root "$root" --doctor 2>/dev/null || echo "  ✗ hosted check: could not evaluate"
}

# _report_legacy_artefacts — the two E-272 doctor lines (D-074 §Component 6). Runs
# machine-wide: the mirror and HOME carry findings whether or not this directory is a
# project, and the count is the only reason an operator would think to run `ai clean`.
_report_legacy_artefacts() {
  local helper root=""
  helper="$(_rein_helper shared/ai-clean.mjs || true)"
  if [[ -z "$helper" ]] || ! command -v node >/dev/null 2>&1; then
    echo "  ✗ legacy artefacts: ai-clean.mjs or node unavailable — run: ai install"; return 0
  fi
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  local args=(); [[ -n "$root" ]] && args=(--project "$root")
  node "${_CI_NODE_FLAGS[@]}" "$helper" doctor ${args[@]+"${args[@]}"} 2>/dev/null \
    || echo "  ✗ legacy artefacts: the scan failed — run: ai clean"
}

# ── E-270 (D-074 §Components 6): the version and PATH doctor lines ───────────
# clone = package.json of the recorded framework workspace (install-rein.sh writes
# config/rein-workspace.txt); mirror = ~/.rein/VERSION; project = the stamp in .ai/.
_report_versions() {
  local ws="" clone="" mirror="" project="" pv
  [[ -f "${REIN}/config/rein-workspace.txt" ]] && ws="$(head -1 "${REIN}/config/rein-workspace.txt" 2>/dev/null)"
  [[ -n "$ws" ]] && clone="$(_pkg_version "${ws}/package.json" 2>/dev/null || true)"
  [[ -f "${REIN}/VERSION" ]] && mirror="$(head -1 "${REIN}/VERSION" 2>/dev/null | tr -d '[:space:]')"
  if [[ -d ".ai" ]]; then pv="$(_project_version)"; project="${pv:-unstamped}"; else project="-"; fi
  local line="clone ${clone:-?} · mirror ${mirror:-missing} · project ${project}"
  if [[ -z "$mirror" ]]; then
    echo "  ✗ version: ${line} — run: bash install-rein.sh"
  elif [[ -n "$clone" && "$clone" != "$mirror" ]]; then
    echo "  ✗ version: ${line} — the mirror is behind the clone; run: bash install-rein.sh"
  elif [[ "$project" != "-" && "$project" != "$mirror" ]]; then
    echo "  ✗ version: ${line} — run: ai init"
  else
    echo "  ✓ version: ${line}"
  fi
  _report_path_shadow
}

# `ai on PATH`: which binary a bare `ai` runs. Another `ai` earlier on PATH silently takes
# over every command — the installed one then never runs, whatever its version.
_real_path() {
  python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null || printf '%s\n' "$1"
}
_report_path_shadow() {
  local want="${REIN}/bin/ai" want_real first="" p r
  local -a others=()
  want_real="$(_real_path "$want")"
  local seen="|"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    r="$(_real_path "$p")"
    [[ "$seen" == *"|${r}|"* ]] && continue
    seen="${seen}${r}|"
    if [[ -z "$first" ]]; then first="$r"; else others+=("$p"); fi
  done < <(type -ap ai 2>/dev/null)
  # The `~` comes from a variable: bash 5.2 tilde-expands a literal `~` in a ${…/…/~}
  # replacement, which turned the short form back into $HOME on Linux (E-332).
  local tilde='~' short
  short="${want/#$HOME/$tilde}"
  if [[ -z "$first" ]]; then
    echo "  ✗ ai on PATH: not found — add: export PATH=\"\$HOME/.rein/bin:\$PATH\""
  elif [[ "$first" != "$want_real" ]]; then
    echo "  ✗ ai on PATH: ${short} (shadowed by ${first}) — remove it or put ~/.rein/bin first"
  elif [[ "${#others[@]}" -gt 0 ]]; then
    echo "  ✓ ai on PATH: ${short} (also on PATH, unused: ${others[*]})"
  else
    echo "  ✓ ai on PATH: ${short}"
  fi
}

doctor() {
  local REPAIR=0
  local COMPLIANCE=0
  local ENVCHECK=0
  for arg in "$@"; do
    [[ "$arg" == "--repair" ]]     && REPAIR=1
    [[ "$arg" == "--compliance" ]] && COMPLIANCE=1
    [[ "$arg" == "--env" ]]        && ENVCHECK=1
  done

  # E-109: --compliance audit mode (§32 verification-mcp)
  if [[ "$COMPLIANCE" -eq 1 ]]; then
    _run_compliance_audit
    return 0
  fi

  # E-175: --env deep environment + connectivity check (doctor-and-cache-optimizations.md)
  if [[ "$ENVCHECK" -eq 1 ]]; then
    _run_env_diagnostics
    return $?
  fi

  # v3.0: REPAIR is 0/1 — ${REPAIR:+} would fire on the string "0" (non-empty),
  # so the label always showed. Gate on the actual value instead.
  echo "Rein v${VERSION} — doctor$( [[ "$REPAIR" -eq 1 ]] && printf ' (--repair mode)' )"
  echo ""

  echo "Install root:  ${REIN}"
  echo "Bin:           ${REIN}/bin/ai"
  echo ""

  echo "PATH contains ~/.rein/bin?"
  if echo "$PATH" | tr ':' '\n' | grep -q "\.rein/bin"; then
    echo "  ✓ yes"
  else
    echo "  ✗ NO — add to shell: export PATH=\"\$HOME/.rein/bin:\$PATH\""
  fi
  echo ""

  # E-270 (D-074 §Components 6): one version, compared everywhere.
  echo "Version (clone · mirror · project):"
  _report_versions
  echo ""

  echo "Claude (Global — user-owned, not managed by Rein):"
  [[ -d "${HOME}/.claude" ]] && echo "  ✓ ~/.claude exists" || echo "  ✗ ~/.claude missing"
  echo ""

  # E-249 (D-067 §3): machine-level, so it runs whether or not this directory is a
  # project — the servers are shared across every project on the host. Doctor prints the
  # CLEAN case too: a diagnostic that is silent when healthy is indistinguishable from one
  # that did not run, which is the E-251 lesson applied to a report rather than a scan.
  echo "MCP server builds (E-249):"
  _stale_srv_rc=0
  _stale_srv_report="$(_stale_server_lines 2>&1)" || _stale_srv_rc=$?
  if [[ "$_stale_srv_rc" -eq 1 ]]; then
    echo "  ✗ the build-stamp scan failed: $(printf '%s' "$_stale_srv_report" | tail -1 | cut -c1-200)"
  elif [[ "$_stale_srv_rc" -eq 2 ]]; then
    echo "  ⚠ cannot check (node or shared/build-stamp.mjs missing — run: bash install-rein.sh)"
  elif [[ -n "$_stale_srv_report" ]]; then
    printf '%s\n' "$_stale_srv_report"
    echo "  These do NOT hot-reload (D-067 §3) — restart the MCP servers or the session."
  else
    echo "  ✓ every running server booted the build that is on disk"
  fi
  echo ""

  # E-339 (D-107 r3): the same probe sync's gate_check runs — `true` through the mirror's
  # analyzer, exactly as hooks/pre-tool-use.sh calls it.
  echo "Command gate:"
  _doctor_gate_report
  echo ""

  echo "Rename to Rein (E-383 — old names work until 0.5):"
  _doctor_rename_report
  echo ""

  # E-272 (D-074 §Component 6): what earlier versions left behind.
  echo "Legacy artefacts (ai clean):"
  _report_legacy_artefacts
  echo ""

  if [[ -d ".ai" ]]; then
    # E-53: flush state.sqlite WAL during diagnostics so doctor surfaces a
    # truthful WAL size and prevents bloat from accumulating between syncs.
    echo "SQLite WAL:"
    _wal_checkpoint_state_db || true   # E-339: returns 2 (skipped) / 1 (failed) for sync's counter
    echo ""

    _report_role_provisioning

    echo "Handoff channel (.ai/COMM.md):"
    _doctor_comm_report
    echo ""

    # E-372 (D-123) / E-379 (D-130): privacy. The automated writers redact what they write into
    # .ai/ and .claude/ (one line: how many writers, how many redactions today); the scan line
    # says whether the operator's lists are there. A missing list is a WARNING here — the
    # structural classes still apply — and stays a refusal at commit time.
    if [[ -d .ai ]]; then
      echo "Privacy:"
      _h="$(_rein_helper shared/publish-scan.mjs || true)"
      if [[ -z "$_h" ]]; then echo "  ✗ publish-scan.mjs not found — run: ai install"
      else
        echo "  $(node "${_CI_NODE_FLAGS[@]}" "$_h" privacy 2>&1 | head -1)"
        _scan="$(node "${_CI_NODE_FLAGS[@]}" "$_h" doctor "$PWD" 2>&1 | head -1)"
        case "$_scan" in
          "[PUBLISH_SCAN_OK]"*) echo "  ✓ ${_scan}" ;;
          *) echo "  ⚠ ${_scan} — warning: only the structural classes (address, home path, session, secret) are redacted; list names in .ai/publish-scan.local.json" ;;
        esac
      fi
      echo ""
    fi

    # E-266 (D-072): the local CI verdict for HEAD — the evidence "CI green" now means.
    echo "Local CI:"
    _report_local_ci
    _report_hosted_ci
    echo ""

    # E-244 (D-066 §4): a workspace for a provider no role is bound to is dead weight,
    # not a fault — reported, never repaired implicitly, and it does not fail the run.
    echo "Provider workspaces:"
    _stale_ws_report="$(_report_stale_provider_workspaces)"
    if [[ -n "$_stale_ws_report" ]]; then
      printf '%s\n' "$_stale_ws_report"
    else
      echo "  ✓ every provider workspace present serves a bound role"
    fi
    echo ""

    echo "Project-Scoped (.claude/):"
    if [[ -d ".claude/agents" ]]; then
      echo "  ✓ .claude/agents: $(ls ".claude/agents" | wc -l | tr -d ' ') files"
    else
      echo "  ✗ .claude/agents: missing — run: ai init"
    fi
    _doctor_rules_report
    _doctor_hook_form_report
    if [[ -d ".claude/skills" ]]; then
      echo "  ✓ .claude/skills: $(ls ".claude/skills" | wc -l | tr -d ' ') entries"
    else
      echo "  ✗ .claude/skills: missing — run: ai init"
    fi
    echo ""
  fi

  echo "Hooks:"
  if [[ -f "${HOME}/.rein/hooks/stop-hook.sh" ]]; then
    echo "  ✓ stop-hook.sh present (auto SESSION stamp)"
  else
    echo "  ✗ stop-hook.sh missing — run: ai install"
  fi
  if [[ -f "${HOME}/.rein/hooks/post-tool-log.sh" ]]; then
    echo "  ✓ post-tool-log.sh present (auto LOG append)"
  else
    echo "  ✗ post-tool-log.sh missing — run: ai install"
  fi
  if [[ -f "${HOME}/.rein/hooks/post-tool-use.sh" ]]; then
    echo "  ✓ post-tool-use.sh present (AQG: auto test gate)"
  else
    echo "  ✗ post-tool-use.sh missing — run: ai install"
  fi
  if [[ -f "${HOME}/.rein/hooks/pre-commit.sh" ]]; then
    echo "  ✓ pre-commit.sh present (Gate 2: Quality Gate)"
  else
    echo "  ✗ pre-commit.sh missing — run: ai install"
  fi
  # Check git hook in current repo
  if git rev-parse --git-dir &>/dev/null; then
    local pc_hook
    pc_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
    # E-41: match the installer's detection — the current execution stub
    # carries the REIN_STUB_MARKER, while legacy copies carry "Rein Gate 2".
    # Accept either so a correctly-installed stub is not reported missing.
    if [[ -f "$pc_hook" ]] && { _is_rein_stub "$pc_hook" || grep -qE "(Rein|AI-OS) Gate 2" "$pc_hook" 2>/dev/null; }; then  # rename:legacy-fallback
      echo "  ✓ .git/hooks/pre-commit: Gate 2 installed"
    else
      echo "  ✗ .git/hooks/pre-commit: Gate 2 NOT installed — run: ai init"
    fi
  fi
  echo ""

  echo "settings.json:"
  local settings
  if [[ -d ".ai" && -f ".claude/settings.json" ]]; then
    settings=".claude/settings.json"
    echo "  (Project-Scoped)"
  else
    settings="${HOME}/.claude/settings.json"
    echo "  (Global Fallback)"
  fi
  if [[ -f "$settings" ]]; then
    echo "  ✓ present"
    python3 -c "
import json
with open('$settings') as f:
    d = json.load(f)
env = d.get('env', {})
print('  agent teams:', env.get('CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS', 'NOT SET'))
hooks = d.get('hooks', {})
print('  Stop hook:', 'yes ✓' if hooks.get('Stop') else 'NO - run: ai install')
print('  PostToolUse hook:', 'yes ✓' if hooks.get('PostToolUse') else 'NO - run: ai install')
" 2>/dev/null || echo "  ✗ could not parse settings.json"
  else
    echo "  ✗ missing — run: ai install"
  fi
  echo ""

  echo "GitHub Copilot CLI:"
  if command -v gh &>/dev/null; then
    echo "  ✓ gh installed: $(gh --version 2>/dev/null | head -1)"
    if gh extension list 2>/dev/null | grep -q "github/gh-copilot"; then
      echo "  ✓ gh copilot extension installed"
    else
      echo "  ✗ gh copilot not installed — run: gh extension install github/gh-copilot"
    fi
  else
    echo "  ✗ gh not installed — run: brew install gh && gh auth login"
  fi
  [[ -f "${HOME}/.config/github-copilot/COPILOT.md" ]] \
    && echo "  ✓ COPILOT.md installed" \
    || echo "  ✗ COPILOT.md missing — run: ai install"
  echo ""

  echo "MCP Servers:"
  if command -v node &>/dev/null; then
    echo "  ✓ node $(node --version) (required for MCP servers)"
  else
    echo "  ✗ node not found — MCP servers need Node.js: brew install node"
  fi
  if command -v npx &>/dev/null; then
    echo "  ✓ npx available"
  else
    echo "  ✗ npx not found — install Node.js"
  fi

  # E-34: Per-server health check from registry
  local MCP_DIR="${REIN}/mcp"
  local REGISTRY="${REIN}/config/registry.json"
  if [[ -f "$REGISTRY" ]] && command -v python3 &>/dev/null; then
    echo "  Custom MCP servers (registry: ${REGISTRY}):"
    while IFS='|' read -r srv_name _; do
      [[ -z "$srv_name" ]] && continue
      local sdir="${MCP_DIR}/${srv_name}"
      if [[ ! -d "$sdir" ]]; then
        echo "    ✗ ${srv_name}: source missing at ${sdir} — run: ai install"
      elif [[ ! -f "${sdir}/package.json" ]]; then
        echo "    ✗ ${srv_name}: package.json missing"
      elif [[ ! -d "${sdir}/node_modules" ]]; then
        echo "    ✗ ${srv_name}: node_modules missing — run: ai mcp-setup"
      elif [[ ! -f "${sdir}/index.js" ]]; then
        echo "    ✗ ${srv_name}: index.js missing"
      else
        echo "    ✓ ${srv_name}"
      fi
    done < <(python3 -c "
import json
with open('$REGISTRY') as f:
    d = json.load(f)
for name, info in d.get('mcp_servers', {}).items():
    if 'path' in info:
        print(name + '|' + info['path'])
" 2>/dev/null || true)
  fi

  if [[ -f ".mcp.json" ]]; then
    echo "  ✓ .mcp.json present ($(pwd))"
    # Verify absolute paths in .mcp.json are valid
    python3 - <<'PY' 2>/dev/null || true
import json, os
with open(".mcp.json") as f:
    cfg = json.load(f)
broken = []
for name, srv in cfg.get("mcpServers", {}).items():
    for a in srv.get("args", []):
        if a.startswith("/") and not os.path.exists(a):
            broken.append(f"{name}: {a}")
if broken:
    for b in broken:
        print(f"    ✗ broken path — {b} — run: ai mcp-setup")
else:
    print("  ✓ .mcp.json paths: all valid")
PY
  else
    echo "  ✗ .mcp.json not found in $(pwd) — run: ai init"
  fi
  echo ""

  # ── E-235 (D-061 §3): browsers are opt-in, so say whether they are here ────
  echo "Vibe-check browsers (ai mcp-setup --browsers):"
  local _vdir="${REIN}/mcp/vibe-check-mcp"
  if [[ ! -d "$_vdir" ]]; then
    echo "  ⚠  vibe-check-mcp not installed"
  elif node --input-type=module -e "
    const { browserStatus } = await import('file://${_vdir}/browser-check.mjs');
    const { chromium } = await import('file://${_vdir}/node_modules/@playwright/test/index.js');
    process.exit(browserStatus(chromium).ok ? 0 : 1);
  " >/dev/null 2>&1; then
    echo "  ✓ Chromium present"
  else
    echo "  ✗ Chromium not installed — vibe-check tools will report [BROWSER_MISSING]"
    echo "    run: ai mcp-setup --browsers"
  fi
  echo ""

  # ── E-228 (D-059): is `ai start` actually usable here? ─────────────────────
  # Three things have to hold, and each fails differently, so each is reported
  # separately rather than as one "Triad: ok/not ok" verdict a reader cannot act on.
  # E-286: global (not project-scoped) — every project's hooks run this toolchain.
  echo "Hook toolchain (E-286):"
  _doctor_toolchain_report
  echo ""
  echo "Safe-exec gate override (E-291):"
  echo "  $(do_gate status 2>&1)"
  _classifier_report
  _launch_record_report
  _install_report
  _gate_pins_report
  echo ""
  echo "Triad launcher (ai start):"
  if command -v tmux >/dev/null 2>&1; then
    echo "  ✓ tmux present ($(tmux -V 2>/dev/null || echo 'version unknown'))"
  else
    echo "  ✗ tmux not found — 'ai start' exits 2 and prints the manual recipe instead"
  fi

  local _d_ai; _d_ai="$(_find_ai_dir 2>/dev/null)"
  # E-315 (accounts.md §3): the project's account, its directory and the login marker, one line.
  if [[ -n "$_d_ai" && -d "$_d_ai" ]] && declare -F _account_dir >/dev/null; then
    local _d_acfg _d_acct _d_adir
    if ! _d_acfg="$(_start_config "$_d_ai" 2>/dev/null)"; then
      echo "  ✗ account: .ai/start.json rejected — run 'ai start --dry-run' for the reason"
    else
      _d_acct="${_d_acfg##*|}"
      if [[ -z "$_d_acct" ]]; then
        echo "  ✓ account: default ($(_acct_tilde "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"), login: $(_acct_login ""))"
      elif _d_adir="$(_account_dir "$_d_acct" 2>/dev/null)"; then
        echo "  ✓ account: ${_d_acct} ($(_acct_tilde "$_d_adir"), login: $(_acct_login "$_d_adir"))"
      else
        echo "  ✗ account: ${_d_acct} does not resolve — $(_account_dir "$_d_acct" 2>&1 >/dev/null | sed 's/^ai: //')"
      fi
    fi
  fi
  if [[ -n "$_d_ai" && -f "${_d_ai}/roles.json" ]]; then
    local _d_roles _d_n
    _d_roles="$(_start_roles "$_d_ai" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
    _d_n="$(printf '%s' "$_d_roles" | wc -w | tr -d ' ')"
    if [[ "${_d_n:-0}" -gt 0 ]]; then
      echo "  ✓ roles mapped (${_d_n}): ${_d_roles}"
      # A role whose provider is not on PATH produces a pane that opens and then fails at
      # the first keystroke, which looks like a launcher bug rather than a missing binary.
      local _d_r _d_prov
      for _d_r in $_d_roles; do
        _d_prov="$(python3 -c "
import json,sys
try:
    d=json.load(open('${_d_ai}/roles.json'))
except Exception:
    sys.exit(0)
r=d.get('roles',{}).get('${_d_r}',{})
print(r.get('provider',''))
" 2>/dev/null)"
        if [[ -z "$_d_prov" ]]; then
          echo "    ? ${_d_r}: no provider recorded"
        elif command -v "$_d_prov" >/dev/null 2>&1; then
          echo "    ✓ ${_d_r} → ${_d_prov} (on PATH)"
        else
          echo "    ✗ ${_d_r} → ${_d_prov} NOT on PATH — its pane will open but the agent will not start"
        fi
      done
    else
      echo "  ✗ roles.json has no usable roles — run: ai init"
    fi
  else
    echo "  ✗ .ai/roles.json not found — run: ai init"
  fi
  echo ""

  # ── E-63: Deep Audit — Dependency Health + Connectivity Probe ──────────────
  echo "MCP Deep Audit (§19.1):"
  if [[ -f "$REGISTRY" ]] && command -v python3 &>/dev/null && command -v node &>/dev/null; then
    local deep_fail=0
    while IFS='|' read -r srv_name _; do
      [[ -z "$srv_name" ]] && continue
      local sdir="${MCP_DIR}/${srv_name}"
      [[ ! -d "$sdir" ]] && continue  # already reported above

      # Dependency health: npm list --depth=0 (exit code 0 = all satisfied)
      local npm_out
      npm_out=$(cd "$sdir" && npm list --depth=0 2>&1)
      if echo "$npm_out" | grep -q "missing\|UNMET\|invalid"; then
        echo "  ✗ ${srv_name}: dependency issues — run: ai mcp-setup"
        echo "      $(echo "$npm_out" | grep -E 'missing|UNMET|invalid' | head -3 | sed 's/^/      /')"
        deep_fail=1
      fi

      # Connectivity probe: node -c syntax check
      if [[ -f "${sdir}/index.js" ]]; then
        if ! node -c "${sdir}/index.js" &>/dev/null; then
          echo "  ✗ ${srv_name}: index.js syntax error (CRITICAL_FAILURE)"
          deep_fail=1
        fi
      fi

    done < <(python3 -c "
import json
with open('$REGISTRY') as f:
    d = json.load(f)
for name, info in d.get('mcp_servers', {}).items():
    if 'path' in info:
        print(name + '|' + info['path'])
" 2>/dev/null || true)

    # Registry ↔ .mcp.json path consistency check
    if [[ -f ".mcp.json" ]]; then
      python3 - <<'PY' 2>/dev/null || true
import json, os
REIN = os.path.expanduser("~/.rein")
with open(os.path.join(REIN, "config/registry.json")) as f:
    reg = json.load(f)
with open(".mcp.json") as f:
    mcp = json.load(f)
mcp_servers = mcp.get("mcpServers", {})
for name, info in reg.get("mcp_servers", {}).items():
    if name not in mcp_servers:
        print(f"  ✗ {name}: in registry but missing from .mcp.json — run: ai mcp-setup")
    elif "path" in info:
        args = mcp_servers[name].get("args", [])
        expected = os.path.join(REIN, "mcp", name, "index.js")
        if args and args[0] != expected:
            print(f"  ✗ {name}: .mcp.json path mismatch")
            print(f"      expected: {expected}")
            print(f"      actual:   {args[0]}")
PY
    fi

    [[ "$deep_fail" -eq 0 ]] && echo "  ✓ all MCP servers: dependencies OK, syntax OK, paths consistent"
  else
    echo "  — skipped (requires node + python3)"
  fi
  echo ""

  echo "Copilot repo instructions (.github/copilot-instructions.md in current dir):"
  if [[ -f ".github/copilot-instructions.md" ]]; then
    echo "  ✓ present (read automatically by GitHub Copilot Chat)"
  else
    echo "  ✗ not found in $(pwd) — run: ai init to scaffold it"
  fi
  echo ""

  echo "Orphaned v2 contracts (should be gone):"
  for f in 10_WORKFLOW.md 20_OWNERSHIP.md 30_TOKEN_DISCIPLINE.md 40_SECURITY.md 50_DEVOPS.md 60_SEO_COMPLIANCE.md; do
    if [[ -f "${REIN}/contracts/$f" ]]; then
      echo "  ✗ ORPHAN: ${REIN}/contracts/$f — run: ai install to remove"
    fi
  done
  echo "  (if nothing listed above, contracts are clean ✓)"
  echo ""

  # E-344 (D-108 r8): the INDEX compared with HEAD:.ai/state.json, the working state.json and
  # TASKS.md — observed, never seeded. The import is named whenever a lossless source holds
  # tasks; migrate-state only when the view is all there is. --repair runs the import.
  echo "State Health (.ai/state.sqlite):"
  local _sh
  _sh="$(_rein_helper shared/cli-state.mjs || true)"
  if [[ -d ".ai" ]] && [[ -n "$_sh" ]] && command -v node &>/dev/null; then
    node --no-warnings "$_sh" state health $( [[ "$REPAIR" -eq 1 ]] && printf -- '--repair' ) 2>&1 \
      || echo "  ✗ state health check failed"
  else
    echo "  — skipped (not in a project dir, or node / cli-state.mjs missing)"
  fi
  echo ""

  # E-341 (D-105 r1, r4): a team project's trunk — advisory, never edits the tracked team.json.
  if [[ -f ".ai/team.json" ]] && command -v node &>/dev/null; then
    local _tr _trl
    _tr="$(_rein_helper shared/cli-state.mjs || true)"
    if [[ -n "$_tr" ]]; then
      echo ""
      echo "Team trunk (.ai/team.json):"
      _trl="$(node --no-warnings "$_tr" trunk --doctor 2>/dev/null || true)"
      if [[ -n "$_trl" ]]; then printf '  %s\n' "$_trl"; else echo "  ✓ trunk $(node --no-warnings "$_tr" trunk 2>/dev/null || echo '?')"; fi
    fi
  fi

  # E-94: --repair mode — fix detected issues automatically
  if [[ "$REPAIR" -eq 1 ]]; then
    echo ""
    echo "Repair Mode — fixing detected issues..."
    echo ""
    local MCP_DIR="${REIN}/mcp"
    local REGISTRY="${REIN}/config/registry.json"

    # Re-run npm install for all registered MCP servers with missing/broken deps
    if [[ -f "$REGISTRY" ]] && command -v node &>/dev/null && command -v python3 &>/dev/null; then
      while IFS='|' read -r srv_name _; do
        [[ -z "$srv_name" ]] && continue
        local sdir="${MCP_DIR}/${srv_name}"
        [[ ! -d "$sdir" ]] && continue
        if [[ ! -d "${sdir}/node_modules" ]] || (cd "$sdir" && npm list --depth=0 2>&1 | grep -q "missing\|UNMET\|invalid"); then
          echo "  → npm install: ${srv_name}..."
          (cd "$sdir" && npm install --silent 2>&1) && echo "    ✓ done" || echo "    ✗ failed"
        fi
      done < <(python3 -c "
import json
with open('$REGISTRY') as f:
    d = json.load(f)
for name, info in d.get('mcp_servers', {}).items():
    if 'path' in info:
        print(name + '|' + info['path'])
" 2>/dev/null || true)
    fi

    # Realign .mcp.json if present
    if [[ -f ".mcp.json" ]]; then
      echo "  → realigning .mcp.json..."
      generate_mcp_json && echo "    ✓ .mcp.json realigned" || echo "    ✗ realign failed"
    fi

    echo ""
    echo "Repair complete. Run: ai doctor to verify."
  fi
}

# E-175: Deep environment & connectivity diagnostics (doctor-and-cache-optimizations.md
# §Components 1-2). Verifies the host can actually run Rein — Node 22+, essential
# global binaries, read/write bits on the framework + project
# state dirs — then probes live MCP connectivity via the E-176 mcp-tester. Exits 1 if any
# CRITICAL check fails (Node version, state-db write access, ~/.rein access, MCP boot);
# missing-but-optional tooling (gh/tmux) is a non-fatal [WARN]. Budget: < 2.0s.
_run_env_diagnostics() {
  echo "Rein v${VERSION} — doctor (--env: deep environment & connectivity)"
  echo ""
  local fail=0

  # Node version — 22+ required (node:sqlite, structuredClone, native test runner).
  if command -v node >/dev/null 2>&1; then
    local nv major
    nv="$(node --version 2>/dev/null)"      # e.g. v26.0.0
    major="${nv#v}"; major="${major%%.*}"
    if [[ "${major:-0}" =~ ^[0-9]+$ ]] && [[ "${major:-0}" -ge 22 ]]; then
      echo "  [OK]   node version (${nv})"
    else
      echo "  [FAIL] node version (${nv:-unknown}) — Node 22+ required"; fail=1
    fi
  else
    echo "  [FAIL] node not found — Node 22+ required"; fail=1
  fi

  # Essential global binaries. git is critical; the rest degrade gracefully → [WARN].
  for bin in git gh tmux npx; do
    if command -v "$bin" >/dev/null 2>&1; then
      echo "  [OK]   ${bin} on PATH"
    elif [[ "$bin" == "git" ]]; then
      echo "  [FAIL] ${bin} not found (required)"; fail=1
    else
      echo "  [WARN] ${bin} not found (recommended)"
    fi
  done

  # E-278 (D-075): no Rein component uses Docker any more, so there is no check for it.

  # Read/write permission bits on the framework + project state dirs.
  for d in "${HOME}/.rein" ".ai"; do
    if [[ -d "$d" ]]; then
      if [[ -r "$d" && -w "$d" ]]; then
        echo "  [OK]   ${d} read/write access"
      else
        echo "  [FAIL] ${d} not read/writable (permission bits)"; fail=1
      fi
    elif [[ "$d" == ".ai" ]]; then
      echo "  [WARN] ${d} not present (not inside a Rein project dir)"
    else
      echo "  [FAIL] ${d} missing — run: ai install"; fail=1
    fi
  done

  # State database write access — critical per blueprint §API exit policy.
  if [[ -f ".ai/state.sqlite" ]]; then
    if [[ -w ".ai/state.sqlite" ]]; then
      echo "  [OK]   state database write access"
    else
      echo "  [FAIL] state database not writable (.ai/state.sqlite)"; fail=1
    fi
  fi

  # E-176: live MCP connectivity probe (tools/list handshake). Locator chain mirrors
  # the telemetry/incident helpers: dev tree → installed mirror → cwd fallback.
  echo ""
  echo "MCP connectivity (tools/list handshake):"
  local tester="" self_dir
  self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  tester="$(_rein_helper shared/mcp-tester.mjs || true)"
  if [[ -n "$tester" ]] && [[ -f ".mcp.json" ]] && command -v node >/dev/null 2>&1; then
    node "$tester" --config .mcp.json --timeout 2000 || fail=1
  else
    echo "  — skipped (mcp-tester, .mcp.json, or node unavailable)"
  fi

  echo ""
  if [[ "$fail" -eq 0 ]]; then
    echo "✓ Environment OK — all critical checks passed."
    return 0
  fi
  echo "✗ Environment has critical failures (see [FAIL] above)."
  return 1
}

# E-109: Compliance audit — scan agent/skill YAML frontmatter vs registry + .mcp.json (§32)
_run_compliance_audit() {
  local REGISTRY="${REIN}/config/registry.json"
  echo "Rein v${VERSION} — Compliance Audit (§32 Verification)"
  echo ""

  if ! command -v python3 &>/dev/null; then
    echo "✗ python3 required for compliance audit"
    exit 1
  fi

  python3 - "$REGISTRY" "$REIN" <<'PY'
import json, sys, os, re
from pathlib import Path

registry_path = sys.argv[1]
rein          = sys.argv[2]

# Load registry allowed-tools per server
available_tools = {}
try:
    reg = json.load(open(registry_path))
    for name, info in reg.get("mcp_servers", {}).items():
        tools = info.get("allowed-tools", [])
        if "*" in tools:
            available_tools[name] = "*"
        else:
            for t in tools:
                available_tools[t] = name
except Exception as e:
    print(f"✗ Could not read registry.json: {e}")
    sys.exit(1)

# Also accept built-in Claude tools as valid
BUILTIN_TOOLS = {"Read","Write","Edit","Glob","Grep","Bash","WebSearch","WebFetch",
                 "Agent","TodoRead","TodoWrite","mcp__*",
                 # D-099 (E-321): the Triad wake — SendMessage is deferred, ToolSearch loads it.
                 "ToolSearch","ListAgents","SendMessage"}

def is_available(tool):
    if tool in available_tools:
        return True
    if tool in BUILTIN_TOOLS:
        return True
    if tool == "*":
        return True
    # mcp__ prefix tools — available if the server is in registry
    if tool.startswith("mcp__"):
        return True
    return False

# Scan all agent + skill .md files
search_paths = [
    Path(rein) / "claude" / "agents",
    Path(rein) / "claude" / "skills",
    Path(rein) / "shared" / "skills",
]
# Also scan project-local if we're in a Rein project
if Path(".ai").exists():
    search_paths += [
        Path("src/claude/agents"),
        Path("src/claude/skills"),
        Path("src/shared/skills"),
        # E-118: project-scoped dirs (populated by ai init / ai sync)
        Path(".claude/agents"),
        Path(".claude/skills"),
    ]

violations = []
scanned = 0

for base in search_paths:
    if not base.exists():
        continue
    for md in base.rglob("*.md"):
        text = md.read_text(errors="replace")
        if not text.startswith("---"):
            continue
        # Parse YAML frontmatter
        end = text.find("---", 3)
        if end == -1:
            continue
        frontmatter = text[3:end]
        name_m = re.search(r"^name:\s*(.+)$", frontmatter, re.M)
        tools_m = re.search(r"^allowed-tools:\s*(.+)$", frontmatter, re.M)
        agent_name = name_m.group(1).strip() if name_m else str(md.stem)
        scanned += 1

        if not tools_m:
            violations.append({
                "agent": agent_name,
                "file": str(md),
                "severity": "WARN",
                "issue": "Missing allowed-tools field in frontmatter"
            })
            continue

        declared_tools = [t.strip() for t in tools_m.group(1).split(",")]
        for tool in declared_tools:
            if tool and not is_available(tool):
                violations.append({
                    "agent": agent_name,
                    "file": str(md),
                    "severity": "CRITICAL",
                    "issue": f"Ghost Tool: '{tool}' declared but not in registry or builtin list"
                })

# E-121: ANTI-DRIFT PROTOCOL check — the canonical project rulefiles must contain the
# header. E-183/D-050: these are now ENGINEER.md/ARCHITECT.md (CLAUDE.md is an
# @import shim and carries no header). The global install rulefile keeps its vendor name.
ANTI_DRIFT_HEADER = "ANTI-DRIFT PROTOCOL"
anti_drift_targets = []
if Path(".ai").exists():
    anti_drift_targets += [Path("ENGINEER.md"), Path("ARCHITECT.md")]
anti_drift_targets += [Path(rein) / "claude" / "CLAUDE.md"]
seen_targets = set()
for t in anti_drift_targets:
    if t in seen_targets or not t.exists():
        continue
    seen_targets.add(t)
    content = t.read_text(errors="replace")
    if ANTI_DRIFT_HEADER not in content:
        violations.append({
            "agent": t.name,
            "file": str(t),
            "severity": "CRITICAL",
            "issue": f"Missing ANTI-DRIFT PROTOCOL section (§35) — run: ai sync to update"
        })

print(f"Scanned {scanned} agent/skill files\n")

if not violations:
    print("✓ COMPLIANCE PASS — no Ghost Tools, missing frontmatter, or ANTI-DRIFT violations detected")
else:
    critical = [v for v in violations if v["severity"] == "CRITICAL"]
    warns    = [v for v in violations if v["severity"] == "WARN"]
    print(f"COMPLIANCE REPORT: {len(critical)} CRITICAL | {len(warns)} WARN\n")
    for v in violations:
        icon = "✗" if v["severity"] == "CRITICAL" else "⚠"
        print(f"  {icon} [{v['severity']}] {v['agent']}")
        print(f"      Issue: {v['issue']}")
        print(f"      File:  {v['file']}")
        print()
    if critical:
        print("ACTION REQUIRED: Remove or register Ghost Tools before next commit.")
        sys.exit(1)
PY
}

# _install_browsers — the Playwright download, BOUNDED and visible (E-235 / D-061 §3).
#
# Two things the previous inline version lacked, both of which mattered:
#
#   1. A TIMEOUT. It once ran over an hour with no bound. `timeout` is not present on
#      macOS by default, so the limit is enforced with a watchdog rather than assumed —
#      a timeout that silently is not applied is worse than none, because it is believed.
#   2. PROGRESS. Output was piped through `tail -2`, so a long download looked identical
#      to a hung one. Nothing tells an operator less than a silent process.
_install_browsers() {
  local sdir="$1"
  local budget="${REIN_BROWSER_TIMEOUT:-600}"
  echo "  Installing Playwright Chromium (bounded to ${budget}s; ~150MB download)..."

  ( cd "$sdir" && npx playwright install chromium ) &
  local dl=$!
  ( sleep "$budget"; kill -TERM "$dl" 2>/dev/null ) &
  local wd=$!

  local rc=0
  wait "$dl" 2>/dev/null || rc=$?
  kill "$wd" 2>/dev/null
  wait "$wd" 2>/dev/null || true

  if [[ "$rc" -eq 0 ]]; then
    echo "  ✓ Chromium installed."
  else
    echo "  ✗ Chromium install did not complete (exit ${rc}; budget ${budget}s)." >&2
    echo "    The vibe-check tools will report [BROWSER_MISSING] until it succeeds." >&2
    echo "    Retry: ai mcp-setup --browsers    (raise the budget: REIN_BROWSER_TIMEOUT=1800)" >&2
  fi
  return 0   # never fail the install over an optional browser
}

do_mcp_setup() {
  local MCP_DIR="${REIN}/mcp"
  local REGISTRY="${REIN}/config/registry.json"

  if ! command -v node &>/dev/null; then
    echo "✗ Node.js not found — required for MCP servers. Install: brew install node"
    exit 1
  fi

  if [[ ! -d "$MCP_DIR" ]]; then
    echo "✗ MCP servers not found at ${MCP_DIR} — run: ai install"
    exit 1
  fi

  # Read custom server list from registry.json (authoritative whitelist per P-13)
  local CUSTOM_SERVERS=()
  if command -v python3 &>/dev/null && [[ -f "$REGISTRY" ]]; then
    while IFS= read -r srv; do
      [[ -n "$srv" ]] && CUSTOM_SERVERS+=("$srv")
    done < <(python3 -c "
import json, sys
with open('$REGISTRY') as f:
    d = json.load(f)
for name, info in d.get('mcp_servers', {}).items():
    if 'path' in info:
        print(name)
" 2>/dev/null || true)
  fi

  # Fallback if registry parse fails
  if [[ ${#CUSTOM_SERVERS[@]} -eq 0 ]]; then
    CUSTOM_SERVERS=(vibe-check-mcp task-synchronizer-mcp safe-exec-mcp blueprint-aligner-mcp context-guardian-mcp risk-analyzer-mcp)
  fi
  # E-339 (D-107 r2): ast-parser-mcp is a CLI (`ai sync`'s REPO_MAP step), not a registered
  # server, so the registry list never installed its web-tree-sitter dependency and every
  # mirror's map generation failed — silently, until sync stopped discarding the error.
  local _s _have=0
  for _s in "${CUSTOM_SERVERS[@]}"; do [[ "$_s" == "ast-parser-mcp" ]] && _have=1; done
  [[ "$_have" -eq 1 ]] || CUSTOM_SERVERS+=(ast-parser-mcp)

  # E-235: explicit opt-in, so the default install never blocks on a browser download.
  local WANT_BROWSERS=0
  [[ "${REIN_INSTALL_BROWSERS:-0}" == "1" ]] && WANT_BROWSERS=1
  local _a
  for _a in "$@"; do
    [[ "$_a" == "--browsers" ]] && WANT_BROWSERS=1
  done

  echo "Installing MCP server dependencies from ${MCP_DIR} ..."
  echo ""

  local SETUP_OK=0
  for server in "${CUSTOM_SERVERS[@]}"; do
    local sdir="${MCP_DIR}/${server}"
    if [[ -d "$sdir" && -f "${sdir}/package.json" ]]; then
      echo "  Installing ${server}..."
      (cd "$sdir" && npm install --silent 2>&1 | tail -2) || echo "  ✗ ${server}: npm install failed"
      # E-235 (D-061 §3): the browser download is NO LONGER part of the default install.
      #
      # `npx playwright install chromium` is an unbounded ~150MB network fetch. On
      # 2026-09-09 it ran for over an HOUR here without finishing — inside install-rein.sh,
      # which every user install and every CI run depends on. The `|| true` that used to
      # wrap it gave no protection whatsoever: the failure mode is HANGING, not erroring,
      # and you cannot `|| true` your way out of a process that never returns.
      #
      # Opt in with `ai mcp-setup --browsers`, or REIN_INSTALL_BROWSERS=1 to restore the
      # old behaviour. Missing browsers now produce a clear [BROWSER_MISSING] rejection at
      # first use rather than a hang.
      if [[ "$server" == "vibe-check-mcp" ]]; then
        if [[ "$WANT_BROWSERS" -eq 1 ]]; then
          _install_browsers "$sdir"
        else
          echo "  (skipping Playwright browsers — run: ai mcp-setup --browsers)"
        fi
      fi
      echo "  ✓ ${server}: ready"
      SETUP_OK=$((SETUP_OK + 1))
    else
      echo "  ⚠  ${server}: not found at ${sdir}"
    fi
  done

  echo ""
  echo "✓ MCP setup complete (${SETUP_OK}/${#CUSTOM_SERVERS[@]} servers installed)."

  # E-305 (D-089 r3): a gate path's dependencies must be EXACTLY the pinned versions — a parser
  # is the gate's input model (shell-quote 1.12 changed what `&>` parses to, b36a818). A
  # mismatch is the moved-interpreter class: refuse, like [TOOLCHAIN_STALE].
  local _gp; _gp="$(rein_locate shared/gate-pins.mjs 2>/dev/null || true)"
  if [[ -n "$_gp" ]] && command -v node >/dev/null 2>&1; then
    local _gp_out _gp_rc=0
    _gp_out="$(node --no-warnings "$_gp" check "$MCP_DIR" 2>&1)" || _gp_rc=$?
    if [[ "$_gp_rc" -eq 1 || "$_gp_rc" -eq 2 ]]; then
      printf '%s\n' "$_gp_out"            # stdout: install_global silences stderr
      echo "✗ gate dependencies do not match their pins — refusing (E-305)."
      return 3
    elif [[ "$_gp_rc" -eq 4 ]]; then
      printf '%s\n' "$_gp_out" | sed 's/^/  ⚠ /'   # absent, not drifted: the gate fails closed without them
    else
      echo "✓ Gate dependencies match their pins: $(node --no-warnings "$_gp" list "$MCP_DIR" 2>/dev/null | tr '\n' ' ')"
    fi
  fi

  # E-32: Dynamically regenerate .mcp.json with absolute paths if in a project
  if [[ -d ".ai" || -f ".mcp.json" ]]; then
    generate_mcp_json "."
    echo "✓ .mcp.json regenerated with absolute paths → $(pwd)/.mcp.json"
  fi
  echo "  Registry: ${REGISTRY}"
}

# E-34: Remove the global Rein install. Project .ai/ directories are
# untouched; only ~/.rein/ (the shared install root) is deleted. PATH and
# user config (~/.claude) are flagged for manual cleanup since
# they may contain unrelated user data.
do_uninstall() {
  if [[ ! -d "$REIN" ]]; then
    echo "✗ ${REIN} not found — nothing to uninstall."
    exit 0
  fi

  cat <<WARN
About to remove: ${REIN}

Will be deleted:
  ${REIN}/        (bin, mcp/, hooks/, templates/, config/, agents/, skills/)

Will NOT be touched (manual cleanup):
  ~/.claude/      (your Claude settings + agents — may contain unrelated data)
  ~/.config/github-copilot/
  any project's .ai/, .mcp.json, .git/hooks/pre-commit, .git/hooks/pre-push
  PATH entry in your shell rc (you must remove ~/.rein/bin manually)

WARN
  read -r -p "Type 'uninstall' to confirm: " ANSWER
  if [[ "$ANSWER" != "uninstall" ]]; then
    echo "Aborted."
    exit 1
  fi

  rm -rf "$REIN"
  echo "✓ Removed ${REIN}"
  echo ""
  echo "Manual cleanup steps:"
  echo "  1. Edit ~/.zshrc or ~/.bashrc and remove:  export PATH=\"\$HOME/.rein/bin:\$PATH\""
  echo "  2. Review ~/.claude/agents/ for Rein-specific files"
  echo "  3. In each project: \`rm .git/hooks/pre-commit\` if it sources hooks/pre-commit.sh"
  echo "  4. In each project: \`rm .git/hooks/pre-push\` — the local CI stub fails closed, so it blocks every push once ~/.rein is gone"
}

# E-198 (Ruling A / pending D-053): shell-native task creation. Persists the SAME
# state.sqlite row as task-synchronizer-mcp::add_task — both route through the shared
# state-db::addTask so state stays the single source of truth — but as a plain shell
# command so a session without MCP access can still register a task; without it,
# hand-edited TASKS.md rows are wiped by the next verify_markdown_sync (the "orphaned
# blueprint" incident).
# Usage: ai add-task [--prefix E|P] [--owner <name>] [--role architect|engineer] [--tier N] [--depends-on E-1,E-2] <description>
do_add_task() {
  if ! command -v node >/dev/null 2>&1; then
    echo "ai add-task: node not found — cannot persist task." >&2
    return 1
  fi
  # Locate the helper relative to THIS script first (BASH_SOURCE-derived, resolves in
  # both the dev tree and the ~/.rein install), then the install mirror, then cwd —
  # the same locator chain as the plugin/mcp-tester
  # helpers. (run_review's deterministic PATH_TRAVERSAL heuristic flags the `../` here
  # and in the helper's relative import; both are static, safe paths — advisory only,
  # not enforced by the Gate-2 pre-commit hook.)
  local self_dir; self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local script=""
  script="$(_rein_helper shared/cli-add-task.mjs || true)"
  if [[ -z "$script" ]]; then
    echo "ai add-task: cli-add-task.mjs not found (run: ai install)." >&2
    return 1
  fi
  node "$script" "$@"
}

# E-314 (D-095): `ai account` and the one account resolver live beside this script (it is at
# its size ceiling); loaded before the sourcing guard below so a suite that sources
# this file gets it too; sourced from this file's own directory, never located through the env.
# Bash imports exported functions from the environment, which is untrusted here (E-223), so
# the names this library defines are cleared first: with the file missing, an inherited
# `do_account` or `_account_dir` must not answer in its place (security review, E-314).
unset -f do_account _account_dir _account_rows _acct_py _acct_registry _acct_today _acct_tilde \
  _acct_login _acct_settings _acct_seed _acct_in_use _start_account_set _start_account_pick \
  _account_launch_check 2>/dev/null || true
_ai_account_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/ai-account.sh"
[[ -f "$_ai_account_lib" ]] && source "$_ai_account_lib"

# ── dispatch ──────────────────────────────────────────────────────────────────

# E-53: only run the dispatch when bin/ai is executed as a script. Sourcing
# the file (e.g. from test suites) loads the helpers without invoking usage().
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0 2>/dev/null || exit 0
fi


# ── E-208 (D-054, role-abstraction.md §Same-Provider Triad): `ai pane <role>` ──
# The single provider-agnostic surface that BINDS a tmux pane to a role, symmetric
# to `ai add-task` (D-053). Role identity is bound
# per pane at LAUNCH, never per project — that is the whole point of D-054: two
# panes of the same provider must be able to hold different roles, which a project
# settings file (one per repo) structurally cannot express.
#
# It does four things, then exec()s the provider CLI:
#   1. resolves role -> provider (+ optional model) from .ai/roles.json
#   2. builds the provider's `launch` argv from .ai/providers.json
#   3. exports REIN_PANE_ROLE + REIN_CALLER_ROLE into the launch environment
#      (session-start.sh mints the E-129 token from REIN_PANE_ROLE)
#   4. sets the pane's @rein_role option and pins its title to the role (E-209), so
#      `ai start --status` reports it instead of a drifting summary title
#
# Usage: ai pane <architect|engineer> [-- <extra provider args>]
# ── E-227 (D-059, cli-collapse.md §`ai start`): the Triad launcher ───────────
#
# COMPOSITION ONLY. `ai start` runs exactly one thing it does not own — `ai pane <role>`
# from the installed `ai` (D-099 removed `ai watch`). It never launches a provider binary
# directly (`ai pane` owns role binding, title pinning and the launch argv) and never runs
# a project-supplied script: the visited project must not be able to choose what a
# launcher executes, which is the whole T-LOCATOR-001 lesson applied to a new surface.

# _start_shell_re — commands that count as "an interactive shell is ready in this pane".
_START_SHELL_RE='^(-?(ba|z|k|a|da)?sh|fish|login)$'

# _start_config — read and VALIDATE .ai/start.json, printing "session|layout|main|account"
# (account empty = default; E-315, accounts.md §2). E-333 (D-102 §8): a gitignored
# .ai/start.local.json may carry ONLY `account`, and it wins — the account is per developer.
# Every value here becomes a tmux argument, so the file is an exec surface: anything
# outside the blueprint's shapes is rejected rather than sanitised (E-208 audit lesson —
# an Architect-writable config is attacker-adjacent input, not a trusted source).
_start_config() {
  local ai_dir="$1" cfg="${1}/start.json"
  # E-252 (D-068): `session` is now an OVERRIDE, not a default. It defaults to EMPTY so the
  # caller can tell "the operator pinned a name" from "derive one from the project" — with
  # a literal "rein" default those two were indistinguishable, which is how every project
  # ended up in one shared session.
  local session="" layout="triad" main="50" account=""
  local lcfg="${1}/start.local.json" lparsed=""
  if [[ -f "$lcfg" ]]; then
    lparsed="$(python3 -I - "$lcfg" <<'PY' 2>/dev/null
import json, re, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("ERR unreadable JSON"); raise SystemExit(0)
if not isinstance(d, dict) or set(d) - {"account"}:
    print("ERR only {\"account\": <name>} is allowed here"); raise SystemExit(0)
a = d.get("account", "")
if not isinstance(a, str) or (a and not re.fullmatch(r"[a-z][a-z0-9-]{0,23}", a)):
    print("ERR account must match ^[a-z][a-z0-9-]{0,23}$"); raise SystemExit(0)
print("OK " + a)
PY
)"
    if [[ "$lparsed" != OK* ]]; then
      echo "ai start: .ai/start.local.json rejected — ${lparsed#ERR }" >&2
      return 2
    fi
    lparsed="${lparsed#OK}"; lparsed="${lparsed# }"
  fi
  if [[ -f "$cfg" ]]; then
    local parsed
    parsed="$(python3 - "$cfg" <<'PY' 2>/dev/null
import json, re, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("ERR unreadable JSON"); raise SystemExit(0)
if not isinstance(d, dict):
    print("ERR top level must be an object"); raise SystemExit(0)

allowed = {"session", "layout", "watch", "sizes", "account"}
extra = set(d) - allowed
if extra:
    print("ERR unknown key(s): " + ", ".join(sorted(extra))); raise SystemExit(0)

session = d.get("session", "")
if not isinstance(session, str) or (session and not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", session)):
    print("ERR session must match ^[A-Za-z0-9_-]{1,32}$"); raise SystemExit(0)

layout = d.get("layout", "triad")
if layout != "triad":
    print("ERR layout must be 'triad' (no other layout is blueprinted)"); raise SystemExit(0)

# D-099 (E-322): `watch` and `sizes.top` configured the removed watcher pane. A file
# written before that still carries them, so they stay ACCEPTED (and type-checked, so the
# exec surface does not widen) and are ignored — rejecting them would stop `ai start`
# in every project that ever set them.
watch = d.get("watch", True)
if not isinstance(watch, bool):
    print("ERR watch must be true or false"); raise SystemExit(0)

account = d.get("account", "")
if not isinstance(account, str) or (account and not re.fullmatch(r"[a-z][a-z0-9-]{0,23}", account)):
    print("ERR account must match ^[a-z][a-z0-9-]{0,23}$"); raise SystemExit(0)

sizes = d.get("sizes", {})
if not isinstance(sizes, dict) or set(sizes) - {"main", "top"}:
    print("ERR sizes may only contain 'main' and 'top'"); raise SystemExit(0)
out = {}
for k, dflt in (("main", 50), ("top", 60)):
    v = sizes.get(k, dflt)
    if isinstance(v, bool) or not isinstance(v, int) or not (1 <= v <= 99):
        print("ERR sizes.%s must be an integer percentage 1-99" % k); raise SystemExit(0)
    out[k] = v
print("OK %s|%s|%d|%s" % (session, layout, out["main"], "" if account == "default" else account))
PY
)"
    if [[ "$parsed" != OK\ * ]]; then
      echo "ai start: .ai/start.json rejected — ${parsed#ERR }" >&2
      return 2
    fi
    IFS='|' read -r session layout main account <<< "${parsed#OK }"
  fi
  # The local override: "default" there means default even when start.json names an account.
  if [[ -n "$lparsed" ]]; then
    account="$lparsed"; [[ "$account" == "default" ]] && account=""
  fi
  # An unregistered name is rejected like an unknown key (E-315): the file is Architect-writable
  # and names an account, never a path — the registry is what resolves it.
  if [[ -n "$account" ]] && declare -F _account_dir >/dev/null; then
    local _arc=0
    _account_dir "$account" >/dev/null 2>&1 || _arc=$?
    if [[ "$_arc" -eq 4 ]]; then
      echo "ai start: .ai/$([[ -n "$lparsed" ]] && echo start.local.json || echo start.json) rejected — account '${account}' is not registered — run: ai account add ${account}" >&2
      return 2
    fi
  fi
  printf '%s|%s|%s|%s' "$session" "$layout" "$main" "$account"
}

# _start_roles — roles from .ai/roles.json ordered by pane_identifier ASCENDING.
# The role with the lower pane_identifier gets the lower tmux pane_index, so E-209's
# ordinal fallback and the visible layout agree BY CONSTRUCTION rather than by luck.
_start_roles() {
  local ai_dir="$1"
  python3 - "${ai_dir}/roles.json" <<'PY' 2>/dev/null
import json, sys
try:
    roles = json.load(open(sys.argv[1])).get("roles", {})
except Exception:
    roles = {}
ordered = sorted(
    # E-255: a headless role (the Tester) has no pane — never laid out, whatever its key.
    ((str(v.get("pane_identifier", "99")), k) for k, v in roles.items()
     if k in ("engineer", "architect") and isinstance(v, dict) and v.get("headless") is not True),
    key=lambda t: (int(t[0]) if t[0].lstrip("-").isdigit() else 99, t[1]),
)
for _, name in ordered:
    print(name)
PY
}

do_start() {
  local detach=0 dry=0 want_status=0 want_kill=0 assume_yes=0 want_account=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --account)
        want_account="${2:-}"
        [[ -n "$want_account" ]] || { echo "ai start: --account needs a name (or 'default')" >&2; return 2; }
        shift ;;
      --detach|-d) detach=1 ;;
      --dry-run) dry=1 ;;
      --status)   want_status=1 ;;
      --kill)     want_kill=1 ;;
      --yes|-y)   assume_yes=1 ;;
      -h|--help)
        echo "Usage: ai start [--account <name|default>] [--detach] [--dry-run]"
        echo "       ai start --status"
        echo "       ai start --kill [--yes]"
        echo "  Creates or reuses the project's tmux Triad layout and binds each pane to a role."
        echo "  Panes are ordered by pane_identifier in .ai/roles.json."
        echo ""
        echo "  --status  report this project's panes (role, title, command)."
        echo "  --kill    tear the project window down. Asks unless --yes."
        echo "  --account bind this project to a Claude account (ai account add <name>); 'default'"
        echo "            unbinds it. Written to .ai/start.json; the panes launch under it."
        return 0 ;;
      *) echo "ai start: unknown option '$1'" >&2; return 2 ;;
    esac
    shift
  done
  if [[ "$want_status" -eq 1 && "$want_kill" -eq 1 ]]; then
    echo "ai start: --status and --kill are mutually exclusive." >&2
    return 2
  fi

  local ai_dir; ai_dir="$(_find_ai_dir)"
  if [[ ! -d "$ai_dir" ]]; then
    echo "ai start: not inside a Rein project (.ai/ not found). Run 'ai init' first." >&2
    return 2
  fi

  local cfg; cfg="$(_start_config "$ai_dir")" || return 2
  local session layout main_pct account
  IFS='|' read -r session layout main_pct account <<< "$cfg"

  local -a roles=()
  local r
  while IFS= read -r r; do [[ -n "$r" ]] && roles+=("$r"); done < <(_start_roles "$ai_dir")

  # E-242 (D-066): pre-check every role's overlay HERE, before any pane is created.
  #
  # `ai pane` self-heals too, but by then the failure is inside a tmux pane whose output
  # scrolls past and whose exit leaves an empty shell — the operator sees a dead pane, not
  # a message. Checking up front reports all roles at once, in the terminal they are
  # actually looking at.
  local _pj _missing=0
  _pj="$(cd "$(dirname "$ai_dir")" && pwd)"
  for r in "${roles[@]}"; do
    [[ -f "${_pj}/.claude/settings.${r}.json" ]] || _missing=1
  done
  if [[ "$_missing" -eq 1 ]]; then
    # --dry-run DESCRIBES; it must not write. Regenerating overlays here would make a
    # "show me what you would do" invocation modify the project, which is the one thing a
    # dry run promises not to do.
    if [[ "$dry" -eq 1 ]]; then
      echo "ai start: (dry run) per-role settings overlays are missing; a real run regenerates them."
      _missing=0
    else
    echo "ai start: regenerating missing per-role settings overlays..."
    ( cd "$_pj" && _write_role_settings_overlays ".claude" ".ai" ) 2>/dev/null || true
    for r in "${roles[@]}"; do
      if [[ -f "${_pj}/.claude/settings.${r}.json" ]]; then
        echo "  ✓ .claude/settings.${r}.json"
      else
        echo "  ✗ .claude/settings.${r}.json still missing — run 'ai init' in ${_pj}" >&2
      fi
    done
    fi
  fi
  if [[ "${#roles[@]}" -eq 0 ]]; then
    echo "ai start: no roles in .ai/roles.json — run 'ai init' or add engineer/architect." >&2
    return 2
  fi

  # E-252 (D-068): `pwd -P` — the PHYSICAL path. tmux reports a pane's physical cwd, and
  # the stamp is compared against it, so a project entered through a symlink must resolve
  # the same way here or it would never match its own session.
  local project; project="$(cd "$(dirname "$ai_dir")" && pwd -P)"
  local window; window="$(basename "$project")"
  local explicit_session="$session"

  # One lookup for all three entry points, so --status and --kill act on the session the
  # operator is actually looking at rather than on a name recomputed per command.
  local session_origin="new"
  if command -v tmux >/dev/null 2>&1 && [[ "$dry" -eq 0 ]]; then
    local _resolved; _resolved="$(_start_resolve_session "$project" "$window" "$explicit_session")"
    session="${_resolved%%|*}"; session_origin="${_resolved##*|}"
  else
    session="$(_start_session_name "$project" "$explicit_session")"
  fi

  if [[ "$want_status" -eq 1 ]]; then
    _start_status "$session" "$window" "$project" "$session_origin"
    return $?
  fi
  if [[ "$want_kill" -eq 1 ]]; then
    _start_kill "$session" "$window" "$project" "$assume_yes" "$dry"
    return $?
  fi

  # E-315 (D-095, accounts.md §2): which Claude account the panes launch under. `ai start` never
  # creates an account; an unregistered name exits 2 with the `ai account add` recipe.
  if ! declare -F _account_dir >/dev/null; then
    [[ -z "$want_account" && -z "$account" ]] \
      || { echo "ai start: ai-account.sh is missing beside ai — run: bash install-rein.sh" >&2; return 2; }
  elif [[ -n "$want_account" ]]; then
    _account_dir "$want_account" >/dev/null || return 2
    if [[ "$dry" -eq 1 ]]; then
      echo "ai start: (dry run) would bind account '${want_account}' in .ai/$(_start_account_file "$ai_dir")"
    else
      local _af; _af="$(_start_account_file "$ai_dir")"
      # A team project keeps an explicit "default" (keep) so it overrides a committed account.
      _start_account_set "$ai_dir" "$want_account" "$([[ "$_af" == start.local.json ]] && echo keep)" "$_af" \
        || { echo "ai start: could not write .ai/${_af}" >&2; return 2; }
    fi
    account="$want_account"; [[ "$account" == "default" ]] && account=""
  elif [[ -z "$account" ]] && ! grep -q '"account"' "${ai_dir}/start.json" "${ai_dir}/start.local.json" 2>/dev/null; then
    _start_account_pick "$ai_dir" "$dry" || return 2
    if [[ "$dry" -eq 0 ]]; then
      cfg="$(_start_config "$ai_dir")" || return 2
      account="${cfg##*|}"
    fi
  fi
  local account_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  if [[ -n "$account" ]]; then
    account_dir="$(_account_dir "$account")" || return 2
  fi
  echo "ai start: account ${account:-default} ($(_acct_tilde "$account_dir" 2>/dev/null || echo "$account_dir"))"

  # Non-tmux hosts are supported, just not automated: tmux is the recommended UX, not a
  # requirement, so print the exact commands the launcher would have composed.
  if ! command -v tmux >/dev/null 2>&1; then
    echo "ai start: tmux not found. Run these in two panes/terminals instead:" >&2
    for r in "${roles[@]}"; do echo "  ai pane ${r}" >&2; done
    return 2
  fi

  # `_run` is the single seam through which every tmux call passes, so --dry-run prints
  # exactly what a real run would execute — nothing is composed twice.
  local _dry="$dry"
  _run() {
    if [[ "$_dry" -eq 1 ]]; then printf 'tmux'; printf ' %q' "$@"; printf '\n'; return 0; fi
    tmux "$@"
  }

  # TARGETS ARE tmux IDs (`@3` for windows, `%7` for panes), never "session:name.index".
  #
  # Two reasons, one of which only a live run reveals:
  #   - the window name is the project's directory BASENAME, and tmux parses a target as
  #     `session:window.pane`. Any project called `my.app` produced an ambiguous target.
  #   - tmux does not accept `@0.0` at all ("can't find pane: 0") — a window id is a
  #     WINDOW target, so panes must be addressed by their own `%id`.
  # Ids are opaque and cannot collide with the separator syntax. The dry run prints
  # symbolic `pane<N>` placeholders instead, because in that mode no panes exist; it shows
  # the COMPOSITION (which command reaches which pane, in order), and the live smoke is
  # what asserts real tmux behaviour.
  # A pre-D-068 window inside the shared `rein` session is reused IN PLACE — an operator
  # mid-sprint does not get their layout torn down by an upgrade — but they are told once
  # how to move it, because until they do, this project still shares a current window with
  # every other project in that session.
  if [[ "$dry" -eq 0 && "$session_origin" == "legacy" ]]; then
    echo "ai start: reusing legacy shared window rein:${window} — run 'ai start --kill' then"
    echo "  'ai start' to move this project to its own session '$(_start_session_name "$project" "$explicit_session")'."
  fi

  local target existing=0 win_id=""
  if [[ "$dry" -eq 0 ]] && tmux has-session -t "$session" 2>/dev/null; then
    win_id="$(tmux list-windows -t "$session" -F '#{window_id} #{window_name}' 2>/dev/null \
              | awk -v n="$window" '$2 == n { print $1; exit }')"
    [[ -n "$win_id" ]] && existing=1
  fi

  # _panes — the window's pane ids, in pane_index order, one per line.
  _panes() {
    [[ "$dry" -eq 1 ]] && { printf 'pane0\npane1\n'; return 0; }
    tmux list-panes -t "$win_id" -F '#{pane_index} #{pane_id}' 2>/dev/null \
      | sort -n | awk '{ print $2 }'
  }
  _pane_at() {  # <index> → pane id
    _panes | sed -n "$(( $1 + 1 ))p"
  }

  if [[ "$existing" -eq 0 ]]; then
    local _created_session=0
    if [[ "$dry" -eq 1 ]] || ! tmux has-session -t "$session" 2>/dev/null; then
      _run new-session -d -s "$session" -n "$window" -c "$project"
      _created_session=1
    else
      _run new-window -d -t "$session" -n "$window" -c "$project"
    fi
    # THE STAMP. Written immediately after creation, before anything can attach, so the
    # session is discoverable by identity from its first moment. Fail-open (D-068
    # §Execution Constraints): a tmux too old for set-environment still gets a working
    # layout, and the operator is TOLD that ownership could not be recorded rather than
    # silently getting name-only behaviour.
    if [[ "$_created_session" -eq 1 ]]; then
      _run set-environment -t "$session" REIN_PROJECT "$project"
      if [[ "$dry" -eq 0 ]] && [[ "$(_start_session_stamp "$session")" != "$project" ]]; then
        echo "ai start: could not stamp session '${session}' with REIN_PROJECT — this tmux" >&2
        echo "  may predate set-environment. Falling back to name-only lookup; --status and" >&2
        echo "  --kill will find this session by name only." >&2
      fi
      [[ "$dry" -eq 0 ]] && echo "ai start: created session '${session}' for ${project}"
    fi
    if [[ "$dry" -eq 0 ]]; then
      win_id="$(tmux list-windows -t "$session" -F '#{window_id} #{window_name}' 2>/dev/null \
                | awk -v n="$window" '$2 == n { print $1; exit }')"
      if [[ -z "$win_id" ]]; then
        echo "ai start: could not resolve the window just created in session '${session}'." >&2
        return 2
      fi
    fi
    # Pane 1 (right column). Splitting left-to-right is what makes pane_index follow the
    # role order derived above.
    # Check the splits. `_run` returns tmux's status and these callers used to DISCARD it,
    # so a refused split (a window too small to divide, an unsupported flag on an older
    # tmux) left a one-pane window and `ai start` went on to report "ready". A launcher
    # that claims success while having built one third of the layout is worse than one
    # that fails: the operator believes the Triad is up. Observed on CI (tmux 3.4), where
    # only %0 was ever created.
    # `-l N%` is the modern spelling and `-p N` the deprecated one. tmux 3.4 rejects `-p`
    # with "size missing" while 3.7c still accepts it, which is exactly how this shipped
    # green on a developer Mac and produced a ONE-PANE window on CI. Try the modern form
    # first and keep the old one as a fallback for tmux older than 3.1, so both ends of
    # the supported range work.
    _split() {  # <-h|-v> <pane> <percent>
      _run split-window "$1" -t "$2" -c "$project" -l "${3}%" \
        || _run split-window "$1" -t "$2" -c "$project" -p "$3"
    }
    if ! _split -h "$(_pane_at 0)" "$((100 - main_pct))"; then
      echo "ai start: tmux refused to split the window for the right column (main_pct=${main_pct})." >&2
      echo "ai start: the layout was NOT created — not reporting the session as ready." >&2
      return 2
    fi
  fi

  # Bind each agent pane. The pane hosts an INTERACTIVE SHELL and `ai pane <role>` is
  # SENT to it, so when the provider exits the operator still has a shell and can rerun
  # the command — a pane whose foreground IS the provider dies with it.
  local idx=0 pane
  for r in "${roles[@]}"; do
    pane="$(_pane_at "$idx")"
    if [[ -z "$pane" ]]; then
      echo "ai start: expected a pane at index ${idx} but the window has fewer." >&2
      return 2
    fi
    if [[ "$dry" -eq 0 ]]; then
      # Wait for the prompt before sending: keys delivered to a pane whose shell has not
      # finished starting are simply lost, and a fixed sleep is a bet on machine speed.
      local w=0 cur
      while [[ "$w" -lt 100 ]]; do
        cur="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
        [[ "$cur" =~ $_START_SHELL_RE ]] && break
        sleep 0.05; w=$((w + 1))
      done
    fi
    _run send-keys -t "$pane" "ai pane ${r}" C-m
    idx=$((idx + 1))
  done

  # Re-pin the role binding on every run, including an idempotent re-run over live panes.
  # E-269 (D-073): the @rein_role option is the pane's role; the title is cosmetic.
  # E-315: the account option and title are for humans and --status; routing stays on the role.
  idx=0
  for r in "${roles[@]}"; do
    _run set-option -p -t "$(_pane_at "$idx")" @rein_role "$r"
    _run set-option -p -t "$(_pane_at "$idx")" @rein_account "${account:-default}"
    _run select-pane -t "$(_pane_at "$idx")" -T "${r}${account:+ · ${account}}"
    idx=$((idx + 1))
  done

  if [[ "$dry" -eq 1 ]]; then
    return 0
  fi
  if [[ "$detach" -eq 1 ]]; then
    echo "ai start: ${session}:${window} ready (detached). Attach with: tmux attach -t ${session}"
    return 0
  fi
  # ONLY THE INVOKING CLIENT MOVES (D-068 §Components 5). `switch-client` acts on the
  # client that ran the command; `select-window` changes the session's current window for
  # EVERY attached client, which is how `ai start` in project B used to flip the terminal
  # showing project A. It is no longer composed anywhere in the launcher.
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$win_id"
  else
    tmux attach-session -t "$session"
    # An owned session has exactly one window, so attaching lands on it. A legacy shared
    # session does not, and selecting the window would move the other clients — so the
    # operator is told which window to pick instead of it being chosen for them.
    if [[ "$session_origin" == "legacy" ]]; then
      echo "ai start: attached to the shared session — select window '${window}' (${win_id})."
    fi
  fi
}

# ── E-252 (D-068): one tmux session per project ───────────────────────────────
#
# `ai start` used to put every project into ONE shared session (`rein`), one window each.
# A tmux session has a single CURRENT WINDOW shared by every attached client, so `ai start`
# in project B flipped the terminal that was showing project A; the window was found by
# NAME ONLY, so two checkouts with the same basename shared one window and a renamed window
# was recreated beside the old one.
#
# THE STAMP IS THE IDENTITY; THE NAME IS A LABEL. Each session `ai start` creates carries
# `REIN_PROJECT=<pwd -P of the project>` in its session environment. Discovery reads the
# stamp back, so reuse, `--status` and `--kill` find the project's session even when the
# NAME had to be suffixed — and a foreign session that merely shares a name is never
# adopted, which is the injection path this closes from the launcher side.
#
# Rollback: REIN_SHARED_SESSION=1 restores the single `rein` session.

# _start_session_name <project> <explicit-or-empty> → the session name to use.
#
# Pure: no tmux, no filesystem. An explicit `.ai/start.json` `session` wins verbatim (it is
# already validated against ^[A-Za-z0-9_-]{1,32}$). Otherwise the basename is rewritten
# through a WHITELIST — tmux parses `session:window.pane`, so a `.` or `:` in a project
# name would make every target ambiguous (the E-227 bug, in a new place), and a leading `-`
# would parse as a flag.
_start_session_name() {
  local project="$1" explicit="${2:-}"
  if [[ -n "$explicit" ]]; then printf '%s' "$explicit"; return 0; fi
  if [[ "${REIN_SHARED_SESSION:-0}" == "1" ]]; then printf 'rein'; return 0; fi

  local n
  n="$(printf '%s' "$(basename "$project")" | LC_ALL=C sed 's/[^A-Za-z0-9_-]/-/g')"
  # Leading `-` or `_` stripped one at a time: `${n##[-_]}` removes only one, and a name
  # like `--weird` would keep a leading dash and be read by tmux as a flag.
  while [[ "$n" == [-_]* ]]; do n="${n#?}"; done
  n="${n:0:32}"
  [[ -z "$n" ]] && n="rein"
  printf '%s' "$n"
}

# _start_session_stamp <session> → the REIN_PROJECT value, or "".
# `show-environment` prints `-NAME` for a variable that is explicitly unset, so the match is
# anchored on `NAME=` and that form yields nothing rather than a bogus value.
_start_session_stamp() {
  tmux show-environment -t "$1" REIN_PROJECT 2>/dev/null | sed -n 's/^REIN_PROJECT=//p' | head -1
}

# _start_find_session <project> → the session whose stamp equals this project, or "".
# Runs BEFORE any name derivation, so a project whose name had to be suffixed last time is
# found again by identity rather than by guessing the same suffix twice.
_start_find_session() {
  local project="$1" s stamp
  while IFS= read -r s; do
    [[ -z "$s" ]] && continue
    stamp="$(_start_session_stamp "$s")"
    if [[ -n "$stamp" && "$stamp" == "$project" ]]; then printf '%s' "$s"; return 0; fi
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
  printf ''
}

# _start_session_free <name> <project> → 0 when the name is ours to use.
# Free means: no such session, or a session stamped to THIS project. A live session that is
# unstamped (a foreign session the operator owns) or stamped elsewhere is never adopted.
_start_session_free() {
  local name="$1" project="$2"
  tmux has-session -t "$name" 2>/dev/null || return 0
  [[ "$(_start_session_stamp "$name")" == "$project" ]]
}

# _start_session_suffix <name> <project> → <first 25>-<6 hex of sha1(path)>
# Derived from the PATH, so the same project gets the same suffix every time — a random one
# would strand the previous session on the next run.
_start_session_suffix() {
  local name="$1" project="$2" h
  h="$(printf '%s' "$project" | { shasum -a 1 2>/dev/null || sha1sum; } | cut -c1-6)"
  printf '%s-%s' "${name:0:25}" "$h"
}

# _start_legacy_window <basename> <project> → the @id of a live pre-D-068 window, or "".
#
# Idempotency for an operator mid-sprint: a window named after the project inside the old
# shared `rein` session is adopted IN PLACE rather than abandoned. A matching name is not
# enough — at least one pane must actually be rooted in this project, or `ai start` in a
# same-named checkout would hijack the other one's window, which is the bug this task is
# fixing rather than a shape of it to preserve.
_start_legacy_window() {
  local window="$1" project="$2"
  tmux has-session -t rein 2>/dev/null || { printf ''; return 0; }
  local wid
  wid="$(tmux list-windows -t rein -F '#{window_id} #{window_name}' 2>/dev/null \
         | awk -v n="$window" '$2 == n { print $1; exit }')"
  [[ -n "$wid" ]] || { printf ''; return 0; }
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    if [[ "$p" == "$project" || "$p" == "$project"/* ]]; then printf '%s' "$wid"; return 0; fi
  done < <(tmux list-panes -t "$wid" -F '#{pane_current_path}' 2>/dev/null || true)
  printf ''
}

# _start_resolve_session <project> <window> <explicit> → "<session>|<origin>"
#
# The single lookup every entry point uses — start, --status and --kill — so all three act
# on the same session the operator is looking at. Origin is `owned` (stamp match), `legacy`
# (a pre-D-068 window in the shared session) or `new` (nothing yet; the name is the one a
# real run would create).
_start_resolve_session() {
  local project="$1" window="$2" explicit="${3:-}"
  local found; found="$(_start_find_session "$project")"
  if [[ -n "$found" ]]; then printf '%s|owned' "$found"; return 0; fi
  if [[ -n "$(_start_legacy_window "$window" "$project")" ]]; then printf 'rein|legacy'; return 0; fi
  local name; name="$(_start_session_name "$project" "$explicit")"
  if ! _start_session_free "$name" "$project"; then
    name="$(_start_session_suffix "$name" "$project")"
  fi
  printf '%s|new' "$name"
}

# _start_window_id — resolve the project's window by NAME within a session, returning its
# window id. Resolving by id matters: the window is named after the project directory, and
# a mktemp-style name contains a dot, which tmux would otherwise parse as window.pane.
_start_window_id() {  # <session> <window> → @id | ""
  # `tmux list-windows` FAILS when the session — or the whole server — does not exist,
  # which is the normal "nothing is running" case this function has to answer. Under the
  # script's `set -euo pipefail` a bare pipeline would take tmux's non-zero status and kill
  # the caller mid-assignment, so `ai start --status` exited 1 having printed NOTHING.
  # Invisible on a machine that already has a tmux server; reproducible with a socket that
  # has none, which is what CI is.
  local out=""
  out="$(tmux list-windows -t "$1" -F '#{window_id} #{window_name}' 2>/dev/null || true)"
  printf '%s\n' "$out" | awk -v n="$2" '$2 == n { print $1; exit }'
}

# `ai start --status` (E-228 / D-059). Reports rather than acts: what panes exist, what
# each is titled and running.
#
# Exit 0 even when nothing is running. "Nothing is up" is a true answer to a status
# question, not a failure — making it non-zero would turn `ai start --status` into
# something a script cannot ask without `|| true`.
_start_status() {  # <session> <window> <project> [origin]
  local session="$1" window="$2" project="$3" origin="${4:-new}"
  if ! command -v tmux >/dev/null 2>&1; then
    echo "ai start --status: tmux is not installed — no panes to report."
    return 0
  fi
  local wid; wid="$(_start_window_id "$session" "$window")"
  if [[ -z "$wid" ]]; then
    echo "ai start --status: no window '${window}' in session '${session}' — not running."
  else
    # The ORIGIN is printed because "which session is this project in" now has more than
    # one answer, and an operator debugging a cross-project collision needs to know whether
    # they are looking at an owned session or a leftover shared one.
    echo "ai start --status: ${session}:${window} (${wid}) [${origin}]"
    # E-269 (D-073): the role column is the @rein_role option `ai pane` sets, not the
    # title (Claude Code overwrites titles with its conversation summary).
    # E-315: the account column is the @rein_account option `ai pane` / `ai start` set.
    local idx role acct cmd
    while IFS='|' read -r idx role acct cmd; do
      [[ -z "$idx" ]] && continue
      printf '  pane %-3s %-12s %-12s %s\n' "$idx" "${role:-(no role)}" "${acct:-default}" "${cmd:-(no command)}"
    done < <(tmux list-panes -t "$wid" -F '#{pane_index}|#{@rein_role}|#{@rein_account}|#{pane_current_command}' 2>/dev/null | sort -n || true)
  fi

  return 0
}

# `ai start --kill` (E-228 / D-059). Destructive, so consent is explicit.
#
# Without --yes on a NON-INTERACTIVE stdin this REFUSES rather than proceeding. There is
# no prompt to answer in a pipeline or a hook, and "no answer" must not read as consent
# for a command that tears down a running session.
_start_kill() {  # <session> <window> <project> <assume_yes> <dry>
  local session="$1" window="$2" project="$3" assume_yes="$4" dry="$5"
  if ! command -v tmux >/dev/null 2>&1; then
    echo "ai start --kill: tmux is not installed — nothing to tear down." >&2
    return 2
  fi
  local wid; wid="$(_start_window_id "$session" "$window")"

  if [[ -z "$wid" ]]; then
    echo "ai start --kill: nothing to tear down (no window '${window}')."
    return 0
  fi

  if [[ "$dry" -eq 1 ]]; then
    echo "ai start --kill (dry run) would:"
    echo "  kill-window -t ${wid}   (${session}:${window})"
    return 0
  fi

  if [[ "$assume_yes" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      echo "ai start --kill: refusing to tear down ${session}:${window} without --yes." >&2
      echo "  stdin is not a terminal, so there is no prompt to answer; pass --yes to confirm." >&2
      return 2
    fi
    local reply=""
    printf 'Tear down %s:%s? [y/N] ' "$session" "$window"
    read -r reply || true
    case "$reply" in
      y|Y|yes|YES) ;;
      *) echo "ai start --kill: aborted."; return 0 ;;
    esac
  fi

  if [[ -n "$wid" ]]; then
    tmux kill-window -t "$wid" 2>/dev/null \
      && echo "ai start --kill: window ${session}:${window} (${wid}) killed." \
      || echo "ai start --kill: tmux refused to kill ${wid}." >&2
  fi
  # E-294 (Component 8h): the panes' launch records and tokens are now dead — prune them.
  _launch_record_prune >/dev/null
  return 0
}

do_pane() {
  local role="${1:-}"
  case "$role" in
    architect|engineer) ;;
    tester)
      # E-255 (D-069): the Tester is headless — dispatched as a subagent, never a pane.
      echo "ai pane: tester is headless; run skill: ai-test" >&2
      return 2 ;;
    ""|-h|--help)
      echo "Usage: ai pane <architect|engineer> [-- <extra provider args>]"
      echo "  Binds THIS tmux pane to a role and launches that role's provider CLI."
      return 0 ;;
    *)
      echo "ai pane: unknown role '${role}' (expected: architect | engineer)" >&2
      return 2 ;;
  esac
  shift
  # Drop a leading `--` separator so `ai pane architect -- --foo` forwards --foo.
  [[ "${1:-}" == "--" ]] && shift

  local ai_dir; ai_dir="$(_find_ai_dir)"
  if [[ ! -d "$ai_dir" ]]; then
    echo "ai pane: not inside a Rein project (.ai/ not found). Run 'ai init' first." >&2
    return 2
  fi
  # E-327 (D-102 §3): the planner rule is enforced by add_task; this is the one-line notice.
  if [[ "$role" == "architect" && -f "${ai_dir}/team.json" ]] && command -v node >/dev/null 2>&1; then
    local _tc; _tc="$(_rein_helper shared/cli-state.mjs || true)"
    [[ -n "$_tc" ]] && ( cd "${ai_dir%/.ai}" && node --no-warnings "$_tc" team planner-check ) >&2 2>&1 || true
  fi

  # E-294 (D-087 r1, sovereignty-hardening.md Component 8b): `ai pane` is the ONE writer of
  # launch records, and a pane is launched from a terminal, never from inside a session. Refuse
  # — exit 2, nothing written, before any side effect — when an ancestor already holds a live
  # record: a nested `ai pane engineer` under an Architect session would otherwise mint a less
  # restricted role. Called DIRECTLY (never in $(…) or a pipeline): the module accepts only
  # its parent's pid, and a subshell's pid is not $$ (bash 3.2 has no BASHPID).
  local _lr; _lr="$(rein_locate shared/launch-record.py || true)"
  if [[ -z "$_lr" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "ai pane: launch-record.py or python3 not found — refusing to launch an unbound pane (run: ai install)." >&2
    return 2
  fi
  local _lr_rc=0
  python3 -I "$_lr" nested "$$" >&2 || _lr_rc=$?
  if [[ "$_lr_rc" -ne 0 ]]; then
    if [[ "$_lr_rc" -eq 3 ]]; then
      echo "[PANE_NESTED] ai pane: refusing to launch inside an existing Rein session — open a new terminal pane and run it there." >&2
    else
      echo "ai pane: could not check the process chain (rc ${_lr_rc}) — refusing." >&2
    fi
    return 2
  fi

  # E-242 (D-066): SELF-HEAL a missing per-role overlay before launching.
  #
  # The reported failure — "Settings file not found: .claude/settings.architect.json" —
  # was a PATH bug (fixed in resolve-launch.mjs), but the same message appears for a
  # genuinely absent overlay: a project cloned before E-208, or one whose `.claude/` was
  # cleaned. Regenerating it costs nothing and turns a dead-end error into a working pane.
  #
  # It writes only the ROLE OVERLAY, never `.claude/settings.json` — that file carries the
  # hooks and the env block, and rewriting it here would be a much larger side effect than
  # "start a pane" implies.
  local _proj; _proj="$(cd "$(dirname "$ai_dir")" && pwd)"
  if [[ ! -f "${_proj}/.claude/settings.${role}.json" ]]; then
    echo "ai pane: .claude/settings.${role}.json missing — regenerating it." >&2
    ( cd "$_proj" && _write_role_settings_overlays ".claude" ".ai" ) 2>/dev/null || true
    if [[ -f "${_proj}/.claude/settings.${role}.json" ]]; then
      echo "ai pane: overlay restored." >&2
    else
      echo "ai pane: could not regenerate the overlay — run 'ai init' in ${_proj}." >&2
    fi
  fi

  # `|| true`: the script runs under `set -e`, so an unguarded non-zero from the
  # locator would abort with exit 1 before the explicit error branch below could
  # report the real problem (and the documented exit code 2).
  local helper; helper="$(_locate_resolve_launch || true)"
  if [[ -z "$helper" ]]; then
    echo "ai pane: resolve-launch.mjs not found (run: ai install)." >&2
    return 2
  fi

  # Resolve provider + argv through the SHARED seam (src/shared/resolve-launch.mjs →
  # provider-adapter.mjs), the same module advisor-mcp uses (E-210). One code path, so
  # the A2A bridge, the launcher and the tests cannot drift apart about which provider
  # owns a role. Output: line 1 = provider, remaining lines = argv.
  local resolved rc
  resolved="$(node --no-warnings "$helper" "$role" "$ai_dir" 2>/dev/null)"; rc=$?
  if [[ "$rc" -ne 0 || -z "$resolved" ]]; then
    echo "ai pane: role '${role}' is not mapped to a provider in ${ai_dir}/roles.json." >&2
    return 2
  fi

  local provider; provider="$(printf '%s\n' "$resolved" | sed -n '1p')"
  local -a argv=()
  while IFS= read -r line; do [[ -n "$line" ]] && argv+=("$line"); done < <(printf '%s\n' "$resolved" | tail -n +2)

  # .ai/providers.json is ARCHITECT-WRITABLE and this value becomes an exec target,
  # so an unconstrained string here is an architect→engineer execution chain
  # (E-208 audit). Constrain it to a plain command name — no paths, no separators.
  if ! printf '%s' "$provider" | grep -qE '^[a-z][a-z0-9_-]{0,31}$'; then
    echo "ai pane: refusing to exec provider '${provider}' — invalid provider name in providers.json." >&2
    return 2
  fi

  # Distinguish the two failure modes the blueprint's §API contract separates
  # (critic_arch P2): a role with no provider mapping vs. a provider with no launch
  # adapter. Both exit 2, but the operator needs to know which file to edit.
  if [[ "${#argv[@]}" -eq 0 ]]; then
    echo "ai pane: provider '${provider}' has no 'launch' argv template in ${ai_dir}/providers.json (role ${role})." >&2
    return 2
  fi

  if ! command -v "$provider" >/dev/null 2>&1; then
    echo "ai pane: provider CLI '${provider}' is not on PATH (role ${role})." >&2
    return 2
  fi

  # E-315 (D-095, accounts.md §3): the project's account, read through the same validator as
  # `ai start`. Only a claude pane on a non-default account gets CLAUDE_CONFIG_DIR, and a name
  # that does not resolve REFUSES — a pane silently falling back to default would spend the
  # wrong subscription, the one thing accounts exist to prevent.
  local _pcfg _acct="" _acct_dir=""
  _pcfg="$(_start_config "$ai_dir")" || return 2
  _acct="${_pcfg##*|}"
  if [[ -n "$_acct" && "$provider" == "claude" ]]; then
    if ! declare -F _account_dir >/dev/null; then
      echo "ai pane: ai-account.sh is missing beside ai — run: bash install-rein.sh" >&2
      return 2
    fi
    _acct_dir="$(_account_dir "$_acct")" || { echo "ai pane: refusing to launch ${role} under account '${_acct}'." >&2; return 2; }
    if [[ -z "$_acct_dir" || ! -d "$_acct_dir" ]]; then
      echo "ai pane: account '${_acct}' has no directory — run: ai account add ${_acct}" >&2
      return 2
    fi
    _account_launch_check "$_acct" "$_acct_dir" || return 2
  fi

  # E-269 (D-073): bind THIS pane — the role is a pane OPTION; the title is only for
  # humans. Both are TARGETED at $TMUX_PANE: an untargeted `select-pane -T` writes the
  # title on the ACTIVE pane, which need not be this one. Claude Code rewrites titles
  # anyway; the option survives that.
  # No-op outside tmux; never fatal.
  if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux set-option -p -t "$TMUX_PANE" @rein_role "$role" 2>/dev/null || true
    local _acct_label=default; [[ -n "$_acct_dir" ]] && _acct_label="$_acct"
    tmux set-option -p -t "$TMUX_PANE" @rein_account "$_acct_label" 2>/dev/null || true
    tmux select-pane -t "$TMUX_PANE" -T "${role}${_acct_dir:+ · ${_acct}}" 2>/dev/null || true
    tmux set -w -t "$TMUX_PANE" allow-rename off 2>/dev/null || true
  fi

  # E-288 (D-079): an operator --name after `--` must win. Rather than rely on the CLI
  # treating a repeated flag as last-wins, drop the resolver's --name pair so exactly one
  # name reaches the CLI.
  local _a _op_name=0
  for _a in "$@"; do
    case "$_a" in --name|-n|--name=*) _op_name=1 ;; esac
  done
  if [[ "$_op_name" -eq 1 ]]; then
    local -a _kept=()
    local _i=0
    while [[ $_i -lt ${#argv[@]} ]]; do
      if [[ "${argv[$_i]}" == "--name" ]]; then _i=$((_i + 2)); continue; fi
      _kept+=("${argv[$_i]}"); _i=$((_i + 1))
    done
    argv=("${_kept[@]}")
  fi

  echo "ai pane: binding this pane to '${role}' via provider '${provider}'"
  # E-294: the launch record for THIS pid, written immediately before exec — the provider keeps
  # the pid (and its start time), so the SessionStart mint finds it on its chain. A failed
  # write refuses the launch: an unbound Architect pane would mint the plain-launch default.
  _lr_rc=0
  python3 -I "$_lr" write "$$" "$role" >/dev/null || _lr_rc=$?
  if [[ "$_lr_rc" -ne 0 ]]; then
    [[ "$_lr_rc" -eq 3 ]] && echo "[PANE_NESTED] ai pane: an ancestor became a live session — refusing." >&2
    echo "ai pane: could not write the launch record (rc ${_lr_rc}) — refusing to launch." >&2
    return 2
  fi
  # REIN_PANE_ROLE / REIN_CALLER_ROLE are ADVISORY now (prompts, advisor, handoff routing,
  # pre-commit's restrict-only row 4) — no gate reads them (D-087 r3).
  export REIN_PANE_ROLE="$role"
  export REIN_CALLER_ROLE="$role"
  # E-315: after the launch record, immediately before exec — default inherits the shell's own.
  if [[ -n "$_acct_dir" ]]; then
    echo "ai pane: account '${_acct}' ($(_acct_tilde "$_acct_dir"))"
    export CLAUDE_CONFIG_DIR="$_acct_dir"
  fi
  exec "$provider" "${argv[@]}" "$@"
}

# Nearest ancestor .ai/ directory (git-style discovery), so `ai pane` works from a
# subdirectory.
_find_ai_dir() {
  local dir; dir="$(pwd)"
  for _ in $(seq 1 40); do
    [[ -d "${dir}/.ai" ]] && { printf '%s' "${dir}/.ai"; return 0; }
    [[ "$dir" == "/" ]] && break
    dir="$(dirname "$dir")"
  done
  printf '%s' "$(pwd)/.ai"
}

# Locate the shared launch resolver: dev tree first, then the install mirror.
# (It imports provider-adapter.mjs from the same directory, so locating one locates both.)
_locate_resolve_launch() {
  local c
  # The heaviest of the three: its stdout decides which BINARY `ai pane` execs.
  rein_locate "shared/resolve-launch.mjs" && return 0
  # F3: keep the script-relative sibling as a LAST candidate. The shared resolver drops
  # the dev tree outside the recorded workspace, so a git worktree or a second framework
  # clone would exec a helper from a DIFFERENT version than the `ai` script that was
  # invoked. The install mirror still wins, so this costs nothing in trust — it only
  # stops silent version skew between this script and the helper it drives.
  local _sd; _sd="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  local _sib="${_sd%/*}/shared/resolve-launch.mjs"
  [[ -f "$_sib" ]] && { printf '%s' "$_sib"; return 0; }
  return 1
}

# ── E-265 (D-072, local-ci.md §Components 1-2): `ai ci run` ──────────────────
#
# GitHub-hosted CI gave us three things a bare `bash tests/run.sh` on a laptop does not: a
# CLEAN CHECKOUT (uncommitted files are invisible), a FRESH MIRROR installed from the
# commit under test (not the laptop's lagging ~/.rein), and a RECORD. This runner
# reproduces the first two and writes the log the third is built from (E-266 adds the row).
#
# Isolation is by construction, not by list: the steps run under `env -i` with a curated
# environment, so CI, TMUX and every launch variable `ai pane`/`ai start` export are simply
# absent — there is no strip list to fall out of date. HOME and TMPDIR are throwaway, so a
# run cannot write the operator's telemetry store, mirror or shell rc files.
#
# Exit codes: 0 PASS, 1 FAIL (suite, unit layer or secrets check failed), 2 ERROR (a step
# could not start: bad ref, lock held, deps/install failed). Unknown is not green (D-060).

_ci_usage() {
  cat <<'CIUSAGE'
Usage: ai ci run [--ref <sha>|HEAD] [--dirty] [--suite-only|--unit-only] [--lanes N] [--shard i/N] [--keep]
       ai ci status [<sha>|--ref <sha>] [--short]
       ai ci list [-n <N>]
       ai ci log [<sha>] [--failed]
       ai ci evals
       ai ci hosted [<provider>] [--check] [--force]
       ai ci budget [set --ruling D-### <field>=<n> …]

  hosted         Render the hosted trunk check for the provider (github; azure, gitlab,
                 bitbucket are planned — D-103): exactly two steps, bootstrap Rein then
                 'ai ci run' on the merge result. The provider is the argument, else
                 .ai/team.json ci, else the origin host. --check exits 1 when the file is not
                 the current rendering; an existing differing file needs --force. Prints the
                 branch-policy setting: required for merge, pushes left open (claims).
  evals          Run the core-skill evals (tests/suites/skill_evals_test.sh, E-285) under
                 YOUR HOME — the model needs your claude login, which a run's throwaway
                 HOME never has. Needs a clean tree outside .ai/; the JSON report is kept
                 as ~/.rein/ci/evals/<sha>.json and 'ai ci log' prints its path.
  --ref <rev>    Commit to test (default HEAD). Tested in a detached git worktree, so
                 uncommitted files are invisible to the run.
  --dirty        Test HEAD plus the working tree's uncommitted changes (the run is
                 marked dirty; a dirty run never certifies a commit).
  --suite-only   Run the bash suite only (skip the node:test unit layer).
  --unit-only    Run the node:test unit layer only (skip the bash suite).
  --lanes N      Run shared suites in N parallel lanes (default min(4, cores/2) here and
                 every core on a hosted runner — E-386; both clamped to free memory / 1.5 GB;
                 an explicit N above that is refused).
  --shard i/N    Run shard i of N of the suite (tests/run.sh --shard; E-386). The unit layer
                 and the budget run on shard 1 only; a shard run never certifies a commit
                 ('ai ci status' reports SHARD i/N) and never writes the census baseline.
  --keep         Keep the worktree and throwaway HOME for debugging.
  budget         The test budget (E-303): suites, test_lines and fast_tier_seconds only move
                 down — a full run over the best recorded value (slack: suites +0, test_lines
                 +2%, fast tier +10%) FAILS. 'set --ruling D-###' is the only way to raise it.

Per-machine environment (E-343, D-108): the run starts from an empty environment. A project
service this machine runs differently (a port, a local URL) is listed in the gitignored
.ai/ci.local.json — {"env": ["NAME", "NAME=value"]}: a bare NAME passes your shell's value
through (never written to the file or the log; unset = skipped), NAME=value sets a literal.
The env step names what was added (env ok … +NAME). Reserved, refused as ERROR with
[CI_ENV_RESERVED]: PATH HOME TMPDIR SHELL TERM USER LOGNAME LANG CI TMUX, REIN_*,
npm_config_*, PLAYWRIGHT_* and the pane launch variables. A hosted run never sees the file.

run exit: 0 PASS, 1 FAIL, 2 ERROR. Logs: ~/.rein/ci/logs/ (newest 14 runs, 14 days).
status exit: 0 PASS, 1 FAIL/ERROR/SKIPPED, 2 no certifying run (none, or dirty/shard only).
After a full PASS it writes tests/census-baseline.tsv (E-386) when the committed one is
missing or older than 30 full runs — commit it: a fresh hosted runner packs its lanes by it.
Each run is recorded in the project's .ai/state.sqlite (ci_runs, E-266). In a team project
(.ai/team.json) it also writes the tracked .ai/ci/<sha>.json (counts only, E-328): commit it,
and a teammate's PASS record certifies that sha on your clone too. 'ai ci status' names the
source — the local run or the record and its runner.
CIUSAGE
}

do_ci() {
  local sub="${1:-}"
  case "$sub" in
    run) shift; _ci_run "$@" ;;
    evals) shift; _ci_evals "$@" ;;
    hosted) shift; _ci_hosted "$@" ;;
    status|list|log) shift; _ci_read "$sub" "$@" ;;
    budget) shift; _ci_budget "$@" ;;
    ""|-h|--help|help) _ci_usage ;;
    *) echo "ai ci: unknown subcommand '${sub}'" >&2; _ci_usage >&2; return 2 ;;
  esac
}

# _ci_budget — E-303 (D-088): `ai ci budget` prints the test budget; `ai ci budget set --ruling
# D-### field=n …` raises it, writing the ruling id into the CI record. No flag or env var lifts a
# regression; a ruling is the only way up, and without a D-### id the command refuses.
_ci_budget() {
  local root helper
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "ai ci budget: not inside a git repository" >&2; return 2; }
  helper="$(_rein_helper shared/ci-record.mjs || true)"
  [[ -n "$helper" ]] || { echo "ai ci: ci-record.mjs not found (run: ai install)" >&2; return 2; }
  case "${1:-}" in
    "") node "${_CI_NODE_FLAGS[@]}" "$helper" budget --ai-dir "${root}/.ai" ;;
    set) shift
         local ruling=""
         local -a vals=()
         while [[ $# -gt 0 ]]; do
           case "$1" in
             --ruling) ruling="${2:-}"; shift 2 || { echo "ai ci budget set: --ruling needs D-###" >&2; return 2; } ;;
             --ruling=*) ruling="${1#--ruling=}"; shift ;;
             *) vals+=("$1"); shift ;;
           esac
         done
         node "${_CI_NODE_FLAGS[@]}" "$helper" budget-set --ai-dir "${root}/.ai" --ruling "$ruling" "${vals[@]+"${vals[@]}"}" ;;
    *) echo "ai ci budget: unknown argument '$1' — usage: ai ci budget [set --ruling D-### field=n …]" >&2; return 2 ;;
  esac
}

# _ci_evals — E-285 (D-075 native-first §8): the core-skill evals need an authenticated
# claude, and `ai ci run`'s throwaway HOME never has one (its suite layer SKIPs there by
# design). So this runs the eval suite in the working tree under the operator's own HOME and
# keeps the report by HEAD's sha. A tree dirty outside .ai/ is refused: the report must
# describe the commit it is filed under.
_ci_evals() {
  [[ $# -eq 0 ]] || { echo "ai ci evals: takes no arguments" >&2; return 2; }
  local root sha dir report rc=0
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "ai ci evals: not inside a git repository" >&2; return 2; }
  if [[ -n "$(git -C "$root" status --porcelain -- . ':!.ai' 2>/dev/null)" ]]; then
    echo "ai ci evals: uncommitted changes outside .ai/ — commit first; the report is filed under HEAD" >&2
    return 2
  fi
  sha="$(git -C "$root" rev-parse HEAD)"
  dir="${REIN}/ci/evals"; report="${dir}/${sha}.json"
  mkdir -p "$dir" && rm -f "$report"
  REIN_SKILL_EVAL_REPORT="$report" bash "${root}/tests/suites/skill_evals_test.sh" || rc=$?
  if [[ ! -f "$report" ]]; then
    echo "ai ci evals: no report for ${sha:0:7} — the live layer did not run (see SKIPPED above)"
    return $(( rc ? 1 : 2 ))
  fi
  echo "ai ci evals: $([[ $rc -eq 0 ]] && echo PASS || echo FAIL) ${sha:0:7} — report: ${report}"
  return $(( rc ? 1 : 0 ))
}

# _ci_hosted — E-335 (D-103): render / check the provider's hosted-check wrapper. The logic is
# src/shared/hosted-ci.mjs; this only finds the repository root.
_ci_hosted() {
  local root helper
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "ai ci hosted: not inside a git repository" >&2; return 2; }
  helper="$(_rein_helper shared/hosted-ci.mjs || true)"
  [[ -n "$helper" ]] && command -v node >/dev/null 2>&1 || {
    echo "ai ci hosted: hosted-ci.mjs or node unavailable — run: bash install-rein.sh" >&2; return 2; }
  node --no-warnings "$helper" --root "$root" "$@"
}

# _ci_load — "load1 load5 load15 / ncpu" (E-296, D-085 r3): a run on an overloaded host says so
# in its own log, so a timing failure can be read against the load it ran under.
_ci_load() {
  local la n
  la="$(uptime 2>/dev/null | sed -E 's/.*load averages?: *//; s/,//g')"
  n="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo '?')"
  printf '%s / ncpu %s' "${la:-?}" "$n"
}

# _ci_step <name> <status> [detail] — one aligned status line per step.
_ci_step() {
  printf '  %-10s %-7s %s\n' "$1" "$2" "${3:-}"
  printf '[ci] step=%s status=%s %s\n' "$1" "$2" "${3:-}" >> "$CI_LOG"
}

# _ci_exec <label> <cmd...> — run a step command inside the curated env, cwd = worktree,
# output to the log only.
_ci_exec() {
  local label="$1"; shift
  printf '\n[ci] ── %s: %s\n' "$label" "$*" >> "$CI_LOG"
  ( cd "$CI_WT" && env -i "${CI_ENV[@]}" "$@" ) >> "$CI_LOG" 2>&1
}

# _ci_fail_tail — show the end of the log when a setup step dies, so the operator does not
# have to go find it.
_ci_fail_tail() {
  echo "  ── last 20 log lines ──"
  tail -20 "$CI_LOG" | sed 's/^/  | /'
}

# _ci_clean_path — the caller's PATH minus any entry inside the operator's ~/.rein: the run
# must use the mirror it installed from the commit under test, never the laptop's.
_ci_clean_path() {
  local out="" p
  local IFS=':'
  for p in $PATH; do
    [[ -z "$p" || "$p" == "${REIN}" || "$p" == "${REIN}/"* ]] && continue
    out="${out:+${out}:}${p}"
  done
  printf '%s' "$out"
}

# _ci_lock_acquire <lockdir> — atomic mkdir lock holding the owner pid. A lock whose owner
# is dead is reclaimed; a live one refuses (two runs race on tmux sockets and ports).
_ci_lock_acquire() {
  local lock="$1" owner
  if mkdir "$lock" 2>/dev/null; then
    echo "$$" > "${lock}/pid"; return 0
  fi
  owner="$(cat "${lock}/pid" 2>/dev/null || true)"
  if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
    echo "ai ci: another run is in progress for this project (pid ${owner}, lock ${lock})" >&2
    return 1
  fi
  # Stale: the owner is gone. Reclaim it, then take it atomically like a fresh lock.
  rm -rf "$lock"
  if mkdir "$lock" 2>/dev/null; then
    echo "$$" > "${lock}/pid"; return 0
  fi
  echo "ai ci: could not take the run lock ${lock}" >&2
  return 1
}

# _ci_wall_hints → the newest log of THIS project carrying CENSUS_SUITE lines (the runner's
# throwaway HOME cannot see ~/.rein/ci/logs), for longest-first lane placement (E-309).
# _ci_host_class → "hosted:<provider>" on a hosted runner (its own environment markers; CI=true
# alone → hosted:ci), else "local". E-386 (D-135 r1): every core is a lane on a hosted runner.
# The markers are in the E-343 reserved set, so .ai/ci.local.json cannot claim "hosted".
_ci_host_class() {
  if [[ -n "${GITHUB_ACTIONS:-}" ]]; then echo "hosted:github"
  elif [[ -n "${TF_BUILD:-}" ]]; then echo "hosted:azure"
  elif [[ -n "${GITLAB_CI:-}" ]]; then echo "hosted:gitlab"
  elif [[ -n "${BITBUCKET_BUILD_NUMBER:-}" ]]; then echo "hosted:bitbucket"
  elif [[ "${CI:-}" == "true" ]]; then echo "hosted:ci"
  else echo "local"
  fi
}

# _ci_baseline <sha> — E-386: write tests/census-baseline.tsv into the project tree from this
# run's log when the baseline committed at <sha> is missing or stale (ci-record.mjs
# census-stale). Writing only then keeps the file still between refreshes: a rewrite after
# every run would leave the tree dirty and each commit of it would need a run of its own.
_ci_baseline() {
  local sha="$1" helper age out
  helper="$(_rein_helper shared/ci-record.mjs || true)"
  [[ -n "$helper" && -d "${CI_ROOT}/.ai" && -d "${CI_ROOT}/tests" ]] || return 0
  age="$(node "${_CI_NODE_FLAGS[@]}" "$helper" census-stale --ai-dir "${CI_ROOT}/.ai" --sha "$sha" 2>/dev/null || true)"
  case "$age" in
    MISSING|STALE*) ;;
    *) _ci_step baseline skip "committed baseline is fresh (${age:-unknown})"; return 0 ;;
  esac
  if out="$(node --no-warnings "${CI_WT}/tests/tools/census.mjs" --baseline-from "$CI_LOG" \
        --baseline-out "${CI_ROOT}/tests/census-baseline.tsv" 2>&1)"; then
    _ci_step baseline ok "tests/census-baseline.tsv written (${age}) — commit it"
  else
    _ci_step baseline skip "not written: ${out##*: }"
  fi
}

_ci_wall_hints() {
  local f
  # The log directory is machine-wide: a log from another project's run (its own suites,
  # its own names) is skipped by its [ci] repo= line.
  for f in $(ls -1t "${CI_LOGDIR:-${HOME}/.rein/ci/logs}"/*.log 2>/dev/null | head -20); do
    grep -qxF "[ci] repo=${CI_ROOT:-}" "$f" 2>/dev/null || continue
    grep -q '^CENSUS_SUITE' "$f" 2>/dev/null && { echo "$f"; return 0; }
  done
  return 0
}
# E-343 (D-108 r9): the per-machine environment allow-list, gitignored .ai/ci.local.json
# {"env": ["NAME", "NAME=value", …]}. A bare name passes the invoking environment's value through
# (absent = skipped with a note), NAME=value is a literal. The isolation invariants cannot be
# overridden: [CI_ENV_RESERVED] is an ERROR. Sets CI_LOCAL_ENV (NAME=value entries for env -i),
# CI_LOCAL_NOTE (names only — never a value) and CI_LOCAL_ERR; returns 2 on an error. Called as
# a plain command (it sets state — D-064 §2). The reserved names mirror tests/lib/launch-vars.sh
# LAUNCH_VARS (E-264); ai_ci_test.sh fails when the two lists drift.
CI_ENV_RESERVED_NAMES="PATH HOME TMPDIR SHELL TERM USER LOGNAME LANG CI TMUX REIN_PANE_ROLE REIN_CALLER_ROLE REIN_WORKSPACE CLAUDE_CONFIG_DIR"
CI_ENV_RESERVED_PREFIXES="REIN_ AI_OS_ AIOS_ npm_config_ PLAYWRIGHT_"  # rename:legacy-fallback (E-383: `ai` maps the old names onto REIN_)
_ci_local_env() {
  CI_LOCAL_ENV=(); CI_LOCAL_NOTE=""; CI_LOCAL_ERR=""
  local file="${1}/.ai/ci.local.json" kind name val
  [[ -f "$file" ]] || return 0
  command -v node >/dev/null 2>&1 || { CI_LOCAL_ERR="node is required to read ${file}"; return 2; }
  local out
  out="$(CI_ENV_RESERVED_NAMES="$CI_ENV_RESERVED_NAMES" CI_ENV_RESERVED_PREFIXES="$CI_ENV_RESERVED_PREFIXES" node -e '
    const fs = require("fs");
    const fail = (m) => { process.stdout.write("E\0" + m + "\0"); process.exit(0); };
    let doc;
    try { doc = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
    catch (e) { fail(".ai/ci.local.json is not valid JSON — " + String(e.message).split("\n")[0].slice(0, 160)); }
    if (!doc || typeof doc !== "object" || !Array.isArray(doc.env)) fail(".ai/ci.local.json: \"env\" must be an array of \"NAME\" or \"NAME=value\" strings");
    const names = new Set(process.env.CI_ENV_RESERVED_NAMES.split(" "));
    const prefixes = process.env.CI_ENV_RESERVED_PREFIXES.split(" ");
    const recs = [];
    for (const e of doc.env) {
      if (typeof e !== "string") fail(".ai/ci.local.json: every env entry must be a string");
      const i = e.indexOf("=");
      const name = i < 0 ? e : e.slice(0, i);
      if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) fail(".ai/ci.local.json: " + JSON.stringify(name.slice(0, 60)) + " is not a variable name");
      if (names.has(name) || prefixes.some((p) => name.startsWith(p))) fail("[CI_ENV_RESERVED] " + name + " — the run'"'"'s isolation sets it; it cannot come from .ai/ci.local.json");
      if (i >= 0) recs.push("L", name, e.slice(i + 1));
      else if (Object.prototype.hasOwnProperty.call(process.env, name)) recs.push("P", name, process.env[name]);
      else recs.push("S", name, "");
    }
    process.stdout.write(recs.join("\0") + (recs.length ? "\0" : ""));
  ' "$file" | tr '\0' '\036')" || { CI_LOCAL_ERR="could not read ${file}"; return 2; }
  # \036 (RS) separates fields: bash cannot hold NUL in a variable.
  local -a f
  IFS=$'\036' read -r -d '' -a f < <(printf '%s' "$out") || true
  if [[ "${f[0]:-}" == "E" ]]; then CI_LOCAL_ERR="${f[1]}"; return 2; fi
  local i
  for (( i = 0; i < ${#f[@]}; i += 3 )); do
    kind="${f[i]}"; name="${f[i+1]:-}"; val="${f[i+2]:-}"
    [[ -n "$name" ]] || continue
    case "$kind" in
      L|P) CI_LOCAL_ENV+=("${name}=${val}"); CI_LOCAL_NOTE+=" +${name}" ;;
      S)   CI_LOCAL_NOTE+=" (${name} unset in this shell — skipped)" ;;
    esac
  done
  return 0
}

_ci_run() {
  local ref="" dirty=0 do_suite=1 do_unit=1 keep=0 lanes="" lanes_auto=0 shard=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lanes) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { echo "ai ci run: --lanes needs a positive integer" >&2; return 2; }
               lanes="$2"; shift 2 ;;
      --shard) if [[ ! "${2:-}" =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || (( BASH_REMATCH[1] > BASH_REMATCH[2] )); then
                 echo "ai ci run: --shard needs i/N with 1 ≤ i ≤ N" >&2; return 2
               fi
               shard="$2"; shift 2 ;;
      --ref) [[ $# -ge 2 && -n "$2" ]] || { echo "ai ci run: --ref needs a value" >&2; return 2; }
             ref="$2"; shift 2 ;;
      --ref=*) ref="${1#--ref=}"; shift ;;
      --dirty) dirty=1; shift ;;
      --suite-only) do_unit=0; shift ;;
      --unit-only) do_suite=0; shift ;;
      --keep) keep=1; shift ;;
      -h|--help) _ci_usage; return 0 ;;
      *) echo "ai ci run: unknown option '$1'" >&2; _ci_usage >&2; return 2 ;;
    esac
  done
  if [[ "$do_suite" -eq 0 && "$do_unit" -eq 0 ]]; then
    echo "ai ci run: --suite-only and --unit-only are mutually exclusive" >&2; return 2
  fi
  # E-309 (D-091): default lanes = min(4, cores/2), clamped (not refused) by tests/run.sh's
  # memory cap; an explicit --lanes is passed as asked and refused above the cap.
  # E-386 (D-135 r1): a hosted runner is a machine of its own — every core is a lane there.
  local ci_host; ci_host="$(_ci_host_class)"
  if [[ -z "$lanes" ]]; then
    local _cores; _cores="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 2)"
    if [[ "$ci_host" == hosted:* ]]; then
      lanes="$_cores"
    else
      lanes=$(( _cores / 2 )); (( lanes > 4 )) && lanes=4
    fi
    (( lanes < 1 )) && lanes=1
    lanes_auto=1
  fi
  # A dirty run tests HEAD plus the working tree; testing another ref "dirty" has no meaning.
  if [[ "$dirty" -eq 1 && -n "$ref" ]]; then
    echo "ai ci run: --dirty tests HEAD plus the working tree; it cannot be combined with --ref" >&2
    return 2
  fi
  ref="${ref:-HEAD}"

  local root sha
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "ai ci run: not inside a git repository" >&2; return 2; }
  sha="$(git -C "$root" rev-parse --verify --quiet "${ref}^{commit}")" || {
    echo "ai ci run: '${ref}' is not a commit in ${root}" >&2; return 2; }

  local ci_home="${REIN}/ci"
  mkdir -p "${ci_home}/logs" "${ci_home}/cache/npm" "${ci_home}/cache/ms-playwright" || {
    echo "ai ci run: cannot create ${ci_home}" >&2; return 2; }
  # E-336 (D-103): Azure Pipelines cannot expand $HOME in a task input, so the hosted wrapper's
  # artefact step reads the log directory from a pipeline variable set here. TF_BUILD=True is
  # Azure's own marker; the line is inert everywhere else. CR/LF stripped: a ##vso command is
  # one line.
  if [[ "${TF_BUILD:-}" == "True" ]]; then
    local _azlog="${ci_home}/logs"; _azlog="${_azlog//[$'\r\n']/}"
    printf '##vso[task.setvariable variable=REIN_CI_LOG_DIR]%s\n' "$_azlog"
  fi

  # One lock per project, keyed by the repository path.
  local key lock
  key="$(printf '%s' "$root" | cksum | awk '{print $1}')"
  lock="${ci_home}/run-${key}.lock"
  _ci_lock_acquire "$lock" || return 2

  local started started_iso t0 work
  started="$(date -u +%Y%m%dT%H%M%SZ)"
  started_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  t0="$(date +%s)"
  CI_LOG="${ci_home}/logs/${sha}-${started}.log"
  local tmpbase="${TMPDIR:-/tmp}"
  work="$(mktemp -d "${tmpbase%/}/rein-ci.XXXXXX")" || {
    rm -rf "$lock"; echo "ai ci run: mktemp failed" >&2; return 2; }
  # PHYSICAL path. macOS TMPDIR is /var/folders/…, a symlink to /private/var/folders/…, and
  # the node helpers' "am I the main module?" checks compare argv[1] against the resolved
  # import.meta.url — so under the symlinked spelling every `node <mirror>/shared/*.mjs`
  # CLI entry silently did nothing (the first real run failed 20 sync/handoff assertions).
  work="$(cd "$work" && pwd -P)"
  CI_WT="${work}/wt"
  local ci_homedir="${work}/home" ci_tmp="${work}/tmp"
  mkdir -p "$ci_homedir" "$ci_tmp"

  # Cleanup runs on every exit path. The lock is always released; the worktree and HOME
  # only without --keep.
  _CI_CLEAN_ROOT="$root" _CI_CLEAN_WORK="$work" _CI_CLEAN_LOCK="$lock" _CI_CLEAN_KEEP="$keep"
  trap '_ci_cleanup' EXIT
  trap '_ci_cleanup; exit 130' INT TERM

  {
    echo "[ci] ai ci run — Rein ${VERSION}"
    echo "[ci] sha=${sha} ref=${ref} dirty=${dirty} started_at=${started_iso}"
    [[ -n "$shard" ]] && echo "[ci] shard ${shard}"
    echo "[ci] repo=${root}"
    echo "[ci] branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  } > "$CI_LOG"
  CI_ROOT="$root"; CI_LOGDIR="${ci_home}/logs"

  echo "ai ci run: ${sha:0:7} (${ref}$([[ $dirty -eq 1 ]] && echo ', dirty')${shard:+, shard ${shard}})"
  local status="PASS" rc

  # ── E-343: the per-machine env allow-list is read (and refused) before anything is checked out ──
  if ! _ci_local_env "$root"; then
    _ci_step env ERROR "$CI_LOCAL_ERR"
    _ci_finish ERROR "$sha" "$t0"; return 2
  fi

  # ── worktree ──
  if ! git -C "$root" worktree add --detach --quiet "$CI_WT" "$sha" >> "$CI_LOG" 2>&1; then
    _ci_step worktree ERROR "git worktree add failed"; _ci_fail_tail
    _ci_finish ERROR "$sha" "$t0"; return 2
  fi
  if [[ "$dirty" -eq 1 ]]; then
    # Overlay the working tree onto the HEAD checkout: modified and untracked (non-ignored)
    # files are copied, deleted files removed. The operator's tree is only read.
    local f n_copy=0 n_del=0
    while IFS= read -r -d '' f; do
      [[ -e "${root}/${f}" || -L "${root}/${f}" ]] || continue
      mkdir -p "$(dirname "${CI_WT}/${f}")"
      cp -Pp "${root}/${f}" "${CI_WT}/${f}" && n_copy=$((n_copy + 1))
    done < <(git -C "$root" ls-files -z --modified --others --exclude-standard)
    while IFS= read -r -d '' f; do
      rm -f "${CI_WT}/${f}" && n_del=$((n_del + 1))
    done < <(git -C "$root" ls-files -z --deleted)
    _ci_step worktree ok "${CI_WT} (dirty: ${n_copy} copied, ${n_del} removed)"
  else
    _ci_step worktree ok "${CI_WT}"
  fi

  # ── env ──
  CI_ENV=(
    "PATH=$(_ci_clean_path)"
    "HOME=${ci_homedir}"
    "TMPDIR=${ci_tmp}/"
    "LANG=${LANG:-en_US.UTF-8}"
    "USER=${USER:-$(id -un)}"
    "LOGNAME=${LOGNAME:-$(id -un)}"
    "SHELL=/bin/bash"
    "TERM=dumb"
    "REIN_CI=local"
    "PLAYWRIGHT_BROWSERS_PATH=${ci_home}/cache/ms-playwright"
    "npm_config_cache=${ci_home}/cache/npm"
    ${CI_LOCAL_ENV[@]+"${CI_LOCAL_ENV[@]}"}
  )
  _ci_step env ok "HOME=${ci_homedir} REIN_CI=local${CI_LOCAL_NOTE}"
  _ci_step load info "start: $(_ci_load)"

  # ── deps ──
  if [[ -f "${CI_WT}/package.json" ]]; then
    if [[ -f "${CI_WT}/package-lock.json" ]]; then
      _ci_exec deps npm ci --ignore-scripts || {
        _ci_step deps ERROR "npm ci failed"; _ci_fail_tail; _ci_finish ERROR "$sha" "$t0"; return 2; }
    else
      _ci_exec deps npm install --ignore-scripts || {
        _ci_step deps ERROR "npm install failed"; _ci_fail_tail; _ci_finish ERROR "$sha" "$t0"; return 2; }
    fi
    # Per-server installs, best-effort exactly as the workflow ran them.
    local d n_srv=0
    for d in "${CI_WT}"/src/mcp/*/; do
      [[ -f "${d}package.json" ]] || continue
      _ci_exec "deps ${d#"${CI_WT}/"}" npm install --prefix "$d" --ignore-scripts || true
      n_srv=$((n_srv + 1))
    done
    _ci_step deps ok "root + ${n_srv} server(s)"
  else
    _ci_step deps skip "no package.json"
  fi

  # ── browsers ──
  local vibe="${CI_WT}/src/mcp/vibe-check-mcp"
  if [[ -f "${vibe}/package.json" ]]; then
    local cached="download"
    compgen -G "${ci_home}/cache/ms-playwright/chromium-*" >/dev/null && cached="cache hit"
    if ( cd "$vibe" && env -i "${CI_ENV[@]}" npx --no-install playwright install chromium ) >> "$CI_LOG" 2>&1; then
      _ci_step browsers ok "chromium (${cached})"
    else
      _ci_step browsers ERROR "playwright install chromium failed"; _ci_fail_tail
      _ci_finish ERROR "$sha" "$t0"; return 2
    fi
  else
    _ci_step browsers skip "no src/mcp/vibe-check-mcp"
  fi

  # ── install ── the mirror under test is built from the commit under test.
  if [[ -f "${CI_WT}/install-rein.sh" ]]; then
    _ci_exec install bash install-rein.sh || {
      _ci_step install ERROR "install-rein.sh failed"; _ci_fail_tail; _ci_finish ERROR "$sha" "$t0"; return 2; }
    _ci_step install ok "${ci_homedir}/.rein"
  else
    _ci_step install skip "no install-rein.sh"
  fi

  # ── toolchain ──
  local v_node v_bash v_patch v_os
  v_node="$(env -i "${CI_ENV[@]}" node --version 2>/dev/null || echo none)"
  v_bash="$(/bin/bash -c 'echo $BASH_VERSION' 2>/dev/null || echo none)"
  v_patch="$(env -i "${CI_ENV[@]}" patch --version 2>/dev/null | head -1 || echo none)"
  v_os="$(uname -sr)"
  printf '[ci] toolchain node=%s bash=%s patch=%s os=%s\n' "$v_node" "$v_bash" "${v_patch:-none}" "$v_os" >> "$CI_LOG"
  _ci_step toolchain ok "node ${v_node}, bash ${v_bash}, ${v_os}"

  # ── suite ──
  local suite_status="SKIPPED" s_pass=0 s_fail=0 s_skip=0 leaked=0
  if [[ "$do_suite" -eq 1 && -f "${CI_WT}/tests/run.sh" ]]; then
    printf '\n[ci] ── suite: /bin/bash tests/run.sh\n' >> "$CI_LOG"
    set +e
    # E-312 (D-093): no operator opt-out of the memory cap — REIN_TEST_FREE_MB is the lane
    # fixture's stand-in inside tests/run.sh only, and env -i keeps it from reaching the run.
    local _ci_lane_env=(REIN_TEST_LANES="$lanes" REIN_TEST_LANES_AUTO="$lanes_auto" REIN_TEST_WALL_HINTS="$(_ci_wall_hints)")
    [[ -n "$shard" ]] && _ci_lane_env+=(REIN_TEST_SHARD="$shard")
    # E-310 (D-091): the suite step's peak resident memory, by the OS's own accounting —
    # /usr/bin/time -l (macOS, bytes) or GNU -v (Linux, kB) into a file of its own, so the
    # suite's stderr stays the suite's. Neither → recorded as skipped, with the reason.
    local _rss_file="${work}/suite-rusage.txt" _timecmd=() rss_skip="" peak_rss="-" _s0=$SECONDS
    if [[ ! -x /usr/bin/time ]]; then
      rss_skip="no /usr/bin/time"
    elif [[ "$(uname -s)" == "Darwin" ]]; then
      _timecmd=(/usr/bin/time -l -o "$_rss_file")
    elif /usr/bin/time -v -o /dev/null true >/dev/null 2>&1; then
      _timecmd=(/usr/bin/time -v -o "$_rss_file")
    else
      rss_skip="/usr/bin/time is not GNU time (no -v)"
    fi
    ( cd "$CI_WT" && "${_timecmd[@]+"${_timecmd[@]}"}" env -i "${CI_ENV[@]}" "${_ci_lane_env[@]}" /bin/bash tests/run.sh ) 2>&1 | tee -a "$CI_LOG"
    rc="${PIPESTATUS[0]}"
    set -e
    local suite_seconds=$(( SECONDS - _s0 ))
    if [[ -s "$_rss_file" ]]; then
      peak_rss="$(awk '/maximum resident set size/ && $1 ~ /^[0-9]+$/ {print int($1 / 1048576)}
                       /Maximum resident set size \(kbytes\)/ {print int($NF / 1024)}' "$_rss_file" | tail -1)"
      [[ "$peak_rss" =~ ^[0-9]+$ ]] || { peak_rss="-"; rss_skip="no maximum resident set size in the time report"; }
    elif [[ -z "$rss_skip" ]]; then
      rss_skip="/usr/bin/time wrote no report"
    fi
    # The summary: every runner's shape (E-310 — a downstream project's vitest totals recorded pass=0),
    # read from the suite section only. A mirror that predates ci-summary.mjs falls back to
    # the Rein line, as before.
    local runner="rein" sumhelper totals
    sumhelper="$(_rein_helper shared/ci-summary.mjs || true)"
    if [[ -n "$sumhelper" ]] && command -v node >/dev/null 2>&1; then
      totals="$(node --no-warnings "$sumhelper" "$CI_LOG" --after "[ci] ── suite:" 2>/dev/null || true)"
      runner="$(sed -nE 's/^runner=([^ ]+) .*/\1/p' <<< "$totals")"
      s_pass="$(sed -nE 's/.* pass=([0-9]+).*/\1/p' <<< "$totals")"
      s_fail="$(sed -nE 's/.* fail=([0-9]+).*/\1/p' <<< "$totals")"
      s_skip="$(sed -nE 's/.* skip=([0-9]+).*/\1/p' <<< "$totals")"
    else
      totals="$(grep -E '^ *Total: [0-9]+ passed' "$CI_LOG" | tail -1 || true)"
      s_pass="$(sed -nE 's/.*Total: ([0-9]+) passed.*/\1/p' <<< "$totals")"
      s_fail="$(sed -nE 's/.* ([0-9]+) failed.*/\1/p' <<< "$totals")"
      s_skip="$(sed -nE 's/.* ([0-9]+) skipped.*/\1/p' <<< "$totals")"
    fi
    leaked="$(sed -nE 's/.*LEAKED external state: ([0-9]+) item.*/\1/p' "$CI_LOG" | tail -1)"
    s_pass="${s_pass:-0}"; s_fail="${s_fail:-0}"; s_skip="${s_skip:-0}"; leaked="${leaked:-0}"
    # What the step spent, for the record: the lane count the runner actually used (after
    # the memory clamp), peak RSS, wall seconds, and whose summary the counts came from.
    # E-386: exclusive_seconds is the serial tail (the run's own, last, [run] line; "-" at one
    # lane, where nothing is classed) and host names where it ran (local / hosted:<provider>).
    printf '[ci] resources lanes=%s peak_rss_mb=%s suite_seconds=%s exclusive_seconds=%s host=%s runner=%s%s\n' \
      "$(sed -nE 's/^   Lanes: ([0-9]+)$/\1/p' "$CI_LOG" | tail -1 | grep . || echo 1)" \
      "$peak_rss" "$suite_seconds" \
      "$(sed -nE 's/^\[run\] exclusive_seconds=([0-9]+).*/\1/p' "$CI_LOG" | tail -1 | grep . || echo -)" \
      "$ci_host" "${runner:-none}" "${rss_skip:+ rss_skip=${rss_skip}}" >> "$CI_LOG"
    if [[ "$rc" -eq 0 ]]; then suite_status="PASS"; else suite_status="FAIL"; status="FAIL"; fi
    _ci_step suite "$suite_status" "${s_pass} passed, ${s_fail} failed, ${s_skip} skipped, leaked ${leaked}"
  elif [[ "$do_suite" -eq 1 ]]; then
    _ci_step suite skip "no tests/run.sh"
  else
    _ci_step suite skip "--unit-only"
  fi

  # ── unit ──
  local unit_status="SKIPPED"
  # E-386: the unit layer belongs to shard 1 (tests/run.sh pins node_unit_test.sh there too).
  if [[ -n "$shard" && "${shard%%/*}" != "1" ]]; then
    _ci_step unit skip "shard ${shard} — the unit layer runs on shard 1"
  elif [[ "$do_unit" -eq 1 && -f "${CI_WT}/tests/suites/node_unit_test.sh" ]]; then
    if _ci_exec unit /usr/bin/env UNIT_COVERAGE=1 /bin/bash tests/suites/node_unit_test.sh; then
      unit_status="PASS"
    else
      unit_status="FAIL"; status="FAIL"
    fi
    _ci_step unit "$unit_status" "node:test (coverage)"
  elif [[ "$do_unit" -eq 1 ]]; then
    _ci_step unit skip "no tests/suites/node_unit_test.sh"
  else
    _ci_step unit skip "--suite-only"
  fi

  # ── budget ── E-303 (D-088, test-economics.md §Component 7): the ratchet. A full run (suite and
  # unit) of a repository that carries the census measures suites and test_lines (the census's
  # own inventory), the fast tier's wall seconds (`tests/run.sh --tier fast`, timed alone) and
  # full_seconds (the suite step); then ci-record.mjs compares them with the best recorded
  # since the latest ruling. A regression FAILS the run, with recorded/measured/slack on one
  # line. No flag or env var lifts it: `ai ci budget set --ruling D-###` is the only way up.
  # E-386: on a shard the budget runs once, on shard 1; its full_seconds and peaks describe a
  # part of the run, so they are recorded as "-" (absent) and never become a best or a drift.
  if [[ "$do_suite" -eq 1 && "$do_unit" -eq 1 && -f "${CI_WT}/tests/tools/census.mjs" ]] \
     && [[ -z "$shard" || "${shard%%/*}" == "1" ]] \
     && grep -q -- '--tier' "${CI_WT}/tests/run.sh" 2>/dev/null; then
    local _inv _fast_s0 _fast_rc=0 fast_s="-" budget_helper
    _inv="$(CENSUS_MJS="${CI_WT}/tests/tools/census.mjs" CENSUS_REPO="$CI_WT" node --no-warnings --input-type=module -e '
      const { inventory } = await import(process.env.CENSUS_MJS);
      const i = inventory(process.env.CENSUS_REPO);
      process.stdout.write(`${i.suites.length} ${i.testLines}`);' 2>/dev/null || true)"
    printf '\n[ci] ── fast tier: /bin/bash tests/run.sh --tier fast\n' >> "$CI_LOG"
    _fast_s0=$SECONDS
    ( cd "$CI_WT" && env -i "${CI_ENV[@]}" /bin/bash tests/run.sh --tier fast ) >> "$CI_LOG" 2>&1 || _fast_rc=$?
    [[ "$_fast_rc" -eq 0 ]] && fast_s=$(( SECONDS - _fast_s0 ))
    printf '[ci] budget suites=%s test_lines=%s fast_tier_seconds=%s full_seconds=%s peak_rss_mb=%s peak_sum_rss_mb=%s\n' \
      "$(cut -d' ' -f1 <<< "${_inv:--}")" "$(cut -d' ' -f2 <<< "${_inv:-- -}")" "$fast_s" \
      "$([[ -n "$shard" ]] && echo - || echo "${suite_seconds:--}")" "$([[ -n "$shard" ]] && echo - || echo "${peak_rss:--}")" \
      "$([[ -n "$shard" ]] && echo - || { sed -nE 's/^\[run\] peak_sum_rss_mb=([0-9]+).*/\1/p' "$CI_LOG" | tail -1 | grep . || echo -; })" >> "$CI_LOG"
    budget_helper="$(_rein_helper shared/ci-record.mjs || true)"
    local _bout _brc=0
    if [[ "$_fast_rc" -ne 0 ]]; then
      status="FAIL"; _ci_step budget FAIL "the fast tier failed on its own (rc=${_fast_rc}) — see the fast tier section of the log"
    elif [[ -z "$budget_helper" || ! -d "${CI_ROOT}/.ai" ]]; then
      _ci_step budget skip "ci-record.mjs or .ai/ unavailable — measured, not compared"
    else
      _bout="$(node "${_CI_NODE_FLAGS[@]}" "$budget_helper" budget-check --ai-dir "${CI_ROOT}/.ai" --log "$CI_LOG" 2>&1)" || _brc=$?
      [[ -n "$_bout" ]] && printf '%s\n' "$_bout" | tee -a "$CI_LOG"
      if [[ "$_brc" -eq 0 ]]; then
        _ci_step budget PASS "$(sed -nE 's/^\[ci\] budget //p' "$CI_LOG" | tail -1)"
      else
        status="FAIL"; _ci_step budget FAIL "over budget — see [BUDGET_REGRESSION] above"
      fi
    fi
  fi

  # ── secrets ── the workflow's .gitignore check, unchanged.
  local secrets_status="PASS"
  # E-343: a Rein project's .ai/ci.local.json may carry literal values (ports, tokens) — never
  # committed. A repository without .ai/ has no such file to cover.
  local _sec=".env and node_modules" _ci_local_ok=0
  if [[ -d "${CI_WT}/.ai" ]]; then
    _sec=".env, node_modules and .ai/ci.local.json"
    git -C "$CI_WT" check-ignore -q .ai/ci.local.json && _ci_local_ok=1
  else
    _ci_local_ok=1
  fi
  if git -C "$CI_WT" check-ignore -q .env && git -C "$CI_WT" check-ignore -q node_modules && [[ "$_ci_local_ok" -eq 1 ]]; then
    _ci_step secrets PASS "${_sec} are ignored"
  else
    secrets_status="FAIL"; status="FAIL"
    _ci_step secrets FAIL ".gitignore must cover ${_sec}"
  fi

  # ── baseline ── E-386 (D-135 r2): a full, unsharded, committed PASS refreshes the census
  # baseline in the project tree when the committed one is missing or stale, so a fresh hosted
  # runner packs its lanes by measured time. Never from a shard, a dirty run or a FAIL; a
  # project without tests/tools/census.mjs gets no baseline and no line.
  if [[ "$status" == "PASS" && -z "$shard" && "$dirty" -eq 0 && "$do_suite" -eq 1 && -f "${CI_WT}/tests/tools/census.mjs" ]]; then
    _ci_baseline "$sha"
  fi

  _ci_step load info "end: $(_ci_load)"
  printf '[ci] result status=%s suite=%s pass=%s fail=%s skip=%s leaked=%s unit=%s secrets=%s\n' \
    "$status" "$suite_status" "$s_pass" "$s_fail" "$s_skip" "$leaked" "$unit_status" "$secrets_status" >> "$CI_LOG"
  _ci_finish "$status" "$sha" "$t0"
  [[ "$status" == "PASS" ]] && return 0 || return 1
}

# _ci_finish <status> <sha> <t0> — duration + the one summary line.
_ci_finish() {
  local st="$1" sha="$2" t0="$3" dur
  dur=$(( $(date +%s) - t0 ))
  printf '[ci] finished status=%s duration_ms=%s finished_at=%s\n' \
    "$st" "$(( dur * 1000 ))" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$CI_LOG"
  echo "ai ci: ${st} ${sha:0:7} in ${dur}s — log: ${CI_LOG}"
  _ci_record
}

# _ci_record — write the ci_runs row (E-266) into the project's state store and prune old
# logs. Best-effort for the EXIT CODE (the run's verdict stands either way), but never
# silent: a run that could not be recorded cannot satisfy a gate, so the operator is told.
_ci_record() {
  local helper
  if [[ ! -d "${CI_ROOT}/.ai" ]]; then
    echo "ai ci: not recorded — ${CI_ROOT} has no .ai/ (run: ai init)" >&2
    return 0
  fi
  helper="$(_rein_helper shared/ci-record.mjs || true)"
  if [[ -z "$helper" ]] || ! command -v node >/dev/null 2>&1; then
    echo "ai ci: not recorded — ci-record.mjs or node unavailable (run: ai install)" >&2
    return 0
  fi
  node "${_CI_NODE_FLAGS[@]}" "$helper" record --ai-dir "${CI_ROOT}/.ai" --log "$CI_LOG" --prune-dir "$CI_LOGDIR" \
    --rein-version "$VERSION" >/dev/null \
    || echo "ai ci: WARNING — the run was not recorded in ${CI_ROOT}/.ai/state.sqlite" >&2
}

# _ci_read <status|list|log> [args] — the E-266 readers; all go through ci-record.mjs.
_ci_read() {
  local sub="$1"; shift
  local ref="HEAD" short=0 failed=0 n=10 root sha helper
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ref) [[ $# -ge 2 && -n "$2" ]] || { echo "ai ci ${sub}: --ref needs a value" >&2; return 2; }
             ref="$2"; shift 2 ;;
      --ref=*) ref="${1#--ref=}"; shift ;;
      --short) short=1; shift ;;
      --failed) failed=1; shift ;;
      -n) [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "ai ci list: -n needs a number" >&2; return 2; }
          n="$2"; shift 2 ;;
      -h|--help) _ci_usage; return 0 ;;
      -*) echo "ai ci ${sub}: unknown option '$1'" >&2; return 2 ;;
      *) if [[ "$sub" == "log" || "$sub" == "status" ]]; then ref="$1"; shift
         else echo "ai ci ${sub}: unexpected argument '$1'" >&2; return 2; fi ;;
    esac
  done
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "ai ci ${sub}: not inside a git repository" >&2; return 2; }
  helper="$(_rein_helper shared/ci-record.mjs || true)"
  [[ -n "$helper" ]] || { echo "ai ci: ci-record.mjs not found (run: ai install)" >&2; return 2; }
  if [[ "$sub" == "list" ]]; then
    node "${_CI_NODE_FLAGS[@]}" "$helper" list --ai-dir "${root}/.ai" -n "$n"; return
  fi
  sha="$(git -C "$root" rev-parse --verify --quiet "${ref}^{commit}")" || {
    echo "ai ci ${sub}: '${ref}' is not a commit in ${root}" >&2; return 2; }
  local extra=()
  [[ "$short" -eq 1 ]] && extra+=(--short)
  [[ "$failed" -eq 1 ]] && extra+=(--failed)
  [[ "$sub" == "log" ]] && extra+=(--evals-dir "${REIN}/ci/evals")
  node "${_CI_NODE_FLAGS[@]}" "$helper" "$sub" --ai-dir "${root}/.ai" --sha "$sha" ${extra[@]+"${extra[@]}"}
}

# ── E-272 (D-074, version-lifecycle.md §Component 4): `ai clean` ──────────────
# The shell owns the TERMINAL and nothing else: the scan and every removal live in
# shared/ai-clean.mjs, and this wrapper's whole job is flag translation plus the
# confirmation `ai start --kill` established — refuse on a non-interactive stdin rather
# than assume yes. A housekeeping command that guesses consent is one nobody can trust.
_clean_usage() {
  cat <<'CLEANUSAGE'
Usage: ai clean [--apply] [--all] [--yes] [--project-only|--home-only] [--json]
       ai clean --restore <YYYY-MM-DD> [--yes]
       ai clean --purge [--older-than 30d]

Lists what earlier Rein versions left behind (src/config/legacy-artefacts.json),
grouped by class, with the reason and the action it would take:

  safe      provably ours — reproducible from src/, or unmodified since we wrote it
  prompt    may hold your content — removed only with --all, after confirmation
  not ours  printed so you can decide; never touched by any flag

  --apply           remove the safe class
  --all             also the prompt class (confirmed per group; --yes answers)
  --project-only    this project only     --home-only  ~/ and the mirror only
  --json            machine-readable findings (the full list, uncollapsed)

Nothing is deleted: removals MOVE to ~/.rein/trash/<date>/ with a manifest, and
'ai clean --restore <date>' puts them back. 'ai clean --purge' empties old trash.
Exit: 0 nothing (more) to do, 1 findings remain, 2 refused or a trash failure.
Rollback: REIN_CLEAN_DISABLE=1 makes every form a report.
CLEANUSAGE
}

# _clean_confirm <prompt> <assume_yes> — 0 confirmed, 1 declined, 2 no terminal to ask.
_clean_confirm() {
  local msg="$1" assume_yes="$2" reply=""
  [[ "$assume_yes" -eq 1 ]] && return 0
  if [[ ! -t 0 ]]; then
    echo "ai clean: refusing to ${msg} without --yes." >&2
    echo "  stdin is not a terminal, so there is no prompt to answer; pass --yes to confirm." >&2
    return 2
  fi
  printf '%s? [y/N] ' "$msg"
  read -r reply || true
  case "$reply" in y|Y|yes|YES) return 0 ;; *) echo "ai clean: aborted."; return 1 ;; esac
}

do_clean() {
  local apply=0 all=0 assume_yes=0 json=0 scope="all" restore="" purge=0 older=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=1; shift ;;
      --all) all=1; shift ;;
      --yes|-y) assume_yes=1; shift ;;
      --json) json=1; shift ;;
      --project-only) scope="project"; shift ;;
      --home-only) scope="home"; shift ;;
      --restore) [[ $# -ge 2 && -n "$2" ]] || { echo "ai clean: --restore needs a date (YYYY-MM-DD)" >&2; return 2; }
                 restore="$2"; shift 2 ;;
      --restore=*) restore="${1#--restore=}"; shift ;;
      --purge) purge=1; shift ;;
      --older-than) [[ $# -ge 2 && -n "$2" ]] || { echo "ai clean: --older-than needs a number of days" >&2; return 2; }
                    older="$2"; shift 2 ;;
      --older-than=*) older="${1#--older-than=}"; shift ;;
      -h|--help) _clean_usage; return 0 ;;
      *) echo "ai clean: unknown option '$1'" >&2; _clean_usage >&2; return 2 ;;
    esac
  done
  if [[ -n "$restore" && "$purge" -eq 1 ]]; then
    echo "ai clean: --restore and --purge are separate operations — run one at a time" >&2; return 2
  fi
  if [[ ( -n "$restore" || "$purge" -eq 1 ) && ( "$apply" -eq 1 || "$all" -eq 1 ) ]]; then
    echo "ai clean: --restore/--purge do not take --apply or --all" >&2; return 2
  fi

  local helper
  helper="$(_rein_helper shared/ai-clean.mjs || true)"
  if [[ -z "$helper" ]] || ! command -v node >/dev/null 2>&1; then
    echo "ai clean: ai-clean.mjs or node unavailable — run: ai install" >&2; return 2
  fi
  # The project is OPTIONAL: `ai clean` outside a repo still cleans the mirror and HOME.
  local root=""
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -z "$root" && -d ".ai" ]] && root="$PWD"
  local proj_args=()
  [[ -n "$root" ]] && proj_args=(--project "$root")
  local json_args=(); [[ "$json" -eq 1 ]] && json_args=(--json)

  if [[ -n "$restore" ]]; then
    _clean_confirm "restore everything trashed on ${restore}" "$assume_yes"; local rc=$?
    [[ "$rc" -eq 0 ]] || return "$rc"
    node "${_CI_NODE_FLAGS[@]}" "$helper" restore --date "$restore" ${proj_args[@]+"${proj_args[@]}"}
    return $?
  fi
  if [[ "$purge" -eq 1 ]]; then
    local older_args=(); [[ -n "$older" ]] && older_args=(--older-than "$older")
    node "${_CI_NODE_FLAGS[@]}" "$helper" purge ${older_args[@]+"${older_args[@]}"}
    return $?
  fi
  if [[ "$apply" -eq 0 ]]; then
    [[ "$all" -eq 1 ]] && echo "ai clean: --all only has meaning with --apply; showing the dry run." >&2
    node "${_CI_NODE_FLAGS[@]}" "$helper" plan --scope "$scope" ${proj_args[@]+"${proj_args[@]}"} ${json_args[@]+"${json_args[@]}"}
    return $?
  fi

  # --apply --all: confirm the `prompt` group, and only when it has members. Asking about
  # an empty group trains the operator to answer without reading.
  #
  # An UNKNOWN count asks anyway. The first cut of this read the count through a pipeline
  # and fell back to `|| echo 0`; `plan` exits 1 when findings remain, pipefail made the
  # whole pipeline non-zero, and the fallback appended a second line — so `n_prompt` was
  # "1\n0", the `-gt` test errored out, and `ai clean --apply --all` moved the prompt class
  # WITH NO CONSENT AT ALL. Consent is the one thing here that must fail closed, so the
  # count is captured first (never piped through the exit code) and an unreadable count
  # prompts rather than proceeds. Caught by ai_clean_test's "the refused run changed
  # nothing" assertion, which is why that assertion exists beside the exit-code one.
  if [[ "$all" -eq 1 && "${REIN_CLEAN_DISABLE:-0}" != "1" ]]; then
    local plan_json="" n_prompt=""
    plan_json="$(node "${_CI_NODE_FLAGS[@]}" "$helper" plan --scope "$scope" --json ${proj_args[@]+"${proj_args[@]}"} 2>/dev/null || true)"
    if [[ -n "$plan_json" ]] && command -v python3 >/dev/null 2>&1; then
      n_prompt="$(printf '%s' "$plan_json" \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["counts"].get("prompt",0))' 2>/dev/null || true)"
    fi
    [[ "$n_prompt" =~ ^[0-9]+$ ]] || n_prompt=""
    if [[ -z "$n_prompt" || "$n_prompt" -gt 0 ]]; then
      _clean_confirm "move ${n_prompt:-an unknown number of} item(s) that may hold your content to the trash" "$assume_yes"
      local rc=$?
      [[ "$rc" -eq 0 ]] || return "$rc"
    fi
  fi
  local all_args=(); [[ "$all" -eq 1 ]] && all_args=(--all)
  node "${_CI_NODE_FLAGS[@]}" "$helper" apply --scope "$scope" \
    ${all_args[@]+"${all_args[@]}"} ${proj_args[@]+"${proj_args[@]}"} ${json_args[@]+"${json_args[@]}"}
}

_ci_cleanup() {
  trap - EXIT INT TERM
  if [[ "${_CI_CLEAN_KEEP:-0}" == "1" ]]; then
    echo "ai ci: kept ${_CI_CLEAN_WORK} (--keep); remove with: git -C '${_CI_CLEAN_ROOT}' worktree remove --force '${_CI_CLEAN_WORK}/wt' && rm -rf '${_CI_CLEAN_WORK}'"
  else
    git -C "$_CI_CLEAN_ROOT" worktree remove --force "${_CI_CLEAN_WORK}/wt" >/dev/null 2>&1 || true
    rm -rf "$_CI_CLEAN_WORK" 2>/dev/null || true
    git -C "$_CI_CLEAN_ROOT" worktree prune >/dev/null 2>&1 || true
  fi
  rm -rf "$_CI_CLEAN_LOCK" 2>/dev/null || true
}

cmd="${1:-}"
case "$cmd" in
  # Bootloader / installer surface (the only working commands)
  install)       install_global "${@:2}" ;;
  init)          do_init "${@:2}" ;;
  sync)          do_sync "${@:2}" ;;
  doctor)        doctor "${@:2}" ;;
  uninstall)     do_uninstall ;;
  # E-198 (Ruling A): shell-native task creation — persists to state.sqlite via the
  # shared addTask (no MCP needed), so a session can register tasks that survive
  # verify_markdown_sync. Usage: ai add-task [flags] <description>.
  add-task)      do_add_task "${@:2}" ;;
  # E-325 (D-102, team-collaboration.md §Component 1): `ai state migrate --team|--legacy` and
  # `ai task done <id>` — one node helper, writing through the same library as the MCP server.
  # E-333: `ai log path|recent` — the LOG file (shared per developer when team.json says so).
  # E-341 (D-105 r2): `ai trunk` — the project's trunk (team.json → origin/HEAD → main|master).
  state|task|team|log|trunk)
    _st="$(_rein_helper shared/cli-state.mjs || true)"
    [[ -n "$_st" ]] || { echo "ai ${cmd}: cli-state.mjs not found (run: bash install-rein.sh)" >&2; exit 1; }
    command -v node >/dev/null 2>&1 || { echo "ai ${cmd}: node not found" >&2; exit 1; }
    node --no-warnings "$_st" "$cmd" "${@:2}" ;;
  # E-208 (role-abstraction.md §Same-Provider Triad): bind THIS tmux pane to a role
  # and launch that role's provider CLI. Usage: ai pane <architect|engineer>.
  pane)          do_pane "${@:2}" ;;
  start)         do_start "${@:2}" ;;
  # E-314 (D-095, accounts.md): Claude accounts — one config directory per claude.ai login.
  account)
    declare -F do_account >/dev/null || { echo "ai account: ai-account.sh is missing beside ai — run: bash install-rein.sh" >&2; exit 2; }
    do_account "${@:2}" ;;
  # E-265 (D-072, local-ci.md): local CI — tests a committed sha in an isolated worktree.
  ci)            do_ci "${@:2}" ;;
  # E-272 (D-074, version-lifecycle.md §Component 4): remove what earlier versions left
  # behind. Dry run by default; every removal is reversible via the trash.
  clean)         do_clean "${@:2}" ;;
  # E-291 (D-081 r2, D-083): the operator's time-boxed safe-exec override (replaces the
  # removed env opt-outs). Operator-only — the analyzer blocks it for every agent role.
  gate)          do_gate "${@:2}" ;;
  # E-254 (D-069): `ai provider` is removed. v4 ships ONE provider, and a subcommand whose
  # whole purpose was registering a second one is dead surface — the registry file remains
  # the place to edit, so the exit says where rather than only that the command is gone.
  provider)
    echo "ai provider: removed in v4 — providers are configured in .ai/providers.json." >&2
    echo "  Rein is Claude-native (D-069): one provider, three Claude roles." >&2
    exit 2
    ;;
  version|-v|--version) echo "rein ${VERSION}" ;;
  ""|help|-h|--help) usage ;;

  # Deprecated user surface — removed, see .ai/blueprints/cli-collapse.md
  update|onboard) _show_deprecated "$cmd" "Run 'ai start' and type the planning request in the Architect pane." ;;
  preflight)     _show_deprecated "preflight" "skill: ai-preflight  (auto-runs at every session start)" ;;
  digest)        _show_deprecated "digest" "skill: ai-digest" ;;
  archive)       _show_deprecated "archive" "skill: ai-archive" ;;
  review)        _show_deprecated "review" "skill: arch-review  (Architect codebase audit; ai-review was renamed in E-147)" ;;
  test)          _show_deprecated "test" "skill: ai-test  (use --vibe arg inside the skill for chaos audit)" ;;
  where)         _show_deprecated "where" "echo \"\$HOME/.rein\"  (install root is fixed)" ;;

  # Recovery helpers — documented under "Recovery" in usage(); also called by the
  # init/install paths directly and exercised by the test suites.
  migrate-state) do_migrate_state "${@:2}" ;;
  mcp-setup)     do_mcp_setup ;;

  *) echo "Unknown command: $cmd"; usage; exit 1 ;;
esac
